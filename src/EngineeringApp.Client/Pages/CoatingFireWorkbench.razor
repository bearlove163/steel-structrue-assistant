    private string GetFormattedSectionDesignation()
    {
        if (SectionInputMode == "plate" || CurrentParams.Type == SectionType.Plate)
        {
            return $"PL {PlateThickness:0.##}×{PlateWidth:0.##}";
        }

        if (SectionInputMode == "standard" && !string.IsNullOrWhiteSpace(CurrentParams.StandardProfileName))
        {
            return CurrentParams.StandardProfileName;
        }

        return CurrentParams.Type switch
        {
            SectionType.Plate =>
                $"PL {PlateThickness:0.##}×{PlateWidth:0.##}",
            SectionType.HBeam =>
                $"H {CurrentParams.Height:F0}×{CurrentParams.Width:F0}×{CurrentParams.WebThickness:F0}×{CurrentParams.FlangeThickness:F0}",
            SectionType.RHS =>
                $"BOX {CurrentParams.Height:F0}×{CurrentParams.Width:F0}×{CurrentParams.WallThickness:F0}",
            SectionType.CHS =>
                $"CHS {CurrentParams.OuterDiameter:F0}×{CurrentParams.WallThickness:F0}",
            SectionType.Channel =>
                $"[ {CurrentParams.Height:F0}×{CurrentParams.Width:F0}×{CurrentParams.WebThickness:F0}×{CurrentParams.FlangeThickness:F0}",
            SectionType.Angle =>
                Math.Abs(CurrentParams.LegWidth1 - CurrentParams.LegWidth2) < 0.1
                    ? $"L {CurrentParams.LegWidth1:F0}×{CurrentParams.LegThickness:F0}"
                    : $"L {CurrentParams.LegWidth1:F0}×{CurrentParams.LegWidth2:F0}×{CurrentParams.LegThickness:F0}",
            SectionType.Cruciform =>
                $"+ {CurrentParams.Height:F0}×{CurrentParams.Width:F0}×{CurrentParams.WebThickness:F0}×{CurrentParams.FlangeThickness:F0}",
            SectionType.Rectangle =>
                $"REC {CurrentParams.Height:F0}×{CurrentParams.Width:F0}",
            SectionType.Circle =>
                $"Φ {CurrentParams.OuterDiameter:F0}",
            _ => $"{CurrentParams.Type} 自定义"
        };
    }

    private void ChangeApplicationMethod(CoatingApplicationMethod method)
    {
        CurrentMethod = method;
        RecalculateAll();
    }

    private void ApplyPreset(string preset)
    {
        CurrentPresetName = preset;
        CurrentLayers = PaintCoatingCalculator.CreatePreset(preset);
        RecalculateAll();
    }

    private void OnSelectProductItem(CoatingLayerConfig layer, ChangeEventArgs e)
    {
        string? name = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(name)) return;

        var product = PaintProductDatabase.AllProducts.FirstOrDefault(p => p.Name == name);
        if (product != null)
        {
            layer.BrandId = product.BrandId;
            layer.ModelCode = product.ModelCode;
            layer.ProductName = product.Name;
            layer.Dft = product.DefaultDft;
            layer.VolumeSolids = product.VolumeSolidsPercent;
            layer.Density = product.DensityKgL;
            layer.LossRate = product.LossRatePercent;
            layer.MaterialPrice = product.MaterialUnitPricePerKg;
            layer.LaborPrice = product.LaborUnitPricePerM2;
            RecalculateAll();
        }
    }

    private void ApplyProductToCalculation(PaintProductItem prod)
    {
        var targetLayer = CurrentLayers.FirstOrDefault(l => l.LayerType == prod.LayerType);
        if (targetLayer != null)
        {
            targetLayer.IsEnabled = true;
            targetLayer.BrandId = prod.BrandId;
            targetLayer.ModelCode = prod.ModelCode;
            targetLayer.ProductName = prod.Name;
            targetLayer.Dft = prod.DefaultDft;
            targetLayer.VolumeSolids = prod.VolumeSolidsPercent;
            targetLayer.Density = prod.DensityKgL;
            targetLayer.LossRate = prod.LossRatePercent;
            targetLayer.MaterialPrice = prod.MaterialUnitPricePerKg;
            targetLayer.LaborPrice = prod.LaborUnitPricePerM2;
        }
        ActiveTab = 1; // 切换回算量选项卡
        RecalculateAll();
    }

    private void RecalculateAll()
    {
        // 1. 计算截面几何特性
        CurrentResult = Calculator.Calculate(CurrentParams);

        // 2. 算量涂装与防火
        CurrentPaintResult = PaintCoatingCalculator.Calculate(
            CurrentResult,
            CurrentLayers,
            excludeTopSurface: ExcludeTopSurface,
            projectLengthM: ProjectTotalLengthM,
            method: CurrentMethod,
            sectionType: CurrentParams.Type);

        // 3. 热浸镀锌同步算量
        RecalculateHdg();
    }

    private void RecalculateHdg()
    {
        HdgOptions.ProjectLengthM = ProjectTotalLengthM;
        CurrentHdgResult = PaintCoatingCalculator.CalculateHotDipGalvanizing(CurrentResult, HdgOptions);
    }

