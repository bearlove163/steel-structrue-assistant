@page "/coating-fire-calculation"
@page "/painting-calculation"
@using EngineeringApp.Shared.Models
@using EngineeringApp.Shared.Algorithms
@using EngineeringApp.Shared.Data
@using EngineeringApp.Shared.Pricing.Coating
@using EngineeringApp.Client.Services
@using EngineeringApp.Client.Shared.Components
@inject NavigationManager Nav
@inject ThemeState Theme
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>防腐涂装、防火算量与热浸镀锌工程工作台</PageTitle>

<div class="container-fluid py-2 px-3 workstation-root d-flex flex-column min-vh-100 @(Theme.IsDarkMode ? "bg-dark text-white" : "bg-light text-dark")"
     data-theme="@(Theme.IsDarkMode ? "dark" : "light")">

    <!-- ======================= 顶部导航与控制器 ======================= -->
    <header class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white rounded p-2 shadow-sm")">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo("/portal")' title="返回统一门户">
                <span>←</span>
                <span>门户中心</span>
            </button>
            <div class="p-2 bg-warning rounded-3 text-dark fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; font-size: 20px;">
                🎨
            </div>
            <div>
                <h5 class="mb-0 fw-bold tracking-tight d-flex align-items-center gap-2 @(Theme.IsDarkMode ? "text-white" : "text-dark")">
                    <span>模块 3：防腐涂装、防火算量与热浸镀锌工程工作台</span>
                    <span class="badge bg-warning text-dark text-xs">COATING & FIRE PRO</span>
                </h5>
                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                    截面自重与表面积参照 · 形状系数 F/V · 喷涂/滚涂工艺与断面损耗 · 输变电塔与重构件热浸锌 (HDG) · 全球名牌涂料图鉴
                </div>
            </div>
        </div>

        <!-- 顶部工具栏：暗黑/亮色、多国标准、跨模块快捷跳转 -->
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <!-- 暗黑/亮色主题切换按钮 -->
            <button class="btn btn-sm d-flex align-items-center gap-1 @(Theme.IsDarkMode ? "btn-outline-warning" : "btn-outline-dark")"
                    @onclick="Theme.ToggleTheme" title="切换暗黑/亮色主题">
                <span>@(Theme.IsDarkMode ? "☀️ 亮色" : "🌙 暗黑")</span>
            </button>

            <button class="btn btn-outline-primary btn-sm" @onclick='() => Nav.NavigateTo("/material-pricing")' title="进入材料价格工作台">
                🧱 材料价格
            </button>
            <button class="btn btn-outline-info btn-sm" @onclick='() => Nav.NavigateTo("/sections")' title="进入截面力学视窗">
                📐 截面力学
            </button>
        </div>
    </header>

    <!-- ======================= 历史价格快照与工程调差常驻工具条 ======================= -->
    <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-2 mb-2">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-primary text-white d-flex align-items-center gap-1">
                    <span>⏱️ 当前执行价格快照:</span>
                </span>
                <select class="form-select form-select-sm fw-bold @(Theme.IsDarkMode ? "bg-dark text-warning border-secondary" : "bg-white text-primary")"
                        style="min-width: 290px; width: auto;"
                        value="@ActiveSnapshotId"
                        @onchange="OnSnapshotChanged">
                    @foreach (var snap in SeedPaintPriceSnapshots.AllSnapshots)
                    {
                        <option value="@snap.SnapshotId">
                            @(snap.IsLocked ? "🔒 " : "📊 ") @snap.SnapshotName (@snap.EffectiveDate.ToString("yyyy-MM"))
                        </option>
                    }
                </select>
                
                <span class="badge @(CurrentSnapshot.IsLocked ? "bg-danger" : "bg-success") text-white text-xs">
                    @(CurrentSnapshot.IsLocked ? "基准锁定" : "动态采样")
                </span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs">
                    基准日: @CurrentSnapshot.EffectiveDate.ToString("yyyy-MM-dd")
                </span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs" title="@CurrentSnapshot.SourceSupplier">
                    来源: @GetSourceTypeLabel(CurrentSnapshot.SourceType)
                </span>
                <span class="badge bg-info text-dark text-xs" title="该快照中包含的真实询价实体数量">
                    询价实体: @CurrentSnapshot.BrandQuotations.Count 笔
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-success btn-sm d-flex align-items-center gap-1"
                        @onclick="OpenAddBrandModal" title="向当前快照录入真实询价明细">
                    <span>➕</span>
                    <span>录入新品牌询价</span>
                </button>
                <button class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1"
                        @onclick="SyncSnapshotPricesToCurrentLayers" title="将当前快照的大盘与品牌单价同步应用到算量方案">
                    <span>🔄</span>
                    <span>同步快照价到方案</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ======================= 截面物性全局指标横幅 (统一单行展示) ======================= -->
    <div class="@(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-2 rounded border mb-3 d-flex align-items-center justify-content-between gap-2 flex-nowrap overflow-x-auto text-nowrap">
        <div class="d-flex align-items-center gap-2 flex-nowrap text-nowrap">
            @if (SectionInputMode == "plate" || CurrentParams.Type == SectionType.Plate)
            {
                <span class="badge bg-warning text-dark fs-6 fw-bold">🇨🇳 国标 GB/T</span>
                <span class="badge bg-primary fs-6 fw-bold font-monospace">@GetFormattedSectionDesignation()</span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs">GB/T 709 钢板</span>
            }
            else if (SectionInputMode == "standard")
            {
                <span class="badge @GetStandardBadgeClass() fs-6 fw-bold">@GetStandardSystemDisplay()</span>
                <span class="badge bg-primary fs-6 fw-bold font-monospace">@CurrentParams.StandardProfileName</span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs">@SelectedStandardCategory</span>
            }
            else
            {
                <span class="badge bg-secondary fs-6 fw-bold">✏️ 自定义截面</span>
                <span class="badge bg-primary fs-6 fw-bold font-monospace">@GetFormattedSectionDesignation()</span>
            }
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                理论米重 (自重): <b class="text-warning">@CurrentResult.LinearMass.ToString("F1")</b> kg/m
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                全外表面积: <b class="text-info">@CurrentResult.GrossPaintingAreaPerMeter.ToString("F3")</b> m²/m
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                楼板扣除净面积: <b class="text-success">@CurrentResult.PaintingAreaExcludingTop.ToString("F3")</b> m²/m
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                吨钢比表面积: <b class="text-danger">@CurrentResult.AreaPerTon.ToString("F1")</b> m²/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")" title="截面形状系数 F/V = P/A * 1000，防火涂料升温与厚度设计核心物理量">
                形状系数 F/V: <b class="text-primary">@CurrentPaintResult.SectionFactorFOverV.ToString("F1")</b> m⁻¹
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <span class="badge @(SectionInputMode == "plate" ? "bg-success" : (SectionInputMode == "standard" ? "bg-info text-dark" : "bg-primary")) text-xs">
                @(SectionInputMode == "plate" ? "📄 钢板板材" : (SectionInputMode == "standard" ? "📚 标准库驱动" : "✏️ 自定义参数"))
            </span>
        </div>
    </div>

    <!-- ======================= 五大专属模块选项卡 (单行紧凑优化) ======================= -->
    <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-1 mb-3">
        <div class="d-flex align-items-center gap-1 flex-nowrap overflow-x-auto text-nowrap">
            <button class="btn btn-sm py-2 px-2 fw-bold rounded flex-fill text-center text-nowrap @(ActiveTab == 1 ? "btn-primary shadow-sm" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary text-dark"))"
                    @onclick="() => ActiveTab = 1">
                🎨 1. 涂装与防火算量
            </button>
            <button class="btn btn-sm py-2 px-2 fw-bold rounded flex-fill text-center text-nowrap @(ActiveTab == 2 ? "btn-info text-dark shadow-sm" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary text-dark"))"
                    @onclick="() => ActiveTab = 2">
                ⚡ 2. 热浸镀锌 (HDG)
            </button>
            <button class="btn btn-sm py-2 px-2 fw-bold rounded flex-fill text-center text-nowrap @(ActiveTab == 3 ? "btn-success shadow-sm" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary text-dark"))"
                    @onclick="() => ActiveTab = 3">
                📐 3. 推导与断面损耗
            </button>
            <button class="btn btn-sm py-2 px-2 fw-bold rounded flex-fill text-center text-nowrap @(ActiveTab == 4 ? "btn-danger shadow-sm" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary text-dark"))"
                    @onclick="() => ActiveTab = 4">
                🏛️ 4. 名牌涂料图鉴
            </button>
            <button class="btn btn-sm py-2 px-2 fw-bold rounded flex-fill text-center text-nowrap @(ActiveTab == 5 ? "btn-warning text-dark shadow-sm" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary text-dark"))"
                    @onclick="() => ActiveTab = 5">
                ⏳ 5. 价格回溯与清单调差
            </button>
        </div>
    </div>

    <!-- ======================= TAB 1: 涂装与防火核心算量 ======================= -->
    @if (ActiveTab == 1)
    {
        <div class="row g-3 flex-grow-1">
            <!-- 左侧：截面选型与特性参照视窗 -->
            <div class="col-lg-4">
                <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                        <span class="fw-bold small text-primary">📐 截面选型与特性参照视窗</span>
                        <span class="badge @(Theme.IsDarkMode ? "bg-secondary" : "bg-light text-dark border") text-xs">实时参数化</span>
                    </div>

                    <!-- 截面输入模式切换选项卡：自定义截面 vs 标准库型钢 vs 钢板板材 -->
                    <div class="btn-group btn-group-sm w-100 mb-2">
                        <button class="btn @(SectionInputMode == "custom" ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                                @onclick="SwitchToCustomMode">
                            ✏️ 自定义截面
                        </button>
                        <button class="btn @(SectionInputMode == "standard" ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                                @onclick="SwitchToStandardMode">
                            📚 标准型钢库
                        </button>
                        <button class="btn @(SectionInputMode == "plate" ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                                @onclick="SwitchToPlateMode">
                            📄 钢板板材
                        </button>
                    </div>

                    @if (SectionInputMode == "plate")
                    {
                        <!-- 钢板板材常用厚度与尺寸录入 -->
                        <div class="mb-2">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                                <span>常用国标厚度快捷胶囊 (mm):</span>
                                <span class="text-warning fw-bold">t = @PlateThickness mm</span>
                            </label>
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var t in StandardPlateThicknesses)
                                {
                                    <button class="btn btn-xs @(Math.Abs(PlateThickness - t) < 0.1 ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-75" : "btn-outline-secondary"))"
                                            style="min-width: 36px; padding: 2px 4px; font-size: 11px;"
                                            @onclick="() => SelectPlateThickness(t)">
                                        @t
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- 钢板精确几何参数 -->
                        <div class="p-2 rounded border mb-2 @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle")"
                             style="min-height: 142px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-xs fw-bold text-success">
                                    <span class="badge bg-success py-0 px-1 me-1 text-xs">📄 钢板板材</span> 截面参数
                                </span>
                                <span class="badge bg-primary text-white text-xs font-monospace">
                                    PL @PlateThickness.ToString("0.##")×@PlateWidth.ToString("0.##")
                                </span>
                            </div>
                            <div class="row g-2 text-xs mb-2">
                                <div class="col-6">
                                    <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">板厚 t (mm)</label>
                                    <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                           style="height: 26px;" @bind="PlateThickness" @bind:after="OnPlateParamsChanged" step="1" min="1" max="200" />
                                </div>
                                <div class="col-6">
                                    <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">标称板宽 B (mm)</label>
                                    <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                           style="height: 26px;" @bind="PlateWidth" @bind:after="OnPlateParamsChanged" step="100" min="100" />
                                </div>
                            </div>
                            <div class="p-1 rounded bg-info bg-opacity-10 border border-info border-opacity-25 text-xs">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-info fw-bold">展开比表面积推导:</span>
                                    <span class="text-warning fw-bold">@((254.777 / PlateThickness).ToString("F2")) m²/t</span>
                                </div>
                                <div class="text-muted" style="font-size: 10px;">
                                    公式: S = 2000 / (7.85 × t) = 254.78 / @PlateThickness.ToString("0.##") m²/t
                                </div>
                            </div>
                        </div>
                    }
                    else if (SectionInputMode == "custom")
                    {
                        <!-- 第一块：自定义截面类型选择按钮组 -->
                        <div class="mb-2">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">自定义几何截面分类:</label>
                            <div class="row g-1">
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.HBeam ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.HBeam)">H型钢</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.RHS ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.RHS)">箱型/方管</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.CHS ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.CHS)">圆管 (CHS)</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.Channel ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.Channel)">槽钢</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.Angle ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.Angle)">角钢</button>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-xs w-100 @(CurrentParams.Type == SectionType.Cruciform ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeSectionType(SectionType.Cruciform)">十字形柱</button>
                                </div>
                            </div>
                        </div>

                        <!-- 第二块：自定义尺寸数据 (手动输入，可编辑) -->
                        <div class="p-2 rounded border mb-2 @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle")"
                             style="min-height: 142px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-xs fw-bold text-warning">第二块：自定义截面尺寸 (mm)</span>
                                <span class="badge @(Theme.IsDarkMode ? "bg-primary text-white" : "bg-primary text-white") text-xs font-monospace" style="font-size: 11px;">
                                    @GetFormattedSectionDesignation()
                                </span>
                            </div>
                            @if (CurrentParams.Type == SectionType.HBeam || CurrentParams.Type == SectionType.Channel || CurrentParams.Type == SectionType.Cruciform)
                            {
                                <div class="row g-2 text-xs">
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">截面高度 H</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.Height" @bind:after="RecalculateAll" step="10" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">翼缘宽度 B</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.Width" @bind:after="RecalculateAll" step="10" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">腹板厚 tw</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.WebThickness" @bind:after="RecalculateAll" step="1" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">翼缘厚 tf</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.FlangeThickness" @bind:after="RecalculateAll" step="1" />
                                    </div>
                                </div>
                            }
                            else if (CurrentParams.Type == SectionType.RHS)
                            {
                                <div class="row g-2 text-xs">
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">截面高度 H</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.Height" @bind:after="RecalculateAll" step="10" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">截面宽度 B</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.Width" @bind:after="RecalculateAll" step="10" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">壁厚 t</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.WallThickness" @bind:after="RecalculateAll" step="1" />
                                    </div>
                                    <div class="col-6 d-flex flex-column justify-content-end">
                                        <span class="text-muted" style="font-size: 10px; line-height: 26px;">空心闭口箱型</span>
                                    </div>
                                </div>
                            }
                            else if (CurrentParams.Type == SectionType.CHS || CurrentParams.Type == SectionType.Circle)
                            {
                                <div class="row g-2 text-xs">
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">外径 D</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.OuterDiameter" @bind:after="RecalculateAll" step="10" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">壁厚 t</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.WallThickness" @bind:after="RecalculateAll" step="1" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">内径 d (计算值)</label>
                                        <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted")" style="height: 26px; line-height: 18px;">
                                            @((CurrentParams.OuterDiameter - 2 * CurrentParams.WallThickness).ToString("F0")) mm
                                        </div>
                                    </div>
                                    <div class="col-6 d-flex flex-column justify-content-end">
                                        <span class="text-muted" style="font-size: 10px; line-height: 26px;">圆管空心截面</span>
                                    </div>
                                </div>
                            }
                            else if (CurrentParams.Type == SectionType.Angle)
                            {
                                <div class="row g-2 text-xs">
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">肢宽 b1</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.LegWidth1" @bind:after="RecalculateAll" step="5" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">肢宽 b2</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.LegWidth2" @bind:after="RecalculateAll" step="5" />
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">厚度 t</label>
                                        <input type="number" class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               style="height: 26px;" @bind="CurrentParams.LegThickness" @bind:after="RecalculateAll" step="1" />
                                    </div>
                                    <div class="col-6 d-flex flex-column justify-content-end">
                                        <span class="text-muted" style="font-size: 10px; line-height: 26px;">角钢截面</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- 第一块：全球标准库分类与选型 -->
                        <div class="mb-2">
                            <div class="row g-1 mb-1">
                                <div class="col-6">
                                    <label class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">标准体系:</label>
                                    <select class="form-select form-select-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                            style="height: 26px; font-size: 11px; padding: 2px 6px;"
                                            value="@SelectedStandardSystem"
                                            @onchange="OnStandardSystemChanged">
                                        <option value="GB/T (国标)">🇨🇳 国标 GB/T</option>
                                        <option value="EN (欧标)">🇪🇺 欧标 EN</option>
                                        <option value="AISC (美标)">🇺🇸 美标 AISC</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">型钢系列:</label>
                                    <select class="form-select form-select-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                            style="height: 26px; font-size: 11px; padding: 2px 6px;"
                                            value="@SelectedStandardCategory"
                                            @onchange="OnStandardCategoryChanged">
                                        @foreach (var cat in CurrentSystemCategories)
                                        {
                                            <option value="@cat">@cat.Replace("GB/T 11263 ", "").Replace("GB/T 706 ", "").Replace("GB/T 6728 ", "").Replace("EN 10034 ", "").Replace("AISC ", "")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row g-1 align-items-end">
                                <div class="col-8">
                                    <label class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">标准规格型号:</label>
                                    <select class="form-select form-select-xs fw-bold @(Theme.IsDarkMode ? "bg-dark text-warning border-secondary" : "bg-white text-primary")"
                                            style="height: 26px; font-size: 11px; padding: 2px 6px;"
                                            value="@SelectedStandardDesignation"
                                            @onchange="OnStandardDesignationChanged">
                                        @foreach (var item in CurrentCategoryItems)
                                        {
                                            <option value="@item.Designation">@item.Designation</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <button class="btn btn-outline-info btn-xs w-100 py-1 text-nowrap"
                                            style="height: 26px; font-size: 11px;"
                                            @onclick="() => IsSteelModalOpen = true" title="打开完整规格表检索">
                                        📖 库检索
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 第二块：标准尺寸与出厂物性 (只读锁定，防随意修改) -->
                        <div class="p-2 rounded border mb-2 @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle")"
                             style="min-height: 142px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-xs fw-bold text-success">
                                    <span class="badge bg-success py-0 px-1 me-1 text-xs">🔒 标准锁定</span> 截面参数 (只读)
                                </span>
                                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-warning" : "bg-white border text-primary") text-xs" style="font-size: 10px;">
                                    @(CurrentParams.StandardProfileName ?? "标准截面")
                                </span>
                            </div>
                            <div class="row g-2 text-xs">
                                <div class="col-6">
                                    <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">高度 H (mm)</label>
                                    <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                         style="height: 26px; line-height: 18px; font-weight: 600;">
                                        @CurrentParams.Height.ToString("F1")
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">宽度 B (mm)</label>
                                    <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                         style="height: 26px; line-height: 18px; font-weight: 600;">
                                        @CurrentParams.Width.ToString("F1")
                                    </div>
                                </div>
                                @if (CurrentParams.Type == SectionType.HBeam || CurrentParams.Type == SectionType.Channel || CurrentParams.Type == SectionType.Cruciform)
                                {
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">腹板厚 tw (mm)</label>
                                        <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                             style="height: 26px; line-height: 18px; font-weight: 600;">
                                            @CurrentParams.WebThickness.ToString("F1")
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">翼缘厚 tf (mm)</label>
                                        <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                             style="height: 26px; line-height: 18px; font-weight: 600;">
                                            @CurrentParams.FlangeThickness.ToString("F1")
                                        </div>
                                    </div>
                                }
                                else if (CurrentParams.Type == SectionType.RHS || CurrentParams.Type == SectionType.CHS)
                                {
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">壁厚 t (mm)</label>
                                        <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                             style="height: 26px; line-height: 18px; font-weight: 600;">
                                            @CurrentParams.WallThickness.ToString("F1")
                                        </div>
                                    </div>
                                    <div class="col-6 d-flex flex-column justify-content-end">
                                        <span class="text-success" style="font-size: 10px; line-height: 26px;">标准闭口空心截面</span>
                                    </div>
                                }
                                else if (CurrentParams.Type == SectionType.Angle)
                                {
                                    <div class="col-6">
                                        <label class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">厚度 t (mm)</label>
                                        <div class="form-control form-control-sm text-center p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light text-dark")"
                                             style="height: 26px; line-height: 18px; font-weight: 600;">
                                            @CurrentParams.LegThickness.ToString("F1")
                                        </div>
                                    </div>
                                    <div class="col-6 d-flex flex-column justify-content-end">
                                        <span class="text-success" style="font-size: 10px; line-height: 26px;">标准角钢截面</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- CAD 2D 矢量截面视口 (固定标准化视口，与截面特性主页风格完全统一) -->
                    <div class="mb-3 rounded border overflow-hidden shadow-sm flex-shrink-0" style="height: 330px;">
                        <SectionSvgCanvas Result="@CurrentResult"
                                          Parameters="@CurrentParams"
                                          IsDarkMode="@Theme.IsDarkMode"
                                          HighlightTopSurface="@ExcludeTopSurface"
                                          MinHeight="250px"
                                          MaxSvgHeight="310px" />
                    </div>

                    <!-- 截面特性参数卡片 -->
                    <div class="table-responsive text-xs">
                        <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-borderless" : "table-light table-borderless") mb-0">
                            <tbody>
                                <tr>
                                    <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">截面面积 A:</td>
                                    <td class="text-end fw-bold">@CurrentResult.AreaCm2.ToString("F1") cm²</td>
                                </tr>
                                <tr>
                                    <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">展开外周长 P:</td>
                                    <td class="text-end fw-bold">@CurrentResult.OuterPerimeter.ToString("F0") mm</td>
                                </tr>
                                <tr>
                                    <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">上表面宽度 b_top:</td>
                                    <td class="text-end text-warning fw-bold">@CurrentResult.TopSurfaceWidth.ToString("F0") mm</td>
                                </tr>
                                <tr>
                                    <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">截面形状系数 F/V:</td>
                                    <td class="text-end text-primary fw-bold">@CurrentPaintResult.SectionFactorFOverV.ToString("F1") m⁻¹</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 右侧：涂层配套方案设计、工艺选择与造价大盘 -->
            <div class="col-lg-8">
                <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 h-100 d-flex flex-column">
                    <!-- 顶部工法选择与预设配套方案按钮组 -->
                    <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <!-- 施工工法单选组 -->
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-xs text-primary">🛠️ 施工工法:</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-xs @(CurrentMethod == CoatingApplicationMethod.AirlessSpraying ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeApplicationMethod(CoatingApplicationMethod.AirlessSpraying)">
                                        高压无气喷涂 (主流高效)
                                    </button>
                                    <button class="btn btn-xs @(CurrentMethod == CoatingApplicationMethod.AirSpraying ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeApplicationMethod(CoatingApplicationMethod.AirSpraying)">
                                        空气喷涂 (细腻飞散大)
                                    </button>
                                    <button class="btn btn-xs @(CurrentMethod == CoatingApplicationMethod.BrushOrRoller ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                            @onclick="() => ChangeApplicationMethod(CoatingApplicationMethod.BrushOrRoller)">
                                        手工刷滚涂 (零飞散工费高)
                                    </button>
                                </div>
                            </div>

                            <!-- 扣除楼板与批量工程量 -->
                            <div class="d-flex align-items-center gap-3 text-xs">
                                <div class="form-check form-switch m-0 d-flex align-items-center gap-1">
                                    <input class="form-check-input" type="checkbox" id="checkExcludeTop"
                                           @bind="ExcludeTopSurface" @bind:after="RecalculateAll" />
                                    <label class="form-check-label @(Theme.IsDarkMode ? "text-white-50" : "text-muted")" for="checkExcludeTop">
                                        扣除楼板贴合面 (@CurrentResult.TopSurfaceWidth.ToString("F0")mm)
                                    </label>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span>工程总长:</span>
                                    <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                           style="width: 75px;" @bind="ProjectTotalLengthM" @bind:after="RecalculateAll" min="0.1" step="1" />
                                    <span>m</span>
                                </div>
                            </div>
                        </div>

                        <!-- 行业推荐施工配套预设方案 -->
                        <div class="d-flex align-items-center gap-2 flex-wrap pt-1 border-top @(Theme.IsDarkMode ? "border-secondary border-opacity-50" : "border-light-subtle")">
                            <span class="text-xs fw-bold text-success">📋 行业预设配套:</span>
                            <button class="btn btn-xs @(CurrentPresetName == "轻钢厂房常温防腐" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => ApplyPreset("轻钢厂房常温防腐")'>轻钢厂房常温 (底+面)</button>
                            <button class="btn btn-xs @(CurrentPresetName == "标准工业厂房重防腐" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => ApplyPreset("标准工业厂房重防腐")'>标准工业重防腐 (底+中+面)</button>
                            <button class="btn btn-xs @(CurrentPresetName == "沿海高腐蚀 C4/C5 氟碳体系" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => ApplyPreset("沿海高腐蚀 C4/C5 氟碳体系")'>C4/C5 氟碳超耐候体系</button>
                            <button class="btn btn-xs @(CurrentPresetName == "商业建筑室内 2.0h 膨胀防火体系" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => ApplyPreset("商业建筑室内 2.0h 膨胀防火体系")'>室内 2.0h 薄型防火体系</button>
                            <button class="btn btn-xs @(CurrentPresetName == "超高层钢柱 3.0h 厚型非膨胀防火体系" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => ApplyPreset("超高层钢柱 3.0h 厚型非膨胀防火体系")'>超高层 3.0h 厚型防火体系</button>
                        </div>
                    </div>

                    <!-- 涂层分层表格 -->
                    <div class="table-responsive rounded border mb-3 flex-grow-1 @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                        <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover" : "table-hover") align-middle mb-0 text-xs">
                            <thead class="@(Theme.IsDarkMode ? "table-secondary table-opacity-25" : "table-light") text-center">
                                <tr>
                                    <th style="width: 45px;">启用</th>
                                    <th style="width: 105px;" class="text-center">涂层类别</th>
                                    <th style="min-width: 220px;">规格型号 / 品牌产品联动</th>
                                    <th style="width: 95px;">膜厚 (DFT)</th>
                                    <th style="width: 75px;">固含%</th>
                                    <th style="width: 75px;">比重</th>
                                    <th style="width: 80px;" title="根据截面形状(圆管>箱型)与工法自动修正">损耗%</th>
                                    <th style="width: 85px;">漆价(元/kg)</th>
                                    <th style="width: 85px;">工费(元/m²)</th>
                                    <th style="width: 95px;">单耗(kg/m²)</th>
                                    <th style="width: 95px;">小计(元/m²)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var layer in CurrentLayers)
                                {
                                    <tr class="@(layer.IsEnabled ? "" : (Theme.IsDarkMode ? "opacity-50" : "text-muted opacity-50"))">
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" @bind="layer.IsEnabled" @bind:after="RecalculateAll" />
                                        </td>
                                        <td class="text-center align-middle">
                                            @{
                                                var (cnName, enName) = GetLayerNames(layer.LayerType);
                                            }
                                            <div class="badge @GetLayerBadgeClass(layer.LayerType) d-inline-flex flex-column align-items-center justify-content-center py-1 px-2 text-center shadow-sm" style="min-width: 92px; border-radius: 6px;">
                                                <span class="fw-bold" style="font-size: 14px; line-height: 1.25; letter-spacing: 0.5px;">@cnName</span>
                                                <span style="font-size: 11px; font-weight: normal; opacity: 0.9; line-height: 1.1; letter-spacing: 0.5px;">(@enName)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm py-0 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark")"
                                                    style="font-size: 11px; height: 28px;"
                                                    @onchange="(e) => OnSelectProductItem(layer, e)">
                                                @if (!string.IsNullOrEmpty(layer.ProductName) && !PaintProductDatabase.GetByType(layer.LayerType).Any(p => p.Name == layer.ProductName))
                                                {
                                                    <option value="@layer.ProductName" selected>@layer.ProductName</option>
                                                }
                                                @foreach (var prod in PaintProductDatabase.GetByType(layer.LayerType))
                                                {
                                                    <option value="@prod.Name" selected="@(prod.Name == layer.ProductName)">
                                                        @prod.Brand: @prod.ModelCode - @prod.Name
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                       @bind="layer.Dft" @bind:after="RecalculateAll" step="@(layer.LayerType == CoatingLayerType.Fireproof ? 0.2 : 5)" />
                                                <span class="input-group-text px-1 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 text-white-50 border-secondary" : "bg-light")">
                                                    @(layer.LayerType == CoatingLayerType.Fireproof ? "mm" : "μm")
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                   @bind="layer.VolumeSolids" @bind:after="RecalculateAll" step="1" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                   @bind="layer.Density" @bind:after="RecalculateAll" step="0.05" />
                                        </td>
                                        <td>
                                            <div class="text-end">
                                                <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                       @bind="layer.LossRate" @bind:after="RecalculateAll" step="5" />
                                                <span class="text-muted" style="font-size: 10px;">
                                                    实际: @(CurrentPaintResult.Layers.FirstOrDefault(x => x.LayerType == layer.LayerType)?.EffectiveLossRatePercent.ToString("F0") ?? "-")%
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                   @bind="layer.MaterialPrice" @bind:after="RecalculateAll" step="1" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-end p-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                                   @bind="layer.LaborPrice" @bind:after="RecalculateAll" step="1" />
                                        </td>
                                        <td class="text-end font-monospace">
                                            @(CurrentPaintResult.Layers.FirstOrDefault(x => x.LayerType == layer.LayerType)?.ActualUsageKgPerM2.ToString("F3") ?? "-")
                                        </td>
                                        <td class="text-end pe-2 fw-bold font-monospace @(layer.IsEnabled ? "text-success" : "")">
                                            @(CurrentPaintResult.Layers.FirstOrDefault(x => x.LayerType == layer.LayerType) != null ? $"¥{CurrentPaintResult.Layers.First(x => x.LayerType == layer.LayerType).TotalCostPerM2:F2}" : "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- 综合造价四大指标横幅 -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <div class="p-2 rounded border text-center @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light border-light-subtle")">
                                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">每平方米综合造价</div>
                                <div class="fs-5 fw-bold text-primary font-monospace">
