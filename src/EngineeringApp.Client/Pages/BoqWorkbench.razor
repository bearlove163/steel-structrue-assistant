@page "/boq-workbench"
@page "/boq"
@using EngineeringApp.Shared.BOQ.Models
@using EngineeringApp.Shared.BOQ.Engine
@using EngineeringApp.Shared.BOQ.Data
@using EngineeringApp.Shared.BOQ.Export
@using EngineeringApp.Client.Services
@inject NavigationManager Nav
@inject ThemeState Theme
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>宁波奥体中心 BOQ 商务大盘与多维报表工作台</PageTitle>

<div class="container-fluid py-2 px-3 workstation-root d-flex flex-column min-vh-100 @(Theme.IsDarkMode ? "bg-dark text-white" : "bg-light text-dark")"
     data-theme="@(Theme.IsDarkMode ? "dark" : "light")">

    <!-- ======================= 顶部导航与大盘控制器 ======================= -->
    <header class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white rounded p-2 shadow-sm")">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo("/portal")' title="返回统一门户">
                <span>←</span>
                <span>门户中心</span>
            </button>
            <div class="p-2 bg-primary rounded-3 text-white fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                📊
            </div>
            <div>
                <h5 class="mb-0 fw-bold tracking-tight d-flex align-items-center gap-2 @(Theme.IsDarkMode ? "text-white" : "text-dark")">
                    <span>宁波奥体中心 BOQ 商务大盘与多维报表工作台</span>
                    <span class="badge bg-primary text-xs">V9 独立费率配置版</span>
                    <span class="badge bg-success text-xs">● 实时核算 ACTIVE</span>
                </h5>
                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                    多受众脱敏矩阵 · 双定额系数联动 · 1.15倍采购损耗 · 采办经营创效(剪刀差) · 纯C#零JS多工作表导出
                </div>
            </div>
        </div>

        <!-- 顶部工具栏：快捷跳转、主题切换与 Excel/CSV 导出 -->
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0 flex-wrap">
            <!-- 模块快捷跳转 -->
            <div class="btn-group btn-group-sm d-none d-lg-flex">
                <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/material-pricing")' title="跳转模块1：材料价格">🧱 材料价格</button>
                <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/sections")' title="跳转模块2：截面力学">📐 截面力学</button>
                <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/coating-fire-calculation")' title="跳转模块3：防腐防火">🎨 防腐防火</button>
                <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/suppliers")' title="跳转模块4：供应商库">🏢 供应商库</button>
            </div>

            <!-- 暗黑/亮色切换 -->
            <button class="btn btn-sm d-flex align-items-center gap-1 @(Theme.IsDarkMode ? "btn-outline-warning" : "btn-outline-dark")"
                    @onclick="Theme.ToggleTheme" title="切换暗黑/亮色主题界面类型">
                <span>@(Theme.IsDarkMode ? "☀️ 亮色" : "🌙 暗黑")</span>
            </button>

            <!-- 导出与重置按钮 -->
            <button class="btn btn-sm btn-outline-success fw-bold d-flex align-items-center gap-1"
                    @onclick="DownloadSpreadsheetXml" title="导出包含全部5大受众独立Tab的SpreadsheetML 2003 XML工作簿">
                <span>📥 导出多工作表 Excel</span>
            </button>
            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1"
                    @onclick="DownloadCurrentPerspectiveCsv" title="导出当前激活视角的 UTF-8 BOM CSV 清单">
                <span>📄 导出当前视角 CSV</span>
            </button>
            <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                    @onclick="ResetToBenchmark" title="重置为宁波奥体中心标准基准工程数据">
                <span>🔄 重置奥体基准</span>
            </button>
        </div>
    </header>

    <!-- 浮动通知提示 -->
    @if (!string.IsNullOrEmpty(_copyAlertMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-2 small shadow-sm" role="alert">
            <span>@_copyAlertMessage</span>
            <button type="button" class="btn-close py-2" @onclick="() => _copyAlertMessage = null"></button>
        </div>
    }

    <!-- ======================= 项目元数据横幅与全局默认费率 ======================= -->
    <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-2 mb-2">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <!-- 项目核心标识 -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-primary text-white">🏛️ 项目编码: NB-ATZX</span>
                <span class="fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">
                    @_project.ProjectName
                </span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs">
                    建设单位: @_project.ClientName
                </span>
                <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border") text-xs">
                    合同快照: 📅 2026-10-08 (秋季最新)
                </span>
                <span class="badge bg-info-subtle text-info text-xs border border-info">
                    规范: GB 50500 / 钢结构设计标准
                </span>
            </div>

            <!-- 全局默认费率配置 -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="text-xs fw-bold @(Theme.IsDarkMode ? "text-warning" : "text-primary")">
                    ⚙️ 项目全局默认费率:
                </span>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">默认管理费:</span>
                    <div class="input-group input-group-sm" style="width: 85px;">
                        <input type="number" step="0.5" min="0" max="100"
                               class="form-control form-control-sm py-0 text-end text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                               value="@(_project.DefaultManagementFeeRate * 100)"
                               @onchange="OnGlobalManagementRateChanged" />
                        <span class="input-group-text py-0 text-xs px-1">%</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">默认利润率:</span>
                    <div class="input-group input-group-sm" style="width: 85px;">
                        <input type="number" step="0.5" min="0" max="100"
                               class="form-control form-control-sm py-0 text-end text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                               value="@(_project.DefaultProfitRate * 100)"
                               @onchange="OnGlobalProfitRateChanged" />
                        <span class="input-group-text py-0 text-xs px-1">%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================= 5 大受众视角切换工具栏 ======================= -->
    <div class="p-2 mb-2 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle shadow-sm")">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold small @(Theme.IsDarkMode ? "text-info" : "text-primary")">
                    👥 受众报表视角切换:
                </span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    <button class="btn @(_currentPerspective == BoqAudiencePerspective.Owner ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                            @onclick="() => SetAudiencePerspective(BoqAudiencePerspective.Owner)">
                        🏛️ 业主 / 审计清单
                    </button>
                    <button class="btn @(_currentPerspective == BoqAudiencePerspective.ChiefEconomist ? "btn-success fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                            @onclick="() => SetAudiencePerspective(BoqAudiencePerspective.ChiefEconomist)">
                        📈 核心成果:总经济师 / 全成本穿透
                    </button>
                    <button class="btn @(_currentPerspective == BoqAudiencePerspective.FabricationShop ? "btn-warning text-dark fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                            @onclick="() => SetAudiencePerspective(BoqAudiencePerspective.FabricationShop)">
                        🏭 构件制造厂 / 车间排产
                    </button>
                    <button class="btn @(_currentPerspective == BoqAudiencePerspective.SiteProjectDept ? "btn-info text-dark fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                            @onclick="() => SetAudiencePerspective(BoqAudiencePerspective.SiteProjectDept)">
                        🏗️ 现场项目部 / 吊装施工
                    </button>
                    <button class="btn @(_currentPerspective == BoqAudiencePerspective.Procurement ? "btn-danger fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                            @onclick="() => SetAudiencePerspective(BoqAudiencePerspective.Procurement)">
                        📦 采办物资部 / 钢厂订货
                    </button>
                </div>
            </div>

            <!-- 当前视角脱敏与投影规则状态提示 -->
            <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                当前视角模式: <b class="@(_currentPerspective == BoqAudiencePerspective.Owner ? "text-warning" : "text-primary")">@GetPerspectiveRuleSummary()</b>
            </div>
        </div>
    </div>

    <!-- ======================= 6 张核心 KPI 商务与成本指标卡片 ======================= -->
    <div class="row g-2 mb-2">
        <!-- Card 1: 最终对外投标总报价 -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle shadow-sm")">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">① 最终投标总造价</span>
                    <span class="badge bg-primary text-xs px-1">最终报价</span>
                </div>
                <div class="fs-5 fw-bold text-primary">¥ @_projectResult.TotalBidPrice.ToString("N0")</div>
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                    均价: ¥@((_projectResult.TotalBidPrice / (_projectResult.TotalNetWeightTon > 0 ? _projectResult.TotalNetWeightTon : 1.0)).ToString("N0"))/t
                </div>
            </div>
        </div>

        <!-- Card 2: 结构理论总净重 -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle shadow-sm")">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">② 结构总理论净重</span>
                    <span class="badge bg-info text-dark text-xs px-1">清单净重</span>
                </div>
                <div class="fs-5 fw-bold text-info">@_projectResult.TotalNetWeightTon.ToString("N2") <span class="text-xs fw-normal">吨 (t)</span></div>
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                    @(string.Join(" | ", _project.TenderItems.Select(t => $"{t.ItemTag}: {t.TenderQuantity:N2}t")))
                </div>
            </div>
        </div>

        <!-- Card 3: 采购总毛重 (1.15倍损耗) -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle shadow-sm")">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">③ 采购总毛重 (1.15倍)</span>
                    <span class="badge bg-warning text-dark text-xs px-1">1.15损耗</span>
                </div>
                <div class="fs-5 fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">@_projectResult.TotalGrossWeightTon.ToString("N2") <span class="text-xs fw-normal">吨 (t)</span></div>
                <div class="text-xs text-secondary">
                    工艺损耗增量: +@((_projectResult.TotalGrossWeightTon - _projectResult.TotalNetWeightTon).ToString("N2"))t
                </div>
            </div>
        </div>

        <!-- Card 4: 涂装耐火总面积 -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle shadow-sm")">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">④ 涂装耐火总面积</span>
                    <span class="badge bg-danger text-xs px-1">表面积</span>
                </div>
                <div class="fs-5 fw-bold text-danger">@_projectResult.TotalSurfaceAreaM2.ToString("N1") <span class="text-xs fw-normal">m²</span></div>
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                    @(string.Join(" | ", GetFireRatingAnalytics().Select(f => $"{f.RatingHours:F1}H: {f.SurfaceAreaM2:N1}m²")))
                </div>
            </div>
        </div>

        <!-- Card 5: 目标毛利与管费 (脱敏逻辑) -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle shadow-sm")">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">⑤ 目标毛利与管费</span>
                    <span class="badge bg-success text-xs px-1">毛利与管费</span>
                </div>
                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                {
                    <div class="fs-6 fw-bold text-muted mt-1">
                        <span class="badge bg-secondary-subtle text-muted border">🔒 商业定额脱敏</span>
                    </div>
                    <div class="text-xs text-muted">
                        规费与利润已计入综合单价 (GB 50500)
                    </div>
                }
                else
                {
                    <div class="fs-5 fw-bold text-success">¥ @((_projectResult.TotalProfit + _projectResult.TotalManagementFee).ToString("N0"))</div>
                    <div class="text-xs text-success">
                        利润: ¥@_projectResult.TotalProfit.ToString("N0") | 管费: ¥@_projectResult.TotalManagementFee.ToString("N0")
                    </div>
                }
            </div>
        </div>

        <!-- Card 6: ★ 采办经营创效 (剪刀差利润看板) -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border h-100 @(_projectResult.TotalProcurementScissorProfit >= 0 ? (Theme.IsDarkMode ? "bg-success bg-opacity-15 border-success" : "bg-success-subtle border-success border-opacity-75 shadow-sm") : (Theme.IsDarkMode ? "bg-danger bg-opacity-10 border-danger" : "bg-danger-subtle border-danger-subtle"))">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-xs fw-bold @(_projectResult.TotalProcurementScissorProfit >= 0 ? "text-success" : "text-danger")">⑥ 采办经营创效</span>
                    <span class="badge @(_projectResult.TotalProcurementScissorProfit >= 0 ? "bg-success" : "bg-danger") text-xs px-1">剪刀差利润</span>
                </div>
                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                {
                    <div class="fs-6 fw-bold text-muted mt-1">
                        <span class="badge bg-secondary-subtle text-muted border">🔒 商业套利脱敏</span>
                    </div>
                    <div class="text-xs text-muted">
                        施工方集采创效不对外公开
                    </div>
                }
                else
                {
                    <div class="fs-5 fw-bold @(_projectResult.TotalProcurementScissorProfit >= 0 ? "text-success" : "text-danger")">
                        @(_projectResult.TotalProcurementScissorProfit >= 0 ? "+" : "")¥ @_projectResult.TotalProcurementScissorProfit.ToString("N0")
                    </div>
                    <div class="text-xs @(_projectResult.TotalProcurementScissorProfit >= 0 ? "text-success" : "text-danger") fw-semibold">
                        吨均创效: @((_projectResult.TotalProcurementScissorProfit / (_projectResult.TotalGrossWeightTon > 0 ? _projectResult.TotalGrossWeightTon : 1.0)).ToString("+0.0;-0.0;0.0")) 元/t
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ======================= 4 大核心交互选项卡容器 ======================= -->
    <ul class="nav nav-tabs @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle") mb-2 flex-nowrap overflow-x-auto">
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(_activeTabIndex == 0 ? "active fw-bold " + (Theme.IsDarkMode ? "bg-dark text-primary border-primary border-bottom-0" : "bg-white text-primary border-primary border-bottom-0 shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => _activeTabIndex = 0">
                📋 选项卡 0：对外投标报价清单 (含独立费率覆盖)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(_activeTabIndex == 1 ? "active fw-bold " + (Theme.IsDarkMode ? "bg-dark text-success border-success border-bottom-0" : "bg-white text-success border-success border-bottom-0 shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => _activeTabIndex = 1">
                📈 选项卡 1：核心成果：终极全成本大盘透视
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(_activeTabIndex == 2 ? "active fw-bold " + (Theme.IsDarkMode ? "bg-dark text-info border-info border-bottom-0" : "bg-white text-info border-info border-bottom-0 shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => _activeTabIndex = 2">
                🌲 选项卡 2：构件双定额与零件材料 Tree-Grid 树表
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(_activeTabIndex == 3 ? "active fw-bold " + (Theme.IsDarkMode ? "bg-dark text-warning border-warning border-bottom-0" : "bg-white text-warning border-warning border-bottom-0 shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => _activeTabIndex = 3">
                📦 选项卡 3：材料采购与订货排程表 (跨构件母材归并)
            </button>
        </li>
    </ul>

    <!-- 选项卡内容区域 -->
    <div class="tab-content flex-grow-1">

        <!-- ========================================================================= -->
        <!-- TAB 0: 对外投标报价清单表 (Tender Items with Inline Rate Override)        -->
        <!-- ========================================================================= -->
        @if (_activeTabIndex == 0)
        {
            <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") mb-3">
                <div class="card-header py-2 d-flex flex-wrap align-items-center justify-content-between @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-primary">📋 分部分项工程量清单计价表</span>
                        <span class="badge bg-secondary-subtle text-secondary text-xs">执行国家标准 GB 50500</span>
                    </div>
                    <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                        提示: 勾选单项覆盖开关可调整单个清单项的管理费率与利润率，系统毫秒级联动重算全盘综合单价与总合价。
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white border-light-subtle") small align-middle mb-0 text-nowrap">
                        <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th style="width: 120px;">清单编码</th>
                                <th style="width: 60px;">代号</th>
                                <th>清单项目名称</th>
                                <th>项目特征及主要工作内容</th>
                                <th style="width: 50px;">单位</th>
                                <th style="width: 90px;">投标工程量</th>
                                <th style="width: 110px;">直接成本底价</th>
                                <th style="width: 110px;">费率状态</th>
                                <th style="width: 90px;">管理费率</th>
                                <th style="width: 90px;">利润率</th>
                                <th style="width: 110px;">综合单价 (元/t)</th>
                                <th style="width: 130px;">投标总合价 (元)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _project.TenderItems.Count; i++)
                            {
                                var item = _project.TenderItems[i];
                                var (effMgmt, effProfit) = item.GetEffectiveRates(_project);
                                <tr>
                                    <td class="text-center text-muted">@(i + 1)</td>
                                    <td class="font-monospace text-center">@item.BillItemCode</td>
                                    <td class="text-center fw-bold text-primary">@item.ItemTag</td>
                                    <td class="fw-semibold">@item.BillItemName</td>
                                    <td class="text-wrap" style="max-width: 320px;">
                                        <small class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">@item.ProjectCharacteristics</small>
                                    </td>
                                    <td class="text-center">@item.Unit</td>
                                    <td class="text-end fw-semibold">@item.TenderQuantity.ToString("N2")</td>

                                    <!-- 直接成本底价 (脱敏控制) -->
                                    <td class="text-end">
                                        @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                        {
                                            <span class="badge bg-secondary-subtle text-muted border">🔒 商业定额脱敏</span>
                                        }
                                        else
                                        {
                                            <span class="font-monospace">¥ @item.DirectCostPerTon.ToString("N2")</span>
                                        }
                                    </td>

                                    <!-- 费率覆盖开关 -->
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block m-0">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@item.IsCustomRateEnabled"
                                                   @onchange="() => OnTenderRateToggle(item)"
                                                   title="切换是否对该清单项启用独立费率覆盖" />
                                        </div>
                                        <span class="badge @(item.IsCustomRateEnabled ? "bg-warning text-dark" : "bg-secondary-subtle text-muted") ms-1 text-xs">
                                            @(item.IsCustomRateEnabled ? "★单项覆盖" : "继承默认")
                                        </span>
                                    </td>

                                    <!-- 独立管理费率输入 -->
                                    <td class="text-end">
                                        @if (item.IsCustomRateEnabled)
                                        {
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="0.5" min="0" max="100"
                                                       class="form-control form-control-sm py-0 text-end text-xs @(Theme.IsDarkMode ? "bg-dark text-warning border-warning" : "border-warning")"
                                                       value="@((item.CustomManagementFeeRate ?? _project.DefaultManagementFeeRate) * 100)"
                                                       @onchange="(e) => OnTenderMgmtRateChanged(item, e)" />
                                                <span class="input-group-text py-0 text-xs px-1">%</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@((effMgmt * 100).ToString("F1"))%</span>
                                        }
                                    </td>

                                    <!-- 独立利润率输入 -->
                                    <td class="text-end">
                                        @if (item.IsCustomRateEnabled)
                                        {
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="0.5" min="0" max="100"
                                                       class="form-control form-control-sm py-0 text-end text-xs @(Theme.IsDarkMode ? "bg-dark text-warning border-warning" : "border-warning")"
                                                       value="@((item.CustomProfitRate ?? _project.DefaultProfitRate) * 100)"
                                                       @onchange="(e) => OnTenderProfitRateChanged(item, e)" />
                                                <span class="input-group-text py-0 text-xs px-1">%</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@((effProfit * 100).ToString("F1"))%</span>
                                        }
                                    </td>

                                    <!-- 对外商务综合单价 -->
                                    <td class="text-end fw-bold text-primary font-monospace">
                                        ¥ @item.ComprehensiveUnitPrice.ToString("N2")
                                    </td>

                                    <!-- 对外投标总合价 -->
                                    <td class="text-end fw-bold text-success font-monospace">
                                        ¥ @item.TotalTenderPrice.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="@(Theme.IsDarkMode ? "table-secondary text-dark fw-bold" : "table-light fw-bold")">
                            <tr>
                                <td colspan="6" class="text-center">合 计 (全工程分部分项清单总计)</td>
                                <td class="text-end">@_project.TenderItems.Sum(t => t.TenderQuantity).ToString("N2")</td>
                                <td class="text-end">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>加权: ¥@((_projectResult.TotalDirectCost / (_projectResult.TotalNetWeightTon > 0 ? _projectResult.TotalNetWeightTon : 1.0)).ToString("N2"))</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td colspan="3" class="text-center text-xs text-muted">包含自定义费率项与项目默认项</td>
                                <td class="text-end text-primary">
                                    ¥ @((_projectResult.TotalBidPrice / (_projectResult.TotalNetWeightTon > 0 ? _projectResult.TotalNetWeightTon : 1.0)).ToString("N2"))
                                </td>
                                <td class="text-end text-success fs-6">
                                    ¥ @_projectResult.TotalBidPrice.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="card-footer py-2 d-flex justify-content-between align-items-center @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light-subtle text-muted") text-xs">
                    <span>* 依据《建设工程工程量清单计价规范》(GB 50500)：综合单价由人工费、材料机具费、施工机具使用费、企业管理费和利润组成，并考虑一定范围内的风险费用。</span>
                    <span class="fw-bold text-success">✓ 投标合价计算公式校验 100% 通过</span>
                </div>
            </div>
        }

        <!-- ========================================================================= -->
        <!-- TAB 1: 终极全成本大盘透视表 (All-Cost Penetration Matrix & Analytics)    -->
        <!-- ========================================================================= -->
        @if (_activeTabIndex == 1)
        {
            <!-- 全要素成本穿透总表 -->
            <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") mb-3">
                <div class="card-header py-2 d-flex flex-wrap align-items-center justify-content-between @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-success">📈 核心成果：终极全成本穿透大盘分析矩阵</span>
                        <span class="badge bg-success text-xs">全要素 100% 穿透</span>
                    </div>
                    <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                        穿透材料费 (含1.15倍损耗)、制作直接工费、现场安装吊装费、防腐防火涂装费、企业管理费、目标利润及采办剪刀差创效。
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white border-light-subtle") small align-middle mb-0 text-nowrap">
                        <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                            <tr>
                                <th>#</th>
                                <th>清单代号</th>
                                <th>工程量 (t)</th>
                                <th>1.15毛重 (t)</th>
                                <th>材料费 (元)</th>
                                <th>制作费 (元)</th>
                                <th>安装费 (元)</th>
                                <th>涂装费 (元)</th>
                                <th>直接成本底价</th>
                                <th>管理费额</th>
                                <th>目标利润</th>
                                <th>综合单价 (元/t)</th>
                                <th>最终投标总合价</th>
                                <th>★采办剪刀差</th>
                                <th>★综合毛利总额</th>
                                <th>综合净利率</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ultimateRows = _projection?.UltimateCostRows 
                                    ?? BoqAggregationEngine.ProjectToUltimateCostAnalysis(_projectResult, _project).UltimateCostRows 
                                    ?? new();
                            }
                            @if (ultimateRows.Count > 0)
                            {
                                @foreach (var r in ultimateRows)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@r.Index</td>
                                        <td class="text-center fw-bold text-primary">@r.ItemTag</td>
                                        <td class="text-end">@r.TenderQuantity.ToString("N2")</td>
                                        <td class="text-end text-muted">@r.GrossWeightTon.ToString("N2")</td>
                                        <td class="text-end">¥ @r.MaterialCostSum.ToString("N0")</td>
                                        <td class="text-end">¥ @r.FabricationCostSum.ToString("N0")</td>
                                        <td class="text-end">¥ @r.InstallationCostSum.ToString("N0")</td>
                                        <td class="text-end">¥ @r.FireCoatingCostSum.ToString("N0")</td>
                                        <td class="text-end font-monospace">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>¥ @r.DirectCostPerTon.ToString("N0")/t</span>
                                            }
                                        </td>
                                        <td class="text-end text-muted">¥ @r.ManagementFeeAmount.ToString("N0")</td>
                                        <td class="text-end text-muted">¥ @r.TargetProfitAmount.ToString("N0")</td>
                                        <td class="text-end fw-semibold text-primary">¥ @r.ComprehensiveUnitPrice.ToString("N0")</td>
                                        <td class="text-end fw-bold text-success">¥ @r.TotalTenderPrice.ToString("N0")</td>
                                        <td class="text-end fw-bold text-success">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>+¥ @r.ScissorDifferenceProfit.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-success font-monospace">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>¥ @r.ComprehensiveNetProfit.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-end text-success fw-bold">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                <span>@r.NetMarginRate.ToString("F1")%</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="@(Theme.IsDarkMode ? "table-secondary text-dark fw-bold" : "table-light fw-bold")">
                            <tr>
                                <td colspan="2" class="text-center">大 盘 汇 总</td>
                                <td class="text-end">@_projectResult.TotalNetWeightTon.ToString("N2")</td>
                                <td class="text-end">@_projectResult.TotalGrossWeightTon.ToString("N2")</td>
                                <td class="text-end">¥ @_projectResult.TotalMaterialCost.ToString("N0")</td>
                                <td class="text-end">¥ @_projectResult.TotalFabricationCost.ToString("N0")</td>
                                <td class="text-end">¥ @_projectResult.TotalInstallationCost.ToString("N0")</td>
                                <td class="text-end">¥ @_projectResult.TotalFireCoatingCost.ToString("N0")</td>
                                <td class="text-end">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>¥ @((_projectResult.TotalDirectCost / (_projectResult.TotalNetWeightTon > 0 ? _projectResult.TotalNetWeightTon : 1.0)).ToString("N0"))/t</span>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td class="text-end">¥ @_projectResult.TotalManagementFee.ToString("N0")</td>
                                <td class="text-end">¥ @_projectResult.TotalProfit.ToString("N0")</td>
                                <td class="text-end text-primary">¥ @((_projectResult.TotalBidPrice / (_projectResult.TotalNetWeightTon > 0 ? _projectResult.TotalNetWeightTon : 1.0)).ToString("N0"))</td>
                                <td class="text-end text-success fs-6">¥ @_projectResult.TotalBidPrice.ToString("N0")</td>
                                <td class="text-end text-success">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>+¥ @_projectResult.TotalProcurementScissorProfit.ToString("N0")</span>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td class="text-end text-success fs-6">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>¥ @((_projectResult.TotalProfit + _projectResult.TotalProcurementScissorProfit).ToString("N0"))</span>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td class="text-end text-success">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>@(((_projectResult.TotalProfit + _projectResult.TotalProcurementScissorProfit) / (_projectResult.TotalBidPrice > 0 ? _projectResult.TotalBidPrice : 1.0) * 100.0).ToString("F1"))%</span>
                                    }
                                    else { <span>-</span> }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- 三维透视子矩阵 (结构体系 / 耐火极限 / 钢材材质牌号) -->
            <div class="row g-2 mb-3">
                <!-- 子矩阵 A: 按工程结构体系交叉透视 -->
                <div class="col-lg-6">
                    <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") h-100">
                        <div class="card-header py-1.5 fw-bold text-primary small d-flex justify-content-between align-items-center @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                            <span>🏗️ 结构体系与受力角色交叉透视</span>
                            <span class="badge bg-primary text-xs">空间管桁架 / 副桁架 / 轻钢</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-bordered border-secondary" : "table-bordered bg-white border-light-subtle") small mb-0 align-middle">
                                <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                                    <tr>
                                        <th>结构体系</th>
                                        <th>构件数</th>
                                        <th>净重 (t)</th>
                                        <th>1.15毛重 (t)</th>
                                        <th>直接费 (元)</th>
                                        <th>采办剪刀差</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sys in GetStructuralSystemAnalytics())
                                    {
                                        <tr>
                                            <td class="fw-semibold">@sys.SystemName</td>
                                            <td class="text-center">@sys.ComponentCount</td>
                                            <td class="text-end">@sys.NetWeightTon.ToString("N2")</td>
                                            <td class="text-end text-muted">@sys.GrossWeightTon.ToString("N2")</td>
                                            <td class="text-end">¥ @sys.DirectCostSum.ToString("N0")</td>
                                            <td class="text-end text-success fw-semibold">
                                                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                                {
                                                    <span class="text-muted">🔒脱敏</span>
                                                }
                                                else
                                                {
                                                    <span>+¥ @sys.ScissorProfitSum.ToString("N0")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 子矩阵 B: 按耐火极限等级分布透视 -->
                <div class="col-lg-6">
                    <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") h-100">
                        <div class="card-header py-1.5 fw-bold text-danger small d-flex justify-content-between align-items-center @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                            <span>🔥 耐火极限等级分布与涂装造价透视</span>
                            <span class="badge bg-danger text-xs">3.0H / 2.0H / 1.5H</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-bordered border-secondary" : "table-bordered bg-white border-light-subtle") small mb-0 align-middle">
                                <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                                    <tr>
                                        <th>耐火等级</th>
                                        <th>涂料标准</th>
                                        <th>表面积 (m²)</th>
                                        <th>定额单价</th>
                                        <th>涂装造价 (元)</th>
                                        <th>占比</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fire in GetFireRatingAnalytics())
                                    {
                                        <tr>
                                            <td class="fw-bold text-danger text-center">@fire.RatingHours.ToString("F1")H</td>
                                            <td><small class="text-muted">@fire.Description</small></td>
                                            <td class="text-end fw-semibold">@fire.SurfaceAreaM2.ToString("N1")</td>
                                            <td class="text-end font-monospace">¥ @fire.UnitPrice.ToString("N0")/m²</td>
                                            <td class="text-end fw-bold text-primary">¥ @fire.TotalCost.ToString("N0")</td>
                                            <td class="text-end text-muted">@fire.Percentage.ToString("F1")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 子矩阵 C: 按钢材材质牌号交叉透视 -->
                <div class="col-12">
                    <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") h-100">
                        <div class="card-header py-1.5 fw-bold text-success small d-flex justify-content-between align-items-center @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                            <span>🔩 钢材材质牌号分布与材料采办交叉透视</span>
                            <span class="badge bg-success text-xs">Q460GJC / Q355B / Q235B</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-bordered border-secondary" : "table-bordered bg-white border-light-subtle") small mb-0 align-middle">
                                <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                                    <tr>
                                        <th>材质牌号</th>
                                        <th>零件项数</th>
                                        <th>理论净重 (t)</th>
                                        <th>采购毛重 (t, 1.15倍)</th>
                                        <th>材料到场综合合价 (元)</th>
                                        <th>采办经营创效</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in GetSteelGradeAnalytics())
                                    {
                                        <tr>
                                            <td class="fw-bold text-success text-center">@grade.GradeName</td>
                                            <td class="text-center">@grade.PartCount</td>
                                            <td class="text-end">@grade.TotalNetWeightTon.ToString("N2")</td>
                                            <td class="text-end text-muted">@grade.TotalGrossWeightTon.ToString("N2")</td>
                                            <td class="text-end fw-semibold">¥ @grade.TotalMaterialCost.ToString("N0")</td>
                                            <td class="text-end text-success fw-semibold">
                                                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                                {
                                                    <span class="text-muted">🔒脱敏</span>
                                                }
                                                else
                                                {
                                                    <span>+¥ @grade.TotalScissorProfit.ToString("N0")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 全要素成本构成瀑布看板 -->
            <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 mb-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small @(Theme.IsDarkMode ? "text-info" : "text-dark")">📊 工程全要素成本构成比例 (Cost Waterfall Breakdown)</span>
                    <span class="badge bg-success-subtle text-success text-xs">★ 采办经营创效增益净利率 +@((_projectResult.TotalProcurementScissorProfit / (_projectResult.TotalBidPrice > 0 ? _projectResult.TotalBidPrice : 1.0) * 100.0).ToString("F2"))%</span>
                </div>
                <div class="progress-stacked" style="height: 24px;">
                    <div class="progress" role="progressbar" style="width: @GetCostRatio(c => c.TotalMaterialCost)%">
                        <div class="progress-bar bg-primary small fw-semibold">材料 @GetCostRatio(c => c.TotalMaterialCost)%</div>
                    </div>
                    <div class="progress" role="progressbar" style="width: @GetCostRatio(c => c.TotalFabricationCost)%">
                        <div class="progress-bar bg-warning text-dark small fw-semibold">制作 @GetCostRatio(c => c.TotalFabricationCost)%</div>
                    </div>
                    <div class="progress" role="progressbar" style="width: @GetCostRatio(c => c.TotalInstallationCost)%">
                        <div class="progress-bar bg-info text-dark small fw-semibold">安装 @GetCostRatio(c => c.TotalInstallationCost)%</div>
                    </div>
                    <div class="progress" role="progressbar" style="width: @GetCostRatio(c => c.TotalFireCoatingCost)%">
                        <div class="progress-bar bg-danger small fw-semibold">涂装 @GetCostRatio(c => c.TotalFireCoatingCost)%</div>
                    </div>
                    <div class="progress" role="progressbar" style="width: @GetCostRatio(c => c.TotalManagementFee + c.TotalProfit)%">
                        <div class="progress-bar bg-success small fw-semibold">管理与利润 @GetCostRatio(c => c.TotalManagementFee + c.TotalProfit)%</div>
                    </div>
                </div>
            </div>
        }

        <!-- ========================================================================= -->
        <!-- TAB 2: 构件双定额与零件材料 Tree-Grid 树表                                  -->
        <!-- ========================================================================= -->
        @if (_activeTabIndex == 2)
        {
            <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") mb-3">
                <div class="card-header py-2 d-flex flex-wrap align-items-center justify-content-between @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-info">🌲 构件双定额与零件材料 Tree-Grid 穿透树表</span>
                        <span class="badge bg-info text-dark text-xs">Level 1 清单项 → Level 2 构件中枢 → Level 3 零件明细</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <button class="btn btn-xs btn-outline-primary" @onclick="ExpandAll">
                            ➕ 全部展开
                        </button>
                        <button class="btn btn-xs btn-outline-secondary" @onclick="CollapseAll">
                            ➖ 全部折叠
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white border-light-subtle") small align-middle mb-0 text-nowrap">
                        <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                            <tr>
                                <th style="width: 320px;" class="text-start ps-3">层级结构 / 编码与名称</th>
                                <th>规格型号 / 材质</th>
                                <th>件数/套数</th>
                                <th>净重 (kg/t)</th>
                                <th>1.15毛重 (kg/t)</th>
                                <th class="@GetFabricationColHeaderClass()">
                                    <span>制作定额因子 (K_Thick)</span>
                                    @if (_currentPerspective == BoqAudiencePerspective.FabricationShop)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">★车间聚焦</span>
                                    }
                                </th>
                                <th class="@GetInstallationColHeaderClass()">
                                    <span>现场安装定额因子 (K_Elev/Weld/Weight)</span>
                                    @if (_currentPerspective == BoqAudiencePerspective.SiteProjectDept)
                                    {
                                        <span class="badge bg-info text-dark ms-1">★安装聚焦</span>
                                    }
                                </th>
                                <th>涂装耐火极限</th>
                                <th>综合单价 / 到场单价</th>
                                <th>小计总合价 (元)</th>
                                <th>★ 采办经营创效</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _project.TenderItems)
                            {
                                bool isItemExpanded = IsTenderExpanded(item.ItemTag);
                                <!-- ================= Level 1: 清单项行 ================= -->
                                <tr class="@(Theme.IsDarkMode ? "table-active text-white border-primary" : "table-light border-primary") fw-bold">
                                    <td class="ps-2">
                                        <button class="btn btn-xs @(isItemExpanded ? "btn-primary" : "btn-outline-primary") me-1 py-0 px-1"
                                                @onclick="() => ToggleTenderExpand(item.ItemTag)">
                                            @(isItemExpanded ? "▼" : "▶")
                                        </button>
                                        <span class="badge bg-primary text-xs me-1">清单项</span>
                                        <span class="font-monospace text-primary me-1">@item.ItemTag</span>
                                        <span>@item.BillItemName</span>
                                    </td>
                                    <td><span class="text-muted small">@item.BillItemCode</span></td>
                                    <td class="text-center">@item.SubProjects.Count 个构件</td>
                                    <td class="text-end text-info font-monospace">@item.TenderQuantity.ToString("N2") t</td>
                                    <td class="text-end text-muted font-monospace">@((item.TenderQuantity * 1.15).ToString("N2")) t</td>
                                    <td class="text-center text-muted @GetFabricationColCellClass()">-</td>
                                    <td class="text-center text-muted @GetInstallationColCellClass()">-</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger border">@item.SubProjects.FirstOrDefault()?.FireRatingHours.ToString("F1")H</span>
                                    </td>
                                    <td class="text-end text-primary font-monospace">¥ @item.ComprehensiveUnitPrice.ToString("N2")/t</td>
                                    <td class="text-end text-success font-monospace">¥ @item.TotalTenderPrice.ToString("N2")</td>
                                    <td class="text-end text-success">
                                        @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                        {
                                            <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                        }
                                        else
                                        {
                                            <span>创效项</span>
                                        }
                                    </td>
                                </tr>

                                @if (isItemExpanded)
                                {
                                    @foreach (var sub in item.SubProjects)
                                    {
                                        bool isSubExpanded = IsSubProjectExpanded(sub.SubProjectCode);
                                        double kThick = BoqAggregationEngine.CalculateThicknessFactor(sub.MaxPlateThickness);
                                        double kElev = BoqAggregationEngine.CalculateElevationFactor(sub.AssemblyElevation);
                                        double kSiteWeld = BoqAggregationEngine.CalculateSiteWeldFactor(sub.HasFieldWelding);
                                        double kWeight = BoqAggregationEngine.CalculateWeightFactorFromTier(sub.CraneTonnageTier, sub.SingleWeight);

                                        <!-- ================= Level 2: 构件成本中枢行 ================= -->
                                        <tr class="@(Theme.IsDarkMode ? "bg-dark bg-opacity-75" : "bg-light-subtle")">
                                            <td style="padding-left: 2rem;">
                                                <button class="btn btn-xs @(isSubExpanded ? "btn-info text-dark" : "btn-outline-secondary") me-1 py-0 px-1"
                                                        @onclick="() => ToggleSubProjectExpand(sub.SubProjectCode)">
                                                    @(isSubExpanded ? "▼" : "▶")
                                                </button>
                                                <span class="badge bg-info text-dark text-xs me-1">构件</span>
                                                <span class="font-monospace fw-semibold">@sub.SubProjectCode</span>
                                                <span class="ms-1">@sub.SubProjectName</span>
                                            </td>
                                            <td><span class="badge @(Theme.IsDarkMode ? "bg-secondary" : "bg-light text-dark border") text-xs">@sub.StructuralRole</span></td>
                                            <td class="text-center">@sub.Quantity 套</td>
                                            <td class="text-end font-monospace">@((sub.SubProjectNetWeightKg / 1000.0).ToString("N2")) t</td>
                                            <td class="text-end text-muted font-monospace">@((sub.SubProjectGrossWeightKg / 1000.0).ToString("N2")) t</td>

                                            <!-- 制作定额因子群 -->
                                            <td class="@GetFabricationColCellClass()">
                                                <span class="badge bg-warning text-dark text-xs" title="板厚难度系数">K_Thick: @kThick.ToString("F2") (@sub.MaxPlateThickness mm)</span>
                                                <span class="badge bg-info text-dark text-xs ms-1" title="数控相贯五轴切割">相贯+280</span>
                                                <span class="badge bg-secondary text-xs ms-1" title="超声波探伤UT">UT+150</span>
                                                <span class="text-muted text-xs ms-1">¥@sub.UnitFabricationCost.ToString("N0")/t</span>
                                            </td>

                                            <!-- 现场安装定额因子群 -->
                                            <td class="@GetInstallationColCellClass()">
                                                <span class="badge bg-info text-dark text-xs" title="标高超高系数">标高@sub.AssemblyElevation m (K_Elev: @kElev.ToString("F2"))</span>
                                                <span class="badge @(sub.HasFieldWelding ? "bg-danger" : "bg-secondary") text-xs ms-1" title="现场全熔透坡口焊">@(sub.HasFieldWelding ? "发现场焊(1.30)" : "厂拼(1.00)")</span>
                                                <span class="badge bg-primary text-xs ms-1" title="起重机吨位分档">@sub.CraneTonnageTier (K_W: @kWeight.ToString("F2"))</span>
                                                <span class="text-muted text-xs ms-1">¥@sub.UnitInstallationCost.ToString("N0")/t</span>
                                            </td>

                                            <!-- 涂装耐火 -->
                                            <td>
                                                <span class="badge bg-danger-subtle text-danger border text-xs">@sub.FireRatingHours.ToString("F1")H (@sub.FireProofType)</span>
                                                <span class="text-muted text-xs ms-1">@sub.SubProjectSurfaceAreaM2.ToString("N1") m²</span>
                                            </td>

                                            <!-- 直接成本底价 -->
                                            <td class="text-end font-monospace">
                                                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                                {
                                                    <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                                }
                                                else
                                                {
                                                    <span>底价: ¥@sub.UnitDirectCost.ToString("N0")/t</span>
                                                }
                                            </td>

                                            <!-- 构件直接成本合价 -->
                                            <td class="text-end font-monospace fw-semibold">
                                                @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                                {
                                                    <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                                }
                                                else
                                                {
                                                    <span>¥ @((sub.UnitDirectCost * (sub.SubProjectNetWeightKg / 1000.0)).ToString("N0"))</span>
                                                }
                                            </td>

                                            <td class="text-end text-muted small">-</td>
                                        </tr>

                                        @if (isSubExpanded)
                                        {
                                            @foreach (var part in sub.Parts)
                                            {
                                                <!-- ================= Level 3: 零件明细行 ================= -->
                                                <tr>
                                                    <td style="padding-left: 3.5rem;">
                                                        <span class="badge bg-secondary text-xs me-1">零件</span>
                                                        <span class="font-monospace fw-bold text-primary">@part.PartMark</span>
                                                    </td>
                                                    <td>
                                                        <span class="font-monospace fw-semibold">@part.SectionSpecification</span>
                                                        <span class="badge bg-primary text-xs ms-1">@part.SteelGrade</span>
                                                        @if (part.ZDirectionGrade != "无" && !string.IsNullOrEmpty(part.ZDirectionGrade))
                                                        {
                                                            <span class="badge bg-success text-xs ms-1">@part.ZDirectionGrade</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">@part.Quantity 件</td>
                                                    <td class="text-end font-monospace">@part.TotalNetWeight.ToString("N1") kg</td>
                                                    <td class="text-end font-monospace">
                                                        <span class="badge bg-warning text-dark text-xs me-1">1.15倍</span>
                                                        <span>@part.TotalGrossWeight.ToString("N1") kg</span>
                                                    </td>
                                                    <td colspan="3" class="text-muted text-xs">
                                                        <span>基价 ¥@part.BaseNetPricePerTon.ToString("N0")</span>
                                                        @if (part.ThicknessSurchargePerTon > 0)
                                                        {
                                                            <span class="text-warning"> +厚度¥@part.ThicknessSurchargePerTon.ToString("N0")</span>
                                                        }
                                                        @if (part.GradeSurchargePerTon > 0)
                                                        {
                                                            <span class="text-info"> +材质¥@part.GradeSurchargePerTon.ToString("N0")</span>
                                                        }
                                                        @if (part.ZPerformanceSurchargePerTon > 0)
                                                        {
                                                            <span class="text-success"> +Z向¥@part.ZPerformanceSurchargePerTon.ToString("N0")</span>
                                                        }
                                                        <span> +运费¥@part.FreightSurchargePerTon.ToString("N0")</span>
                                                    </td>
                                                    <td class="text-end font-monospace text-primary">
                                                        ¥ @part.MaterialUnitPricePerTon.ToString("N0")/t
                                                    </td>
                                                    <td class="text-end font-monospace">
                                                        ¥ @part.TotalPartMaterialCost.ToString("N0")
                                                    </td>
                                                    <td class="text-end">
                                                        @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                                        {
                                                            <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                                        }
                                                        else if (part.ArbitrageProfit > 0)
                                                        {
                                                            <span class="badge bg-success text-white" title="批复¥@part.ApprovedPricePerTon - 采办¥@part.ActualPurchasePricePerTon">
                                                                +¥@part.ArbitrageProfit.ToString("N0") (+@((part.ApprovedPricePerTon - part.ActualPurchasePricePerTon).ToString("N0"))元/t)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">0</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ========================================================================= -->
        <!-- TAB 3: 材料采购与订货排程表 (Cross-Component Material Aggregation)        -->
        <!-- ========================================================================= -->
        @if (_activeTabIndex == 3)
        {
            <div class="card @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-white border-light-subtle shadow-sm") mb-3">
                <div class="card-header py-2 d-flex flex-wrap align-items-center justify-content-between @(Theme.IsDarkMode ? "bg-dark border-secondary" : "bg-light-subtle border-light-subtle")">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-danger">📦 材料采购订货排程总表 (跨构件母材归并)</span>
                        <span class="badge bg-danger text-xs">钢厂直供大单 · 1.15倍采购损耗毛重</span>
                    </div>
                    <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                        按钢材材质、截面形式、厚度与Z向性能跨构件全量归并零件，核算五维加价规则与采办经营创效(剪刀差)。
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white border-light-subtle") small align-middle mb-0 text-nowrap">
                        <thead class="@(Theme.IsDarkMode ? "table-secondary text-dark" : "table-light") text-center">
                            <tr>
                                <th>#</th>
                                <th>钢材材质</th>
                                <th>截面形式</th>
                                <th>规格型号</th>
                                <th>板厚/壁厚</th>
                                <th>Z向性能</th>
                                <th>归并件数</th>
                                <th>理论净重 (t)</th>
                                <th>采购损耗</th>
                                <th>钢厂订货毛重 (t)</th>
                                <th>基准价 (元/t)</th>
                                <th>厚度加价</th>
                                <th>材质加价</th>
                                <th>Z向加价</th>
                                <th>物流运杂</th>
                                <th>到场单价 (元/t)</th>
                                <th>采购预算合价 (元)</th>
                                <th>批复指导价</th>
                                <th>实际采办价</th>
                                <th>★ 剪刀差利润</th>
                                <th>钢厂排产与交货建议</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var procurementRows = _projection?.MaterialProcurementRows 
                                    ?? BoqAggregationEngine.ProjectToMaterialProcurementOrder(_projectResult, _project).MaterialProcurementRows 
                                    ?? new();
                            }
                            @if (procurementRows.Count > 0)
                            {
                                @foreach (var r in procurementRows)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@r.Index</td>
                                        <td class="fw-bold text-primary text-center">@r.MaterialGrade</td>
                                        <td class="text-center font-monospace">@r.SectionType</td>
                                        <td class="fw-semibold">@r.Specification</td>
                                        <td class="text-end">@r.Thickness.ToString("N1") mm</td>
                                        <td class="text-center">
                                            <span class="badge @(r.ZPerformance != "无" ? "bg-success" : "bg-secondary-subtle text-muted") text-xs">@r.ZPerformance</span>
                                        </td>
                                        <td class="text-center">@r.PartCount</td>
                                        <td class="text-end">@r.TotalNetWeightTon.ToString("N2")</td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark text-xs">1.15倍</span>
                                        </td>
                                        <td class="text-end fw-bold">@r.TotalGrossWeightTon.ToString("N2")</td>
                                        <td class="text-end font-monospace">¥ @r.BaseNetPricePerTon.ToString("N0")</td>
                                        <td class="text-end text-muted">@((r.ThicknessSurchargePerTon > 0 ? "+" + r.ThicknessSurchargePerTon.ToString("N0") : "-"))</td>
                                        <td class="text-end text-muted">@((r.GradeSurchargePerTon > 0 ? "+" + r.GradeSurchargePerTon.ToString("N0") : "-"))</td>
                                        <td class="text-end text-muted">@((r.ZPerformanceSurchargePerTon > 0 ? "+" + r.ZPerformanceSurchargePerTon.ToString("N0") : "-"))</td>
                                        <td class="text-end text-muted">+@r.FreightSurchargePerTon.ToString("N0")</td>
                                        <td class="text-end fw-bold text-primary font-monospace">¥ @r.MaterialUnitPricePerTon.ToString("N0")</td>
                                        <td class="text-end fw-bold text-success font-monospace">¥ @r.EstimatedProcurementCost.ToString("N0")</td>
                                        <td class="text-end">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>¥ @r.ApprovedPricePerTon.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>¥ @r.ActualPurchasePricePerTon.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            @if (_currentPerspective == BoqAudiencePerspective.Owner)
                                            {
                                                <span class="badge bg-secondary-subtle text-muted">🔒脱敏</span>
                                            }
                                            else
                                            {
                                                <span>+¥ @r.ScissorDifferenceProfit.ToString("N0")</span>
                                            }
                                        </td>
                                        <td class="small text-wrap" style="max-width: 200px;">
                                            <span class="text-muted">@r.MillOrderingNotes</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="@(Theme.IsDarkMode ? "table-secondary text-dark fw-bold" : "table-light fw-bold")">
                            <tr>
                                <td colspan="7" class="text-center">订 货 汇 总</td>
                                <td class="text-end">@_projectResult.TotalNetWeightTon.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-warning text-dark">1.15倍</span></td>
                                <td class="text-end">@_projectResult.TotalGrossWeightTon.ToString("N2")</td>
                                <td colspan="6" class="text-center text-xs text-muted">加权到场综合价: ¥@((_projectResult.TotalMaterialCost / (_projectResult.TotalGrossWeightTon > 0 ? _projectResult.TotalGrossWeightTon : 1.0)).ToString("N0"))/t</td>
                                <td class="text-end text-success fs-6">¥ @_projectResult.TotalMaterialCost.ToString("N0")</td>
                                <td colspan="2" class="text-center text-muted">采办创效汇总</td>
                                <td class="text-end text-success fs-6">
                                    @if (_currentPerspective != BoqAudiencePerspective.Owner)
                                    {
                                        <span>+¥ @_projectResult.TotalProcurementScissorProfit.ToString("N0")</span>
                                    }
                                    else { <span>-</span> }
                                </td>
                                <td>-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private BoqProject _project = NingboOlympicSeedData.CreateBenchmarkProject();
    private ProjectCostResult _projectResult = default!;
    private AudienceProjectionResult _projection = default!;
    private BoqAudiencePerspective _currentPerspective = BoqAudiencePerspective.ChiefEconomist;
    private int _activeTabIndex = 0;

    private readonly HashSet<string> _expandedTenderItemTags = new();
    private readonly HashSet<string> _expandedSubProjectCodes = new();
    private string? _copyAlertMessage;

    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
        RecalculateAll();
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }

    private void RecalculateAll()
    {
        _projectResult = BoqAggregationEngine.CalculateProject(_project);
        var config = new BoqReportConfig
        {
            AudiencePerspective = _currentPerspective,
            ShowGrossWeight = true,
            MaskInternalDirectCosts = (_currentPerspective == BoqAudiencePerspective.Owner)
        };
        _projection = BoqAggregationEngine.ProjectToAudience(_projectResult, _currentPerspective, _project, config);
        StateHasChanged();
    }

    private void SetAudiencePerspective(BoqAudiencePerspective perspective)
    {
        _currentPerspective = perspective;

        // 受众与选项卡智能联动切换
        _activeTabIndex = perspective switch
        {
            BoqAudiencePerspective.Owner => 0,
            BoqAudiencePerspective.ChiefEconomist => 1,
            BoqAudiencePerspective.FabricationShop => 2,
            BoqAudiencePerspective.SiteProjectDept => 2,
            BoqAudiencePerspective.Procurement => 3,
            _ => 0
        };

        RecalculateAll();
    }

    private string GetPerspectiveRuleSummary() => _currentPerspective switch
    {
        BoqAudiencePerspective.Owner => "严格工程量清单计价，内部直接成本底价与采办剪刀差已物理脱敏 (遵循 GB 50500 公开标准)",
        BoqAudiencePerspective.ChiefEconomist => "核心成果全要素穿透，100% 完整展现工料机成本、管理费、利润与采办经营剪刀差",
        BoqAudiencePerspective.FabricationShop => "聚焦板厚难度系数 K_Thick (特厚板预热消氢)、相贯五轴切割、超声探伤与车间定额工日",
        BoqAudiencePerspective.SiteProjectDept => "聚焦高空标高调节 K_Elev、现场全熔透焊 K_SiteWeld、吊装吨位 K_Weight 与起重机选型配置",
        BoqAudiencePerspective.Procurement => "跨构件归并同材质同规格母材，核算 1.15 采购损耗毛重、五维加价规则与剪刀差创效",
        _ => "标准报表视角"
    };

    private void OnTenderRateToggle(BoqTenderItem item)
    {
        item.IsCustomRateEnabled = !item.IsCustomRateEnabled;
        if (item.IsCustomRateEnabled)
        {
            item.CustomManagementFeeRate ??= _project.DefaultManagementFeeRate;
            item.CustomProfitRate ??= _project.DefaultProfitRate;
        }
        BoqAggregationEngine.RollupCostToTenderItem(item, _project);
        RecalculateAll();
        ShowAlert($"清单项 [{item.ItemTag}] 费率模式已切换为: {(item.IsCustomRateEnabled ? "★ 单项覆盖" : "继承默认")}");
    }

    private void OnTenderMgmtRateChanged(BoqTenderItem item, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            item.CustomManagementFeeRate = Math.Max(0.0, rate / 100.0);
            item.IsCustomRateEnabled = true;
            BoqAggregationEngine.RollupCostToTenderItem(item, _project);
            RecalculateAll();
        }
    }

    private void OnTenderProfitRateChanged(BoqTenderItem item, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            item.CustomProfitRate = Math.Max(0.0, rate / 100.0);
            item.IsCustomRateEnabled = true;
            BoqAggregationEngine.RollupCostToTenderItem(item, _project);
            RecalculateAll();
        }
    }

    private void OnGlobalManagementRateChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            _project.DefaultManagementFeeRate = Math.Max(0.0, rate / 100.0);
            RecalculateAll();
        }
    }

    private void OnGlobalProfitRateChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            _project.DefaultProfitRate = Math.Max(0.0, rate / 100.0);
            RecalculateAll();
        }
    }

    private void ResetToBenchmark()
    {
        _project = NingboOlympicSeedData.CreateBenchmarkProject();
        _expandedTenderItemTags.Clear();
        _expandedSubProjectCodes.Clear();
        RecalculateAll();
        ShowAlert("✓ 已成功重置为宁波奥体中心标准基准工程数据！");
    }

    // ======================= Tree-Grid 状态管理 =======================

    private bool IsTenderExpanded(string tag) => !string.IsNullOrEmpty(tag) && _expandedTenderItemTags.Contains(tag);
    private bool IsSubProjectExpanded(string code) => !string.IsNullOrEmpty(code) && _expandedSubProjectCodes.Contains(code);

    private void ToggleTenderExpand(string tag)
    {
        if (string.IsNullOrEmpty(tag)) return;
        if (!_expandedTenderItemTags.Add(tag))
            _expandedTenderItemTags.Remove(tag);
    }

    private void ToggleSubProjectExpand(string code)
    {
        if (string.IsNullOrEmpty(code)) return;
        if (!_expandedSubProjectCodes.Add(code))
            _expandedSubProjectCodes.Remove(code);
    }

    private void ExpandAll()
    {
        foreach (var item in _project.TenderItems)
        {
            if (!string.IsNullOrEmpty(item.ItemTag))
                _expandedTenderItemTags.Add(item.ItemTag);

            foreach (var sub in item.SubProjects)
            {
                if (!string.IsNullOrEmpty(sub.SubProjectCode))
                    _expandedSubProjectCodes.Add(sub.SubProjectCode);
            }
        }
    }

    private void CollapseAll()
    {
        _expandedTenderItemTags.Clear();
        _expandedSubProjectCodes.Clear();
    }

