    private async Task DownloadSpreadsheetXml()
    {
        try
        {
            byte[] bytes = BoqExcelExporter.ExportMultiPerspectiveXmlSpreadsheetBytes(_project, _projectResult);
            string base64 = Convert.ToBase64String(bytes);
            string fileName = $"宁波奥体中心_BOQ商务大盘_全受众5Sheet合一_{DateTime.Now:yyyyMMdd_HHmm}.xml";
            await TriggerBrowserDownload(fileName, "application/vnd.ms-excel", base64);
            ShowAlert($"✓ 已成功生成多工作表 Excel 文件: {fileName}");
        }
        catch (Exception ex)
        {
            ShowAlert($"导出失败: {ex.Message}");
        }
    }

    private async Task DownloadCurrentPerspectiveCsv()
    {
        try
        {
            byte[] bytes = BoqExcelExporter.ExportToCsvBytes(_projection);
            string base64 = Convert.ToBase64String(bytes);
            string fileName = $"宁波奥体中心_BOQ_{_currentPerspective}_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await TriggerBrowserDownload(fileName, "text/csv;charset=utf-8", base64);
            ShowAlert($"✓ 已成功导出当前视角 CSV 文件: {fileName}");
        }
        catch (Exception ex)
        {
            ShowAlert($"导出失败: {ex.Message}");
        }
    }

    private async Task TriggerBrowserDownload(string fileName, string contentType, string base64)
    {
        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = 'data:{contentType};base64,{base64}';
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ");
    }

    private void ShowAlert(string msg)
    {
        _copyAlertMessage = msg;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            _copyAlertMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    // ======================= Tab 1 辅助聚合方法 =======================

    private string GetCostRatio(Func<ProjectCostResult, double> selector)
    {
        if (_projectResult.TotalBidPrice <= 0.0) return "0.0";
        double val = selector(_projectResult);
        double ratio = (val / _projectResult.TotalBidPrice) * 100.0;
        return ratio.ToString("F1");
    }

    private class StructuralSystemGroup
    {
        public string SystemName { get; set; } = string.Empty;
        public int ComponentCount { get; set; }
        public double NetWeightTon { get; set; }
        public double GrossWeightTon { get; set; }
        public double DirectCostSum { get; set; }
        public double ScissorProfitSum { get; set; }
    }

    private List<StructuralSystemGroup> GetStructuralSystemAnalytics()
    {
        var allSubs = _project.TenderItems.SelectMany(t => t.SubProjects).ToList();
        return allSubs
            .GroupBy(s => string.IsNullOrWhiteSpace(s.StructuralRole) ? "其他结构" : s.StructuralRole)
            .Select(g => new StructuralSystemGroup
            {
                SystemName = g.Key,
                ComponentCount = g.Sum(s => Math.Max(1, s.Quantity)),
                NetWeightTon = g.Sum(s => s.SubProjectNetWeightKg) / 1000.0,
                GrossWeightTon = g.Sum(s => s.SubProjectGrossWeightKg) / 1000.0,
                DirectCostSum = g.Sum(s => s.TotalPartsMaterialCost + s.TotalFabricationCost + s.TotalInstallationCost + s.TotalFireCoatingCost),
                ScissorProfitSum = g.SelectMany(s => s.Parts).Sum(p => p.ArbitrageProfit)
            })
            .OrderByDescending(s => s.NetWeightTon)
            .ToList();
    }

    private class FireRatingGroup
    {
        public double RatingHours { get; set; }
        public string Description { get; set; } = string.Empty;
        public double SurfaceAreaM2 { get; set; }
        public double UnitPrice { get; set; }
        public double TotalCost { get; set; }
        public double Percentage { get; set; }
    }

    private List<FireRatingGroup> GetFireRatingAnalytics()
    {
        var allSubs = _project.TenderItems.SelectMany(t => t.SubProjects).ToList();
        double totalFireCost = _projectResult.TotalFireCoatingCost > 0 ? _projectResult.TotalFireCoatingCost : 1.0;

        return allSubs
            .GroupBy(s => s.FireRatingHours)
            .OrderByDescending(g => g.Key)
            .Select(g =>
            {
                double area = g.Sum(s => s.SubProjectSurfaceAreaM2);
                double rate = BoqAggregationEngine.CalculateFireRatingRate(g.Key);
                double cost = area * rate;
                string desc = g.Key >= 3.0 ? "室内特种厚型无机非膨胀挂网" : (g.Key >= 2.0 ? "中厚型无机非膨胀涂料" : "室内超薄型膨胀防火涂料");
                return new FireRatingGroup
                {
                    RatingHours = g.Key,
                    Description = desc,
                    SurfaceAreaM2 = area,
                    UnitPrice = rate,
                    TotalCost = cost,
                    Percentage = (cost / totalFireCost) * 100.0
                };
            })
            .ToList();
    }

    // ======================= Tab 1 钢材材质牌号交叉透视 =======================

    public List<SteelGradeAnalyticsRow> GetSteelGradeAnalytics()
    {
        if (_project?.TenderItems == null || _project.TenderItems.Count == 0)
            return new List<SteelGradeAnalyticsRow>();

        var allParts = _project.TenderItems
            .SelectMany(t => t.SubProjects)
            .SelectMany(s => s.Parts)
            .ToList();

        return allParts
            .GroupBy(p => string.IsNullOrWhiteSpace(p.SteelGrade) ? "其他材质" : p.SteelGrade.Trim())
            .Select(g =>
            {
                double netTon = g.Sum(p => p.TotalNetWeight) / 1000.0;
                double grossTon = g.Sum(p => p.TotalGrossWeight > 0.0 ? p.TotalGrossWeight : p.TotalNetWeight * 1.15) / 1000.0;
                double matCost = g.Sum(p => p.TotalPartMaterialCost);
                double scissorProfit = g.Sum(p => p.ArbitrageProfit);

                return new SteelGradeAnalyticsRow
                {
                    GradeName = g.Key,
                    PartCount = g.Sum(p => Math.Max(1, p.Quantity)),
                    TotalNetWeightTon = Math.Round(netTon, 3),
                    TotalGrossWeightTon = Math.Round(grossTon, 3),
                    TotalMaterialCost = Math.Round(matCost, 2),
                    TotalScissorProfit = Math.Round(scissorProfit, 2)
                };
            })
            .OrderByDescending(r => r.TotalNetWeightTon)
            .ToList();
    }
