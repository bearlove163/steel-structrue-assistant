                <span>📈 工程价格基准日 vs 当前结算日 调差比对模拟器</span>
            </h6>

            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">【合同基准日】锁价快照 (Base Date):</label>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-warning border-secondary" : "bg-white text-dark border-secondary-subtle")"
                            @bind="VarianceBaseSnapshotId" @bind:after="RecalculateVariance">
                        @foreach (var snap in AllSnapshots)
                        {
                            <option value="@snap.SnapshotId">
                                📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") - @snap.SnapshotName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">【当前结算日】生效快照 (Settlement Date):</label>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-success border-secondary" : "bg-white text-dark border-secondary-subtle")"
                            @bind="VarianceTargetSnapshotId" @bind:after="RecalculateVariance">
                        @foreach (var snap in AllSnapshots)
                        {
                            <option value="@snap.SnapshotId">
                                📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") - @snap.SnapshotName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">工程模拟用钢量 (吨):</label>
                    <input type="number" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                           @bind="SimulatedProjectTons" @bind:after="RecalculateVariance" />
                </div>
            </div>

            <!-- 调差比对表格 -->
            <div class="table-responsive mb-4">
                <table class="table @(Theme.IsDarkMode ? "table-dark table-hover table-bordered" : "table-hover table-bordered bg-white shadow-sm") small align-middle">
                    <thead class="@(Theme.IsDarkMode ? "table-secondary text-white" : "table-light text-dark")">
                        <tr>
                            <th>材料品种</th>
                            <th>合同基准日单价 (元/t)</th>
                            <th>当前结算日单价 (元/t)</th>
                            <th>吨钢涨跌差价 (ΔP)</th>
                            <th>涨跌幅 (%)</th>
                            <th>项目调差总金额影响 (ΔCost)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">普碳钢板 Q235B (20mm)</td>
                            <td>¥@BaseSnapshot.PlateBaseQ235B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.PlateBaseQ235B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B >= 0 ? "+" : "")
                                @((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B) / BaseSnapshot.PlateBaseQ235B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold">
                                ¥@(((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B) * SimulatedProjectTons * 0.4).ToString("N0"))
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">低合金高强板 Q355B (20mm)</td>
                            <td>¥@BaseSnapshot.PlateBaseQ355B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.PlateBaseQ355B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B >= 0 ? "+" : "")
                                @((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B) / BaseSnapshot.PlateBaseQ355B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold text-warning">
                                ¥@(((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B) * SimulatedProjectTons * 0.6).ToString("N0"))
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">热轧H型钢 Q355B</td>
                            <td>¥@BaseSnapshot.HBeamBaseQ355B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.HBeamBaseQ355B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B >= 0 ? "+" : "")
                                @((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B) / BaseSnapshot.HBeamBaseQ355B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold">
                                ¥@(((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B) * SimulatedProjectTons * 0.3).ToString("N0"))
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 调差测算结论框 -->
            <div class="p-3 @(Theme.IsDarkMode ? "bg-warning bg-opacity-10 border-warning text-white" : "bg-warning-subtle border-warning-subtle text-dark") border rounded">
                <div class="fw-bold text-warning mb-1">📌 材料价格波动工程调差评估结论</div>
                <div class="small @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                    在 @SimulatedProjectTons 吨工程模拟用量下，由于大盘价格随时间波动，材料采购成本预计变动
