@page "/material-pricing"
@using EngineeringApp.Shared.Material
@using EngineeringApp.Shared.Material.Pricing
@using EngineeringApp.Client.Services
@using System.Net.Http.Json
@inject NavigationManager Nav
@inject ThemeState Theme
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

<PageTitle>材料价格与供应链智能查询工作台</PageTitle>

<div class="container-fluid py-2 px-3 workstation-root d-flex flex-column min-vh-100 @(Theme.IsDarkMode ? "bg-dark text-white" : "bg-light text-dark")"
     data-theme="@(Theme.IsDarkMode ? "dark" : "light")">

    <!-- ======================= 顶部导航与大盘控制器 ======================= -->
    <header class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white rounded p-2 shadow-sm")">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo("/portal")' title="返回统一门户">
                <span>←</span>
                <span>门户中心</span>
            </button>
            <div class="p-2 bg-primary rounded-3 text-white fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                🧱
            </div>
            <div>
                <h5 class="mb-0 fw-bold tracking-tight d-flex align-items-center gap-2 @(Theme.IsDarkMode ? "text-white" : "text-dark")">
                    <span>模块 1：材料价格与供应链智能查询工作台</span>
                    <span class="badge bg-primary text-xs">PRICING WORKBENCH</span>
                </h5>
                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                    钢板五维加价规则 · 截面型材圆转方冷成型工艺 · 钢厂品牌溢价 · 跨省干线调运费 · 工业级标准 Describe 规范
                </div>
            </div>
        </div>

        <!-- 顶部工具栏：暗黑/亮色切换、多国标准切换、快照选择与快捷链接 -->
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <!-- 暗黑/亮色主题切换按钮 (和 /sections 完全同款风格) -->
            <button class="btn btn-sm d-flex align-items-center gap-1 @(Theme.IsDarkMode ? "btn-outline-warning" : "btn-outline-dark")"
                    @onclick="Theme.ToggleTheme" title="切换暗黑/亮色主题界面类型">
                <span>@(Theme.IsDarkMode ? "☀️ 亮色" : "🌙 暗黑")</span>
            </button>

            <!-- 标准体系切换器 -->
            <div class="btn-group btn-group-sm">
                <button class="btn @(CurrentStandard == StandardSystem.GB ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.GB)">
                    🇨🇳 国标 GB
                </button>
                <button class="btn @(CurrentStandard == StandardSystem.EN ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.EN)">
                    🇪🇺 欧标 EN
                </button>
                <button class="btn @(CurrentStandard == StandardSystem.ASTM ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.ASTM)">
                    🇺🇸 美标 ASTM
                </button>
            </div>

            <!-- 价格快照选择 -->
            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-black text-warning border-secondary" : "bg-white text-dark border-secondary-subtle") w-auto"
                    @bind="SelectedSnapshotId" @bind:after="OnSnapshotChanged">
                @foreach (var snap in AllSnapshots)
                {
                    <option value="@snap.SnapshotId">
                        📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") | @snap.SnapshotName @(snap.IsLocked ? "🔒[基准锁定]" : "")
                    </option>
                }
            </select>

            <button class="btn @(Theme.IsDarkMode ? "btn-outline-info" : "btn-info text-white") btn-sm" @onclick='() => Nav.NavigateTo("/sections")' title="打开截面力学视窗">
                📐 截面力学视窗
            </button>
        </div>
    </header>

    <!-- ======================= 大盘行情指标横幅 ======================= -->
    <div class="@(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-2 rounded border mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small">当前基准网价:</span>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                普板 Q235B: <b class="@(Theme.IsDarkMode ? "text-warning" : "text-danger")">¥@CurrentSnapshot.PlateBaseQ235B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                高强板 Q355B: <b class="text-success">¥@CurrentSnapshot.PlateBaseQ355B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                热轧H型钢: <b class="text-primary">¥@CurrentSnapshot.HBeamBaseQ355B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                热卷基料: <b class="@(Theme.IsDarkMode ? "text-white" : "text-dark")">¥@CurrentSnapshot.HotRolledCoilBase</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                无缝钢管: <b class="@(Theme.IsDarkMode ? "text-warning" : "text-primary")">¥@CurrentSnapshot.SeamlessTubeBase</b>/t
            </div>
        </div>
        <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small">
            数据来源: <span class="text-primary fw-bold">@CurrentSnapshot.SourceSupplier</span> | 含13%税
        </div>
    </div>

    <!-- ======================= 选项卡导航 ======================= -->
    <ul class="nav nav-tabs @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle") mb-3">
        <li class="nav-item">
            <button class="nav-link py-2 px-3 @(ActiveTab == 1 ? (Theme.IsDarkMode ? "active bg-dark text-primary border-primary border-bottom-0 fw-bold" : "active bg-white text-primary border-primary border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 1">
                📑 钢板五维加价核算矩阵 (Plate Matrix)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 px-3 @(ActiveTab == 2 ? (Theme.IsDarkMode ? "active bg-dark text-info border-info border-bottom-0 fw-bold" : "active bg-white text-primary border-info border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 2">
                ⚙️ 型材分类与圆转方工艺定价 (Profiles & R2S)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 px-3 @(ActiveTab == 3 ? (Theme.IsDarkMode ? "active bg-dark text-warning border-warning border-bottom-0 fw-bold" : "active bg-white text-warning border-warning border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 3">
                📈 大盘基准调差模拟器 (Base Price Variance)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-2 px-3 @(ActiveTab == 4 ? (Theme.IsDarkMode ? "active bg-dark text-success border-success border-bottom-0 fw-bold" : "active bg-white text-success border-success border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 4">
                📚 工程物料出处库与跨时序价格回溯 (Provenance & Retrospection)
                <span class="badge bg-success ms-1">@ProvenanceRecords.Count</span>
            </button>
        </li>
    </ul>

    <!-- ======================= 选项卡 1：钢板五维加价矩阵 ======================= -->
    @if (ActiveTab == 1)
    {
        <div class="row g-3 flex-grow-1">
            <!-- 左侧：参数输入控制器 (按工程逻辑：①材质尺寸 -> ②质量性能 -> ③钢厂物流) -->
            <div class="col-lg-7">
                <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary mb-0 d-flex align-items-center gap-2">
                            <span>🛠️ 钢板工程特性与加价配置</span>
                            <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small fw-normal">(材质尺寸 $\to$ 技术质量 $\to$ 采购交付)</span>
                        </h6>
                        <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white-50" : "bg-light text-muted border") text-xs">工程正向逻辑</span>
                    </div>

                    <!-- ================= 第一阶段：物理材质与几何尺寸 (Material & Dimensions) ================= -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary text-xs">阶段一</span>
                        <span class="small fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">物理材质牌号与公称板厚尺寸 (Material & Geometry)</span>
                    </div>

                    <!-- 1.1 材质牌号与公称板厚 (加价原则透明说明 + 用户自主设置加价 + 阶梯配置) -->
                    <div class="row g-3 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">材质牌号 (Steel Grade):</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary text-info" : "bg-white text-primary border-secondary-subtle") fw-bold"
                                    @bind="PlateParams.Grade" @bind:after="RecalculatePlate">
                                @if (CurrentStandard == StandardSystem.GB)
                                {
                                    <option value="@SteelGrade.Q235B">Q235B 普碳钢 (GB/T 700)</option>
                                    <option value="@SteelGrade.Q345B">Q345B 低合金钢</option>
                                    <option value="@SteelGrade.Q355B">Q355B 高强度结构钢</option>
                                    <option value="@SteelGrade.Q355C">Q355C 优质耐候钢 (0℃)</option>
                                    <option value="@SteelGrade.Q355D">Q355D 优质低温钢 (-20℃)</option>
                                    <option value="@SteelGrade.Q390B">Q390B 高强度结构钢</option>
                                    <option value="@SteelGrade.Q420B">Q420B 超强结构钢</option>
                                }
                                else if (CurrentStandard == StandardSystem.EN)
                                {
                                    <option value="@SteelGrade.S235JR">EN S235JR 欧标结构钢</option>
                                    <option value="@SteelGrade.S355JR">EN S355JR 欧标高强钢</option>
                                    <option value="@SteelGrade.S355J2">EN S355J2 欧标耐低温钢</option>
                                    <option value="@SteelGrade.S460N">EN S460N 欧标超高强钢</option>
                                }
                                else
                                {
                                    <option value="@SteelGrade.A36">ASTM A36 美标碳素钢</option>
                                    <option value="@SteelGrade.A572_Gr50">ASTM A572 Gr.50 美标高强钢</option>
                                    <option value="@SteelGrade.A992">ASTM A992 美标专用高强钢</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-8">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">
                                    公称板厚: <b class="@(Theme.IsDarkMode ? "text-warning" : "text-primary") fs-6">@PlateParams.ThicknessMm mm</b>
                                </label>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge @(CurrentPlatePrice.IsThicknessSurchargeCustomized ? "bg-warning text-dark" : (PlateParams.ThicknessMm >= 14 && PlateParams.ThicknessMm <= 20 ? "bg-success" : "bg-primary")) text-xs">
                                        实计加价: +@CurrentPlatePrice.ThicknessSurchargePerTon.ToString("0.##") 元/t
                                        @(CurrentPlatePrice.IsThicknessSurchargeCustomized ? "[自定义]" : "")
                                    </span>
                                    <button class="btn btn-xs @(ShowLadderConfigPanel ? "btn-secondary" : "btn-outline-primary") py-0 px-1"
                                            @onclick="() => ShowLadderConfigPanel = !ShowLadderConfigPanel"
                                            title="展开或折叠厚度加价阶梯规则配置表">
                                        📐 @(ShowLadderConfigPanel ? "收起规则表" : "配置阶梯表")
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <input type="range" class="form-range flex-grow-1" min="6" max="120" step="1"
                                       @bind="PlateParams.ThicknessMm" @bind:after="OnThicknessChanged" />
                                <input type="number" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")" style="width: 75px;"
                                       @bind="PlateParams.ThicknessMm" @bind:after="OnThicknessChanged" />
                            </div>
                        </div>
                    </div>

                    <!-- 板厚加价原则提示条与用户自定义微调输入框 -->
                    <div class="mb-3 p-2 rounded border @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-light border-light-subtle")">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="small @(Theme.IsDarkMode ? "text-warning" : "text-dark")">
                                <b>💡 板厚加价原则:</b> @CurrentPlatePrice.ThicknessPrincipleExplanation
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">自定义加价:</span>
                                <div class="input-group input-group-sm" style="width: 140px;">
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">+¥</span>
                                    <input type="number" class="form-control form-control-sm @(CurrentPlatePrice.IsThicknessSurchargeCustomized ? "border-warning fw-bold text-warning" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                           placeholder="@CurrentPlatePrice.BenchmarkThicknessSurcharge.ToString("0.##")"
                                           @bind="CustomThicknessInput" @bind:after="RecalculatePlate" />
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">/t</span>
                                </div>
                                @if (CurrentPlatePrice.IsThicknessSurchargeCustomized)
                                {
                                    <button class="btn btn-xs btn-outline-warning py-1" @onclick="ResetThicknessToBenchmark" title="重置回行业阶梯基准加价">
                                        ↺ 恢复基准 (+¥@CurrentPlatePrice.BenchmarkThicknessSurcharge.ToString("0.##"))
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- 展开的厚度加价阶梯矩阵表 -->
                        @if (ShowLadderConfigPanel)
                        {
                            <div class="mt-2 pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-bold text-primary">📋 行业厚度加价阶梯规则矩阵 (点击可修改自定义加价并保存至数据库):</span>
                                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">共 7 级厚度区间</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-bordered border-secondary" : "table-bordered border-light-subtle") text-xs mb-1">
                                        <thead>
                                            <tr class="@(Theme.IsDarkMode ? "bg-dark" : "bg-light")">
                                                <th>序号</th>
                                                <th>厚度区间 (mm)</th>
                                                <th>行业参考基准 (元/t)</th>
                                                <th>自定义加价 (元/t)</th>
                                                <th>工艺与质量控制原则</th>
                                                <th>当前状态</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var ladder in ThicknessLadders)
                                            {
                                                bool isCurrentHit = ladder.Matches(PlateParams.ThicknessMm);
                                                <tr class="@(isCurrentHit ? (Theme.IsDarkMode ? "table-primary text-white" : "table-primary") : "")">
                                                    <td>@ladder.Id</td>
                                                    <td class="fw-bold">@ladder.MinThicknessMm ~ @(ladder.MaxThicknessMm >= 900 ? "∞" : ladder.MaxThicknessMm.ToString("0")) mm</td>
                                                    <td>+¥@ladder.BenchmarkSurcharge.ToString("0")</td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm py-0 px-1 text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")" style="width: 85px;"
                                                               @bind="ladder.CustomSurcharge" @bind:after="RecalculatePlate" />
                                                    </td>
                                                    <td>@ladder.Description</td>
                                                    <td>
                                                        @if (isCurrentHit)
                                                        {
                                                            <span class="badge bg-success">★ 命中当前</span>
                                                        }
                                                        else if (ladder.IsCustomized)
                                                        {
                                                            <span class="badge bg-warning text-dark">已改动</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">默认基准</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-1">
                                    <button class="btn btn-xs btn-outline-secondary" @onclick="ResetLaddersToDefault">
                                        ↺ 恢复阶梯出厂默认
                                    </button>
                                    <button class="btn btn-xs btn-primary" @onclick="SaveCustomRulesToDatabase">
                                        💾 保存阶梯矩阵至数据库
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- 1.2 定尺尺寸与超限 (原则透明 + 用户自主微调 + 规则配置) -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">定尺切割状态:</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.CutType" @bind:after="OnCutTypeOrDimensionChanged">
                                <option value="@PlateDimensionCutType.FixedDimension">定宽定尺 (常规+¥60)</option>
                                <option value="@PlateDimensionCutType.MillStandard">钢厂散尺/非定尺 (¥0)</option>
                                <option value="@PlateDimensionCutType.SuperWide">超宽板定尺 (>2.8m, +¥160)</option>
                                <option value="@PlateDimensionCutType.SuperLong">超长板定尺 (>15m, +¥180)</option>
                                <option value="@PlateDimensionCutType.SmallCut">小定尺精密下料 (&lt;4m, +¥100)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">板宽 (mm):</label>
                            <input type="number" class="form-control form-control-sm @(PlateParams.WidthMm > 2800 ? "border-warning fw-bold text-warning" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                   @bind="PlateParams.WidthMm" @bind:after="OnCutTypeOrDimensionChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">板长 (mm):</label>
                            <input type="number" class="form-control form-control-sm @(PlateParams.LengthMm > 15000 ? "border-warning fw-bold text-warning" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                   @bind="PlateParams.LengthMm" @bind:after="OnCutTypeOrDimensionChanged" />
                        </div>
                    </div>

                    <!-- 尺寸超限加价原则提示条与用户自定义微调输入框 -->
                    <div class="mb-3 p-2 rounded border @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-light border-light-subtle")">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="small @(Theme.IsDarkMode ? "text-warning" : "text-dark")">
                                <b>💡 尺寸加价原则:</b> @CurrentPlatePrice.DimensionPrincipleExplanation
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">自定义尺寸加价:</span>
                                <div class="input-group input-group-sm" style="width: 140px;">
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">+¥</span>
                                    <input type="number" class="form-control form-control-sm @(CurrentPlatePrice.IsDimensionSurchargeCustomized ? "border-warning fw-bold text-warning" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                           placeholder="@CurrentPlatePrice.BenchmarkDimensionSurcharge.ToString("0.##")"
                                           @bind="CustomDimensionInput" @bind:after="RecalculatePlate" />
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">/t</span>
                                </div>
                                @if (CurrentPlatePrice.IsDimensionSurchargeCustomized)
                                {
                                    <button class="btn btn-xs btn-outline-warning py-1" @onclick="ResetDimensionToBenchmark" title="重置回规则计算参考加价">
                                        ↺ 恢复参考 (+¥@CurrentPlatePrice.BenchmarkDimensionSurcharge.ToString("0.##"))
                                    </button>
                                }
                                <button class="btn btn-xs @(ShowDimensionConfigPanel ? "btn-secondary" : "btn-outline-primary") py-1"
                                        @onclick="() => ShowDimensionConfigPanel = !ShowDimensionConfigPanel"
                                        title="查看板宽与尺寸超限规则说明">
                                    📐 @(ShowDimensionConfigPanel ? "收起规则" : "查看规则")
                                </button>
                            </div>
                        </div>

                        <!-- 展开的板宽与定尺规则清单 -->
                        @if (ShowDimensionConfigPanel)
                        {
                            <div class="mt-2 pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                                <div class="table-responsive">
                                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-bordered border-secondary" : "table-bordered border-light-subtle") text-xs mb-1">
                                        <thead>
                                            <tr class="@(Theme.IsDarkMode ? "bg-dark" : "bg-light")">
                                                <th>规则代号</th>
                                                <th>规则名称</th>
                                                <th>行业参考加价</th>
                                                <th>自定义加价</th>
                                                <th>触发条件与说明</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rule in DimensionRules)
                                            {
                                                <tr>
                                                    <td><code>@rule.RuleCode</code></td>
                                                    <td class="fw-bold">@rule.Name</td>
                                                    <td>+¥@rule.BenchmarkSurcharge.ToString("0")</td>
                                                    <td>
                                                        <input type="number" class="form-control form-control-sm py-0 px-1 text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")" style="width: 80px;"
                                                               @bind="rule.CustomSurcharge" @bind:after="RecalculatePlate" />
                                                    </td>
                                                    <td>@rule.ConditionDescription</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- ================= 第二阶段：技术质量与特种冶金性能 (Technical & Metallurgy Specs) ================= -->
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <span class="badge bg-info text-dark text-xs">阶段二</span>
                        <span class="small fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">技术质量等级与特种冶金性能 (Technical & Metallurgy Specs)</span>
                    </div>

                    <!-- 2.1 公差等级与平整度 (用户特别强调的公差加价) -->
                    <div class="row g-2 mb-3 p-2 @(Theme.IsDarkMode ? "bg-primary bg-opacity-10 border-primary border-opacity-25" : "bg-primary-subtle border-primary-subtle") rounded border">
                        <div class="col-md-6">
                            <label class="form-label small text-primary fw-bold mb-1">★ 厚度公差等级 (GB/T 709 / EN 10029):</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-warning border-primary" : "bg-white text-primary border-primary") fw-bold"
                                    @bind="PlateParams.Tolerance" @bind:after="RecalculatePlate">
                                <option value="@ToleranceClass.ClassA">A类公差 (常规允许负偏差, 基准¥0)</option>
                                <option value="@ToleranceClass.ClassB">B类公差 (严控负偏差≤-0.3mm, +¥60)</option>
                                <option value="@ToleranceClass.ClassC">★ C类公差 (保证全厚度，无负偏差, +¥150)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">不平度平整精度:</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.Flatness" @bind:after="RecalculatePlate">
                                <option value="@FlatnessClass.Normal_N">普通平整度 (N级, ¥0)</option>
                                <option value="@FlatnessClass.High_H">高级平整度 (H级 / 超平整校平, +¥90)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 2.2 性能、冶金工艺与探伤认证 -->
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">冲击功等级:</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.Impact" @bind:after="RecalculatePlate">
                                <option value="@ImpactGrade.GradeB">B级 / 常温 (¥0)</option>
                                <option value="@ImpactGrade.GradeC">C级 / 0℃ (+¥60)</option>
                                <option value="@ImpactGrade.GradeD">D级 / -20℃ (+¥150)</option>
                                <option value="@ImpactGrade.GradeE">E级 / -40℃ (+¥350)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">Z向抗撕裂:</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.ZDirection" @bind:after="RecalculatePlate">
                                <option value="@ZDirectionQuality.None">无要求 (¥0)</option>
                                <option value="@ZDirectionQuality.Z15">Z15 性能 (+¥150)</option>
                                <option value="@ZDirectionQuality.Z25">Z25 性能 (+¥250)</option>
                                <option value="@ZDirectionQuality.Z35">Z35 性能 (+¥400)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">控轧与热处理:</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.Metallurgy" @bind:after="RecalculatePlate">
                                <option value="@MetallurgyProcess.AsRolled">热轧出厂 (¥0)</option>
                                <option value="@MetallurgyProcess.TMCP">TMCP 控轧 (+¥100)</option>
                                <option value="@MetallurgyProcess.Normalized">正火处理 (+¥180)</option>
                                <option value="@MetallurgyProcess.QuenchedAndTempered">调质处理 (+¥300)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">无损探伤 (UT):</label>
                            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.UT" @bind:after="RecalculatePlate">
                                <option value="@UltrasonicInspection.None">常规无探伤 (¥0)</option>
                                <option value="@UltrasonicInspection.ClassII">二级探伤 (+¥120)</option>
                                <option value="@UltrasonicInspection.ClassI">一级探伤 (+¥220)</option>
                            </select>
                        </div>
                    </div>

                    <!-- 欧标特殊 3.2 证书选择 -->
                    <div class="mt-2 text-end">
                        <div class="form-check form-check-inline small">
                            <input class="form-check-input" type="checkbox" id="check32"
                                   checked="@(PlateParams.Certificate == InspectionCertificateType.EN10204_32)"
                                   @onchange="Toggle32Cert" />
                            <label class="form-check-label @(Theme.IsDarkMode ? "text-white-50" : "text-muted")" for="check32">
                                需第三方独立机构 (BV/DNV) 见证签名 <b>EN 10204 3.2 检验证书</b> (+¥450/t)
                            </label>
                        </div>
                    </div>

                    <!-- ================= 第三阶段：供应链采购与商务物流交付 (Supply Chain & Logistics) ================= -->
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <span class="badge bg-warning text-dark text-xs">阶段三</span>
                        <span class="small fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">供应链采购钢厂与物流调运交付 (Supply Chain & Logistics)</span>
                    </div>

                    <!-- 3.1 钢厂品牌与产地 + 3.2 交货状态与物流调运 (支持基准参考与用户直接修改/时序关联) -->
                    <div class="row g-2 mb-3 p-2 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary border-opacity-50" : "bg-light border-light-subtle") rounded border">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">钢厂品牌与产地 (Mill & Origin):</label>
                                <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                                    参考基准: +¥@CurrentPlatePrice.BenchmarkMillPremium.ToString("0.##")/t
                                </span>
                            </div>
                            <select class="form-select form-select-sm mb-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                    @bind="PlateParams.SteelMillId" @bind:after="OnMillChanged">
                                @foreach (var mill in AllMills)
                                {
                                    <option value="@mill.Id">
                                        @mill.Name (@mill.ProductionBase) [参考溢价: @(mill.BrandPremiumPerTon >= 0 ? "+" : "")@mill.BrandPremiumPerTon 元/t]
                                    </option>
                                }
                            </select>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-nowrap">实付溢价:</span>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">¥</span>
                                    <input type="number" class="form-control form-control-sm @(CurrentPlatePrice.IsMillPremiumCustomized ? "border-warning fw-bold text-warning bg-warning bg-opacity-10" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                           placeholder="@CurrentPlatePrice.BenchmarkMillPremium.ToString("0.##")"
                                           @bind="CustomMillPremiumInput" @bind:after="RecalculatePlate" />
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">/t</span>
                                </div>
                                @if (CurrentPlatePrice.IsMillPremiumCustomized)
                                {
                                    <button class="btn btn-xs btn-outline-warning text-nowrap py-1" @onclick="ResetMillToBenchmark" title="恢复钢厂参考基准溢价">
                                        ↺ 恢复参考
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">交货状态与物流调运 (Delivery & Freight):</label>
                                <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                                    预设运费: ¥@CurrentPlatePrice.BenchmarkFreight.ToString("0.##")/t
                                </span>
                            </div>
                            <div class="input-group input-group-sm mb-1">
                                <select class="form-select @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                        @bind="PlateParams.Delivery" @bind:after="OnDeliveryOrDestinationChanged">
                                    <option value="@DeliveryCondition.Delivered_FabricationPlant">制造车间落地价</option>
                                    <option value="@DeliveryCondition.Delivered_JobSite">施工现场直达价</option>
                                    <option value="@DeliveryCondition.ExWorks_Mill">钢厂车板出厂价 (自提)</option>
                                    <option value="@DeliveryCondition.FOB_ChinesePort">出口港口集港价 (FOB)</option>
                                </select>
                                <select class="form-select @(Theme.IsDarkMode ? "bg-dark text-warning border-secondary" : "bg-white text-primary fw-bold border-secondary-subtle")"
                                        @bind="PlateParams.DestinationRegion" @bind:after="OnDeliveryOrDestinationChanged"
                                        disabled="@(PlateParams.Delivery == DeliveryCondition.ExWorks_Mill)">
                                    <option value="华东-浙江制造车间">华东-浙江车间 (预设¥50)</option>
                                    <option value="华南-广东工程现场">华南-广东现场 (预设¥200)</option>
                                    <option value="上海港国际集港码头 (FOB)">上海港码头 (预设¥220)</option>
                                    <option value="京津冀鲁本地项目">京津冀鲁本地 (预设¥50)</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-nowrap">实际调运:</span>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">¥</span>
                                    <input type="number" class="form-control form-control-sm @(CurrentPlatePrice.IsFreightCustomized ? "border-warning fw-bold text-warning bg-warning bg-opacity-10" : (Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle"))"
                                           placeholder="@CurrentPlatePrice.BenchmarkFreight.ToString("0.##")"
                                           @bind="CustomFreightInput" @bind:after="RecalculatePlate"
                                           disabled="@(PlateParams.Delivery == DeliveryCondition.ExWorks_Mill)" />
                                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "bg-light text-muted") py-0">/t</span>
                                </div>
                                @if (CurrentPlatePrice.IsFreightCustomized && PlateParams.Delivery != DeliveryCondition.ExWorks_Mill)
                                {
                                    <button class="btn btn-xs btn-outline-warning text-nowrap py-1" @onclick="ResetFreightToBenchmark" title="恢复预设调运运费">
                                        ↺ 恢复预设
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 底部：数据库持久化同步与重置操作条 -->
                    <div class="mt-3 pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle") d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="SaveCustomRulesToDatabase" title="将当前自定义修改的阶梯、溢价及运费持久化保存至材料数据库">
                                <span>💾</span>
                                <span>保存配置至数据库</span>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetAllToDefaults" title="重置全部加价阶梯、钢厂溢价与调运费为官方行业标准">
                                <span>🔄</span>
                                <span>重置所有基准</span>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(SaveFeedbackMessage))
                        {
                            <span class="text-success small fw-bold animate-pulse">@SaveFeedbackMessage</span>
                        }
                    </div>
                </div>
            </div>

            <!-- 右侧：实时核算结果与标准化 Describe 规范 -->
            <div class="col-lg-5">
                <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-primary" : "bg-white border-primary shadow") p-3 h-100 shadow d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                        <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small">核算模式：钢板全要素采购价</span>
                        <span class="badge bg-primary">即时自动重算</span>
                    </div>

                    <!-- 最终综合吨单价巨大徽章 -->
                    <div class="@(Theme.IsDarkMode ? "bg-primary bg-opacity-10 border-primary border-opacity-50" : "bg-primary-subtle border-primary") p-3 rounded-3 border text-center mb-2">
                        <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small mb-1">最终综合采购到货单价</div>
                        <div class="display-6 fw-bold text-success tracking-tight">
                            ¥ @CurrentPlatePrice.FinalPricePerTon.ToString("N2")
                            <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">元/吨</span>
                        </div>
                        <div class="text-primary small mt-1">
                            包含钢厂出厂基价 + 各项加价 + 调运物流费
                        </div>
                    </div>

                    <!-- 物料出处唯一特征标签与入库记录卡片 -->
                    <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-60 border-info border-opacity-50" : "bg-light border-info-subtle")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-info text-dark text-xs">🏷️ 物料出处特征标签 (唯一指纹)</span>
                            <button class="btn btn-xs btn-outline-info py-0 px-2" @onclick="CopyTagToClipboard" title="复制唯一标签">
                                📋 复制标签
                            </button>
                        </div>
                        <div class="font-monospace text-xs p-1 rounded border @(Theme.IsDarkMode ? "bg-black text-info border-secondary" : "bg-white text-primary border-light-subtle") text-truncate user-select-all" title="@CurrentPlateTag">
                            @CurrentPlateTag
                        </div>

                        <!-- 批次、工程与询价时间明细录入 -->
                        <div class="mt-2 pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                            <div class="row g-1 mb-1">
                                <div class="col-6">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">工程项目名称:</label>
                                    <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                           placeholder="项目名称" @bind="ProvenanceArchiveProjectInput" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">询价批次号:</label>
                                    <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs font-monospace"
                                           placeholder="如 INQ-20260401-LOT03" @bind="ProvenanceArchiveBatchInput" />
                                </div>
                            </div>
                            <div class="row g-1 mb-1">
                                <div class="col-6">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">询价具体日期:</label>
                                    <input type="date" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                           @bind="ProvenanceArchiveDateInput" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">报价渠道/供应商:</label>
                                    <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                           placeholder="如 宝武直供/现货仓" @bind="ProvenanceArchiveVendorInput" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">适用加价原则公函/依据:</label>
                                <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                       placeholder="如 2026Q1钢厂加价公函与现行阶梯" @bind="ProvenanceArchivePrincipleInput" />
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">初始版本: <b class="text-success">Rev 1</b></span>
                                <button class="btn btn-sm btn-success text-nowrap d-flex align-items-center gap-1 py-1 px-3 fw-bold"
                                        @onclick="ArchiveCurrentPlateToProvenance" title="将当前配置钢板归档入库，记录时间与成本出处">
                                    <span>📌 登记入库</span>
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ProvenanceSaveFeedbackMessage))
                        {
                            <div class="text-success text-xs mt-2 p-1 rounded bg-success bg-opacity-10 border border-success border-opacity-25 d-flex align-items-center justify-content-between">
                                <span>@ProvenanceSaveFeedbackMessage</span>
                                <button class="btn btn-link text-info text-xs p-0 text-decoration-none fw-bold" @onclick="() => ActiveTab = 4">
                                    前往出处库回溯 →
                                </button>
                            </div>
                        }
                    </div>

                    <!-- 瀑布分解明细卡片 -->
                    <div class="mb-3">
                        <div class="small fw-bold @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-2">加价因子明细拆解 (元/吨):</div>
                        <div class="table-responsive">
                            <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-borderless" : "table-light table-borderless") small mb-0">
                                <tbody>
                                    <tr>
                                        <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">1. 大盘基准单价:</td>
                                        <td class="text-end fw-bold">¥@CurrentPlatePrice.BasePricePerTon.ToString("0.##")</td>
                                    </tr>
                                    <tr>
                                        <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">2. 钢厂品牌溢价:</td>
                                        <td class="text-end text-primary">
                                            +¥@CurrentPlatePrice.MillPremiumPerTon.ToString("0.##")
                                            @if (CurrentPlatePrice.IsMillPremiumCustomized)
                                            {
