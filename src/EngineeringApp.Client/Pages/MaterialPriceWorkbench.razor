    private async Task LoadProvenanceRecordsFromApi()
    {
        try
        {
            var records = await Http.GetFromJsonAsync<List<MaterialProvenanceRecord>>("/api/pricing/provenance-records");
            if (records != null && records.Count > 0)
            {
                ProvenanceRecords = records;
                foreach (var r in ProvenanceRecords)
                {
                    if (!RecordTons.ContainsKey(r.Id)) RecordTons[r.Id] = 100.0;
                }
                StateHasChanged();
            }
        }
        catch { }
    }

