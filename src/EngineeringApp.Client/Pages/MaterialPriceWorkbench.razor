@page "/material-pricing"
@using EngineeringApp.Shared.Material
@using EngineeringApp.Shared.Material.Pricing
@using EngineeringApp.Client.Services
@using EngineeringApp.Client.Shared.Pricing
@using System.Net.Http.Json
@inject NavigationManager Nav
@inject ThemeState Theme
@inject HttpClient Http
@implements IDisposable

<PageTitle>材料价格与供应链智能查询工作台</PageTitle>

<div class="container-fluid py-2 px-3 workstation-root d-flex flex-column min-vh-100 @(Theme.IsDarkMode ? "bg-dark text-white" : "bg-light text-dark")"
     data-theme="@(Theme.IsDarkMode ? "dark" : "light")">

    <!-- ======================= 顶部导航与大盘控制器 ======================= -->
    <header class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white rounded p-2 shadow-sm")">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo("/portal")' title="返回统一门户">
                <span>←</span>
                <span>门户中心</span>
            </button>
            <div class="p-2 bg-primary rounded-3 text-white fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                🧱
            </div>
            <div>
                <h5 class="mb-0 fw-bold tracking-tight d-flex align-items-center gap-2 @(Theme.IsDarkMode ? "text-white" : "text-dark")">
                    <span>模块 1：材料价格与供应链智能查询工作台</span>
                    <span class="badge bg-primary text-xs">PRICING WORKBENCH</span>
                </h5>
                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                    钢板五维加价规则 · 截面型材圆转方冷成型工艺 · 钢厂品牌溢价 · 跨省干线调运费 · 工业级标准 Describe 规范
                </div>
            </div>
        </div>

        <!-- 顶部工具栏：暗黑/亮色切换、多国标准切换、快照选择与快捷链接 -->
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <!-- 暗黑/亮色主题切换按钮 -->
            <button class="btn btn-sm d-flex align-items-center gap-1 @(Theme.IsDarkMode ? "btn-outline-warning" : "btn-outline-dark")"
                    @onclick="Theme.ToggleTheme" title="切换暗黑/亮色主题界面类型">
                <span>@(Theme.IsDarkMode ? "☀️ 亮色" : "🌙 暗黑")</span>
            </button>

            <!-- 标准体系切换器 -->
            <div class="btn-group btn-group-sm">
                <button class="btn @(CurrentStandard == StandardSystem.GB ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.GB)">
                    🇨🇳 国标 GB
                </button>
                <button class="btn @(CurrentStandard == StandardSystem.EN ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.EN)">
                    🇪🇺 欧标 EN
                </button>
                <button class="btn @(CurrentStandard == StandardSystem.ASTM ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => ChangeStandard(StandardSystem.ASTM)">
                    🇺🇸 美标 ASTM
                </button>
            </div>

            <!-- 价格快照选择 -->
            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-black text-warning border-secondary" : "bg-white text-dark border-secondary-subtle") w-auto"
                    @bind="SelectedSnapshotId" @bind:after="OnSnapshotChanged">
                @foreach (var snap in AllSnapshots)
                {
                    <option value="@snap.SnapshotId">
                        📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") | @snap.SnapshotName @(snap.IsLocked ? "🔒[基准锁定]" : "")
                    </option>
                }
            </select>

            <button class="btn @(Theme.IsDarkMode ? "btn-outline-info" : "btn-info text-white") btn-sm" @onclick='() => Nav.NavigateTo("/sections")' title="打开截面力学视窗">
                📐 截面力学视窗
            </button>
        </div>
    </header>

    <!-- ======================= 大盘行情指标横幅 ======================= -->
    <div class="@(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-white border-light-subtle shadow-sm") p-2 rounded border mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small">当前基准网价:</span>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                普板 Q235B: <b class="@(Theme.IsDarkMode ? "text-warning" : "text-danger")">¥@CurrentSnapshot.PlateBaseQ235B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                高强板 Q355B: <b class="text-success">¥@CurrentSnapshot.PlateBaseQ355B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                热轧H型钢: <b class="text-primary">¥@CurrentSnapshot.HBeamBaseQ355B</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                热卷基料: <b class="@(Theme.IsDarkMode ? "text-white" : "text-dark")">¥@CurrentSnapshot.HotRolledCoilBase</b>/t
            </div>
            <div class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-dark border")">
                无缝钢管: <b class="@(Theme.IsDarkMode ? "text-warning" : "text-primary")">¥@CurrentSnapshot.SeamlessTubeBase</b>/t
            </div>
        </div>
        <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small">
            数据来源: <span class="text-primary fw-bold">@CurrentSnapshot.SourceSupplier</span> | 含13%税
        </div>
    </div>

    <!-- ======================= 选项卡导航 ======================= -->
    <ul class="nav nav-tabs @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle") mb-2 flex-nowrap overflow-x-auto">
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(ActiveTab == 1 ? (Theme.IsDarkMode ? "active bg-dark text-primary border-primary border-bottom-0 fw-bold" : "active bg-white text-primary border-primary border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 1">
                📑 钢板五维加价
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(ActiveTab == 2 ? (Theme.IsDarkMode ? "active bg-dark text-info border-info border-bottom-0 fw-bold" : "active bg-white text-primary border-info border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 2">
                ⚙️ 型材与圆转方
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(ActiveTab == 3 ? (Theme.IsDarkMode ? "active bg-dark text-warning border-warning border-bottom-0 fw-bold" : "active bg-white text-warning border-warning border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 3">
                📈 大盘调差模拟
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link py-1.5 px-3 text-nowrap @(ActiveTab == 4 ? (Theme.IsDarkMode ? "active bg-dark text-success border-success border-bottom-0 fw-bold" : "active bg-white text-success border-success border-bottom-0 fw-bold shadow-sm") : (Theme.IsDarkMode ? "text-white-50" : "text-secondary"))"
                    @onclick="() => ActiveTab = 4">
                📚 出处库与审计履历
                <span class="badge bg-success ms-1">@ProvenanceRecords.Count 批次</span>
                <span class="badge bg-warning text-dark text-xs ms-1">★ Rev审计</span>
            </button>
        </li>
    </ul>

    <!-- ======================= 选项卡 1：钢板五维加价矩阵 ======================= -->
    @if (ActiveTab == 1)
    {
        <PlatePricingCalculator CurrentStandard="CurrentStandard"
                                CurrentSnapshot="CurrentSnapshot"
                                AllMills="AllMills"
                                ThicknessLadders="ThicknessLadders"
                                DimensionRules="DimensionRules"
                                OnArchiveRecord="HandleArchiveRecord"
                                OnGoToProvenance="() => ActiveTab = 4" />
    }

    <!-- ======================= 选项卡 2：型材与圆转方工艺定价 ======================= -->
    @if (ActiveTab == 2)
    {
        <ProfilePricingCalculator CurrentSnapshot="CurrentSnapshot"
                                  CurrentStandard="CurrentStandard"
                                  AllMills="AllMills" />
    }

    <!-- ======================= 选项卡 3：时间序列调差模拟器 ======================= -->
    @if (ActiveTab == 3)
    {
        <MarketSpreadSimulationView AllSnapshots="AllSnapshots"
                                    OnNavigateToProvenance="() => ActiveTab = 4" />
    }

    <!-- ======================= 选项卡 4：工程物料出处库与跨时序价格回溯 ======================= -->
    @if (ActiveTab == 4)
    {
        <ProvenanceRetrospectionGrid Records="ProvenanceRecords"
                                     AllSnapshots="AllSnapshots"
                                     ThicknessLadders="ThicknessLadders"
                                     DimensionRules="DimensionRules"
                                     OnOpenRevision="OpenRevisionModal"
                                     OnOpenAudit="OpenAuditModal"
                                     OnRemoveRecord="RemoveProvenanceRecord"
                                     OnRecordUpdated="HandleRecordUpdated"
                                     OnNavigateToPlateConfig="() => ActiveTab = 1" />
    }

    <!-- ======================= 模态框：价格修改与加价原则修订 ======================= -->
    <PriceRevisionModal IsVisible="ShowRevisionModal"
                        Record="EditingRecord"
                        OnClose="CloseRevisionModal"
                        OnRecordUpdated="HandleRecordUpdated" />

    <!-- ======================= 模态框：价格修改全过程审计履历 ======================= -->
    <PriceAuditTimelineDrawer IsVisible="ShowAuditModal"
                              Record="SelectedRecordForAudit"
                              OnClose="CloseAuditModal" />

</div>

@code {
    private int ActiveTab = 1;
    private StandardSystem CurrentStandard = StandardSystem.GB;

    private List<MaterialPriceSnapshot> AllSnapshots = [];
    private List<SteelMillBrand> AllMills = [];
    private string SelectedSnapshotId = "";
    private MaterialPriceSnapshot CurrentSnapshot = SeedPriceSnapshots.Latest;

    // 数据库持久化规则模型与用户自定义微调状态
    private List<PlateThicknessLadder> ThicknessLadders = PlateThicknessLadder.GetDefaultLadders();
    private List<PlateDimensionRule> DimensionRules = PlateDimensionRule.GetDefaultRules();

    // 物料出处记录库与跨时序价格回溯
    private List<MaterialProvenanceRecord> ProvenanceRecords = [];

    // 价格修改与原则修订模态框状态
    private bool ShowRevisionModal = false;
    private MaterialProvenanceRecord? EditingRecord = null;

    // 过程审计履历模态框状态
    private bool ShowAuditModal = false;
    private MaterialProvenanceRecord? SelectedRecordForAudit = null;

    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;

        AllSnapshots = SeedPriceSnapshots.AllSnapshots;
        AllMills = SeedSteelMills.AllMills;
        SelectedSnapshotId = AllSnapshots[0].SnapshotId;
        CurrentSnapshot = AllSnapshots[0];

        ProvenanceRecords = [.. SeedProvenanceRecords.AllRecords];

        _ = LoadProvenanceRecordsFromApi();
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }

    private void ChangeStandard(StandardSystem std)
    {
        CurrentStandard = std;
    }

    private void OnSnapshotChanged()
    {
        CurrentSnapshot = SeedPriceSnapshots.GetById(SelectedSnapshotId);
    }

    private async Task HandleArchiveRecord(MaterialProvenanceRecord newRecord)
    {
        int nextId = ProvenanceRecords.Count > 0 ? ProvenanceRecords.Max(r => r.Id) + 1 : 1;
        newRecord.Id = nextId;
        if (newRecord.RevisionLogs.Count > 0)
        {
            newRecord.RevisionLogs[0].RecordId = nextId;
        }

        ProvenanceRecords.Insert(0, newRecord);
        SeedProvenanceRecords.AddRecord(newRecord);

        try
        {
            await Http.PostAsJsonAsync("/api/pricing/provenance-records", newRecord);
        }
        catch { }

        StateHasChanged();
    }

    private void HandleRecordUpdated(MaterialProvenanceRecord updatedRecord)
    {
        StateHasChanged();
    }

    private void OpenRevisionModal(MaterialProvenanceRecord rec)
    {
        EditingRecord = rec;
        ShowRevisionModal = true;
    }

    private void CloseRevisionModal()
    {
        ShowRevisionModal = false;
        EditingRecord = null;
    }

    private void OpenAuditModal(MaterialProvenanceRecord rec)
    {
        SelectedRecordForAudit = rec;
        ShowAuditModal = true;
    }

    private void CloseAuditModal()
    {
        ShowAuditModal = false;
        SelectedRecordForAudit = null;
    }

    private async Task RemoveProvenanceRecord(int id)
    {
        var item = ProvenanceRecords.FirstOrDefault(r => r.Id == id);
        if (item != null)
        {
            ProvenanceRecords.Remove(item);
            try
            {
                await Http.DeleteAsync($"/api/pricing/provenance-records/{id}");
            }
            catch { }
            StateHasChanged();
        }
    }

    private async Task LoadProvenanceRecordsFromApi()
    {
        try
        {
            var records = await Http.GetFromJsonAsync<List<MaterialProvenanceRecord>>("/api/pricing/provenance-records");
            if (records != null && records.Count > 0)
            {
                ProvenanceRecords = records;
                StateHasChanged();
            }
        }
        catch { }
    }
}
