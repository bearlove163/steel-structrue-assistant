        if (Math.Abs(EditThicknessSurcharge - EditingRecord.ThicknessSurchargePerTon) > 0.01)
            detailsBuilder.Add($"厚度加价: ¥{EditingRecord.ThicknessSurchargePerTon:0.##} ➔ ¥{EditThicknessSurcharge:0.##}");
        if (Math.Abs(EditFreightPerTon - EditingRecord.FreightPerTon) > 0.01)
            detailsBuilder.Add($"调运费: ¥{EditingRecord.FreightPerTon:0.##} ➔ ¥{EditFreightPerTon:0.##}");
        if (Math.Abs(EditMillPremium - EditingRecord.MillPremiumPerTon) > 0.01)
            detailsBuilder.Add($"钢厂溢价: ¥{EditingRecord.MillPremiumPerTon:0.##} ➔ ¥{EditMillPremium:0.##}");
        if (Math.Abs(EditDimensionSurcharge - EditingRecord.DimensionSurchargePerTon) > 0.01)
            detailsBuilder.Add($"定尺加价: ¥{EditingRecord.DimensionSurchargePerTon:0.##} ➔ ¥{EditDimensionSurcharge:0.##}");
        if (Math.Abs(EditToleranceSurcharge - EditingRecord.ToleranceSurchargePerTon) > 0.01)
            detailsBuilder.Add($"公差加价: ¥{EditingRecord.ToleranceSurchargePerTon:0.##} ➔ ¥{EditToleranceSurcharge:0.##}");
        if (detailsBuilder.Count == 0)
            detailsBuilder.Add("价格微调与原则确认");

        string autoDetails = string.Join("; ", detailsBuilder);
        if (!string.IsNullOrWhiteSpace(EditChangeDetails))
        {
            autoDetails = $"{autoDetails} ({EditChangeDetails})";
        }

        // 更新记录字段
        EditingRecord.InquiryBatchId = EditInquiryBatchId;
        EditingRecord.InquiryVendor = EditInquiryVendor;
        EditingRecord.ThicknessSurchargePerTon = EditThicknessSurcharge;
        EditingRecord.FreightPerTon = EditFreightPerTon;
        EditingRecord.MillPremiumPerTon = EditMillPremium;
        EditingRecord.DimensionSurchargePerTon = EditDimensionSurcharge;
        EditingRecord.ToleranceSurchargePerTon = EditToleranceSurcharge;

        // 同步更新内部参数对象
        if (EditingRecord.PlateParameters != null)
        {
            EditingRecord.PlateParameters.CustomThicknessSurcharge = EditThicknessSurcharge;
            EditingRecord.PlateParameters.CustomFreightPerTon = EditFreightPerTon;
            EditingRecord.PlateParameters.CustomMillPremium = EditMillPremium;
            EditingRecord.PlateParameters.CustomDimensionSurcharge = EditDimensionSurcharge;
        }

        // 调用 AddRevision 写入审计履历并递增版本号
        EditingRecord.AddRevision(
            reason: EditRevisionReason,
            revisedBy: EditRevisionAuthor,
            newPricePerTon: newPrice,
            changeDetails: autoDetails,
            appliedPrinciple: EditRevisionPrincipleNote
        );

        // 同步更新服务器数据库
        try
        {
            await Http.PutAsJsonAsync($"/api/pricing/provenance-records/{EditingRecord.Id}", EditingRecord);
        }
        catch { }

        CloseRevisionModal();
        StateHasChanged();
    }

    private void OpenAuditModal(MaterialProvenanceRecord rec)
