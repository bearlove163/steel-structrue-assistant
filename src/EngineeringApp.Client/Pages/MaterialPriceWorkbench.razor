                                                        @log.ChangeDetails
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseAuditModal">关闭</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

