    private double GetRecordTons(int id) => RecordTons.TryGetValue(id, out var t) ? t : 100.0;

    private void SetRecordTons(int id, object? val)
    {
        if (double.TryParse(val?.ToString(), out var parsed) && parsed >= 0)
        {
            RecordTons[id] = parsed;
            StateHasChanged();
        }
    }

    private void ResetRecordTons()
    {
        RecordTons.Clear();
        foreach (var r in ProvenanceRecords) RecordTons[r.Id] = 100.0;
        StateHasChanged();
    }

    private double GetTotalProjectTons() => ProvenanceRecords.Sum(r => GetRecordTons(r.Id));

    private double GetTotalBaseRecordedCost() => ProvenanceRecords.Sum(r => r.FinalPricePerTon * GetRecordTons(r.Id));

    private double GetTotalRetrospectiveCost() => ProvenanceRecords.Sum(r => r.CalculateAtSnapshot(RetrospectionTargetSnapshot, ThicknessLadders, DimensionRules, CurrentPrincipleMode).FinalPricePerTon * GetRecordTons(r.Id));

    private double GetTotalCostVariance() => GetTotalRetrospectiveCost() - GetTotalBaseRecordedCost();

