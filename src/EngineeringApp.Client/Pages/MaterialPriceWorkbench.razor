    <!-- ======================= 选项卡 3：时间序列调差模拟器 ======================= -->
    @if (ActiveTab == 3)
    {
        <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 flex-grow-1">
            <h6 class="fw-bold @(Theme.IsDarkMode ? "text-warning" : "text-dark") mb-3 d-flex align-items-center gap-2">
                <span>📈 工程价格基准日 vs 当前结算日 调差比对模拟器</span>
            </h6>

            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">【合同基准日】锁价快照 (Base Date):</label>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-warning border-secondary" : "bg-white text-dark border-secondary-subtle")"
                            @bind="VarianceBaseSnapshotId" @bind:after="RecalculateVariance">
                        @foreach (var snap in AllSnapshots)
                        {
                            <option value="@snap.SnapshotId">
                                📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") - @snap.SnapshotName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">【当前结算日】生效快照 (Settlement Date):</label>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-success border-secondary" : "bg-white text-dark border-secondary-subtle")"
                            @bind="VarianceTargetSnapshotId" @bind:after="RecalculateVariance">
                        @foreach (var snap in AllSnapshots)
                        {
                            <option value="@snap.SnapshotId">
                                📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") - @snap.SnapshotName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">工程模拟用钢量 (吨):</label>
                    <input type="number" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                           @bind="SimulatedProjectTons" @bind:after="RecalculateVariance" />
                </div>
            </div>

            <!-- 调差比对表格 -->
            <div class="table-responsive mb-4">
                <table class="table @(Theme.IsDarkMode ? "table-dark table-hover table-bordered" : "table-hover table-bordered bg-white shadow-sm") small align-middle">
                    <thead class="@(Theme.IsDarkMode ? "table-secondary text-white" : "table-light text-dark")">
                        <tr>
                            <th>材料品种</th>
                            <th>合同基准日单价 (元/t)</th>
                            <th>当前结算日单价 (元/t)</th>
                            <th>吨钢涨跌差价 (ΔP)</th>
                            <th>涨跌幅 (%)</th>
                            <th>项目调差总金额影响 (ΔCost)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">普碳钢板 Q235B (20mm)</td>
                            <td>¥@BaseSnapshot.PlateBaseQ235B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.PlateBaseQ235B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B >= 0 ? "+" : "")
                                @((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B) / BaseSnapshot.PlateBaseQ235B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold">
                                ¥@(((TargetSnapshot.PlateBaseQ235B - BaseSnapshot.PlateBaseQ235B) * SimulatedProjectTons * 0.4).ToString("N0"))
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">低合金高强板 Q355B (20mm)</td>
                            <td>¥@BaseSnapshot.PlateBaseQ355B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.PlateBaseQ355B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B >= 0 ? "+" : "")
                                @((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B) / BaseSnapshot.PlateBaseQ355B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold text-warning">
                                ¥@(((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B) * SimulatedProjectTons * 0.6).ToString("N0"))
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">热轧H型钢 Q355B</td>
                            <td>¥@BaseSnapshot.HBeamBaseQ355B.ToString("0.##")</td>
                            <td>¥@TargetSnapshot.HBeamBaseQ355B.ToString("0.##")</td>
                            <td class="@(TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B >= 0 ? "+" : "")
                                @((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B).ToString("0.##")) 元/t
                            </td>
                            <td>@(((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B) / BaseSnapshot.HBeamBaseQ355B * 100).ToString("0.2f"))%</td>
                            <td class="fw-bold">
                                ¥@(((TargetSnapshot.HBeamBaseQ355B - BaseSnapshot.HBeamBaseQ355B) * SimulatedProjectTons * 0.3).ToString("N0"))
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- 调差测算结论框 -->
            <div class="p-3 @(Theme.IsDarkMode ? "bg-warning bg-opacity-10 border-warning text-white" : "bg-warning-subtle border-warning-subtle text-dark") border rounded">
                <div class="fw-bold text-warning mb-1">📌 材料价格波动工程调差评估结论</div>
                <div class="small @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                    在 @SimulatedProjectTons 吨工程模拟用量下，由于大盘价格随时间波动，材料采购成本预计变动
                    <b class="text-success fs-6">
                        ¥@(((TargetSnapshot.PlateBaseQ355B - BaseSnapshot.PlateBaseQ355B) * SimulatedProjectTons).ToString("N0"))
                    </b> 元。在锁价冻结模式下，该差价可作为竣工结算索赔及价差补偿签证依据。
                </div>
            </div>
        </div>
    }

    <!-- ======================= 选项卡 4：工程物料出处库与跨时序价格回溯 ======================= -->
    @if (ActiveTab == 4)
    {
        <div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 flex-grow-1">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                <div>
                    <h6 class="fw-bold text-success mb-1 d-flex align-items-center gap-2">
                        <span>📚 工程物料出处记录库与跨时序价格回溯 (Material Provenance & Retrospection)</span>
                        <span class="badge bg-success text-xs">唯一特征指纹存档</span>
                    </h6>
                    <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                        记录每张特定参数钢板的完整特征标签、建档价格出处、询价批次与时间戳。随大盘与时序演进，支持对全项目用钢进行任意快照重算与调差索赔核算。
                    </div>
                </div>

                <!-- 目标回溯价格快照选择器 -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-bold @(Theme.IsDarkMode ? "text-warning" : "text-dark") text-nowrap">目标回溯快照 (Target Date):</span>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-black text-warning border-secondary" : "bg-white text-dark border-secondary-subtle") w-auto"
                            @bind="RetrospectionTargetSnapshotId" @bind:after="RecalculateRetrospection">
                        @foreach (var snap in AllSnapshots)
                        {
                            <option value="@snap.SnapshotId">
                                📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") | @snap.SnapshotName @(snap.IsLocked ? "🔒[锁价基期]" : "")
                            </option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="() => ActiveTab = 1" title="返回钢板核算矩阵配置新规格">
                        <span>➕ 配置新钢板</span>
                    </button>
                </div>
            </div>

            <!-- 加价原则回溯模式控制器 (时序加价原则变更模式) -->
            <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle") d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-bold text-nowrap @(Theme.IsDarkMode ? "text-warning" : "text-primary")">⚖️ 回溯加价原则应用模式:</span>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-black text-info border-secondary" : "bg-white text-dark border-secondary-subtle") w-auto fw-bold"
                            @bind="CurrentPrincipleMode" @bind:after="RecalculateRetrospection">
                        <option value="@RetrospectionPrincipleMode.ContractFixedPrinciples">模式 A：合同锁定加价原则 (锁定建档加价约定，仅大盘基价波动)</option>
                        <option value="@RetrospectionPrincipleMode.TargetDateCurrentPrinciples">模式 B：目标时序现行原则 (厚度/尺寸/运费按目标期最新规则重算)</option>
                        <option value="@RetrospectionPrincipleMode.LatestRevisedOverride">模式 C：最新修订与实付议价 (采用各批次最新修改版本与议价记录)</option>
                    </select>
                </div>
                <div class="small @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                    @if (CurrentPrincipleMode == RetrospectionPrincipleMode.ContractFixedPrinciples)
                    {
                        <span>📌 <b>模式 A (合同锁定)</b>：适用于固定加工费合同。即使钢厂阶梯加价上涨，结算仍沿用合同锁定加价，仅大盘网价波动。</span>
                    }
                    else if (CurrentPrincipleMode == RetrospectionPrincipleMode.TargetDateCurrentPrinciples)
                    {
                        <span>📌 <b>模式 B (现行重算)</b>：适用于全浮动现货合同。各项加价按目标快照时期的最新规则矩阵全要素动态重新核算。</span>
                    }
                    else
                    {
                        <span>📌 <b>模式 C (最新修订)</b>：适用于批次议价合同。以工程师每次修订录入的实付加价与最新协商折扣参与结算。</span>
                    }
                </div>
            </div>

            <!-- 全项目调差与成本聚合看板 -->
            <div class="row g-2 mb-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">归档物料品种数</div>
                        <div class="fs-5 fw-bold text-primary">@ProvenanceRecords.Count <span class="text-xs fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">种独立特征</span></div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">关联工程用钢总量</div>
                        <div class="fs-5 fw-bold text-info">@GetTotalProjectTons().ToString("N1") <span class="text-xs fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">吨 (t)</span></div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">原建档采购基准总额</div>
                        <div class="fs-5 fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">¥ @GetTotalBaseRecordedCost().ToString("N0")</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="p-2 rounded border @(GetTotalCostVariance() >= 0 ? (Theme.IsDarkMode ? "bg-danger bg-opacity-10 border-danger border-opacity-50" : "bg-danger-subtle border-danger-subtle") : (Theme.IsDarkMode ? "bg-success bg-opacity-10 border-success border-opacity-50" : "bg-success-subtle border-success-subtle"))">
                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">项目时序调差差额 (ΔCost)</div>
                        <div class="fs-5 fw-bold @(GetTotalCostVariance() >= 0 ? "text-danger" : "text-success")">
                            @(GetTotalCostVariance() >= 0 ? "+" : "")¥ @GetTotalCostVariance().ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <!-- 物料出处记录与跨时序回溯表格 -->
            <div class="table-responsive flex-grow-1 mb-3">
                <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white shadow-sm border-light-subtle") small align-middle mb-0">
                    <thead class="@(Theme.IsDarkMode ? "table-secondary text-white" : "table-light text-dark")">
                        <tr>
                            <th style="width: 35px;">#</th>
                            <th style="min-width: 190px;">物料唯一指纹 (Tag) & 询价批次</th>
                            <th style="min-width: 140px;">物料名称与工程引用</th>
                            <th style="min-width: 120px;">规格与尺寸</th>
                            <th style="min-width: 105px;">技术与公差</th>
                            <th style="min-width: 130px;">询价时间与渠道商</th>
                            <th style="min-width: 130px;">版本与适用加价依据</th>
                            <th class="text-end" style="min-width: 105px;">出处单价 (建档)</th>
                            <th class="text-end" style="min-width: 110px;">回溯单价 (@RetrospectionTargetSnapshot.EffectiveDate.ToString("MM-dd"))</th>
                            <th class="text-end" style="min-width: 90px;">吨差 (ΔP)</th>
                            <th style="width: 80px;">用量 (t)</th>
                            <th class="text-end" style="min-width: 105px;">调差额 (ΔCost)</th>
                            <th class="text-center" style="min-width: 130px;">操作与审计</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ProvenanceRecords.Count == 0)
                        {
                            <tr>
                                <td colspan="13" class="text-center py-4 @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                                    暂无物料出处记录。请前往【钢板五维加价核算矩阵】配置钢板并点击“📌 登记入库”按钮添加。
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rec in ProvenanceRecords)
                            {
                                var retroPrice = rec.CalculateAtSnapshot(RetrospectionTargetSnapshot, ThicknessLadders, DimensionRules, CurrentPrincipleMode);
                                double deltaP = retroPrice.FinalPricePerTon - rec.FinalPricePerTon;
                                double tons = GetRecordTons(rec.Id);
                                double deltaCost = deltaP * tons;

                                <tr>
                                    <td>@rec.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge @(Theme.IsDarkMode ? "bg-dark text-info border border-secondary" : "bg-light text-primary border") font-monospace text-xs text-truncate" style="max-width: 150px;" title="@rec.MaterialTag">
                                                @rec.MaterialTag
                                            </span>
                                            <button class="btn btn-xs btn-outline-secondary p-0 px-1" @onclick="() => CopyTagText(rec.MaterialTag)" title="复制物料标签">
                                                📋
                                            </button>
                                        </div>
                                        <div class="mt-1 d-flex align-items-center gap-1">
                                            <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-secondary-subtle text-dark border") font-monospace text-xs">
                                                📦 @rec.InquiryBatchId
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">@rec.DisplayTitle</div>
                                        <div class="text-xs text-primary">@rec.ProjectReference</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@rec.DimensionText</div>
                                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">@rec.MillName</div>
                                    </td>
                                    <td>
                                        <div class="badge @(rec.PlateParameters.Tolerance == ToleranceClass.ClassC ? "bg-primary" : "bg-secondary") text-xs">
                                            @(rec.PlateParameters.Tolerance == ToleranceClass.ClassC ? "C类保全厚度" : (rec.PlateParameters.Tolerance == ToleranceClass.ClassB ? "B类公差" : "A类公差"))
                                        </div>
                                        @if (rec.PlateParameters.ZDirection != ZDirectionQuality.None)
                                        {
                                            <span class="badge bg-info text-dark text-xs ms-1">@rec.PlateParameters.ZDirection</span>
                                        }
                                        @if (rec.PlateParameters.UT != UltrasonicInspection.None)
                                        {
                                            <span class="badge bg-warning text-dark text-xs ms-1">@(rec.PlateParameters.UT == UltrasonicInspection.ClassI ? "UT-I" : "UT-II")</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">📅 @rec.InquiryDate.ToString("yyyy-MM-dd")</div>
                                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-truncate" style="max-width: 125px;" title="@rec.InquiryVendor">
                                            @rec.InquiryVendor
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge @(rec.RevisionNumber > 1 ? "bg-success text-white" : "bg-secondary text-white") text-xs">
                                                Rev @rec.RevisionNumber
                                            </span>
                                        </div>
                                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-truncate mt-1" style="max-width: 130px;" title="@rec.PricingPrincipleNote">
                                            @rec.PricingPrincipleNote
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold">¥@rec.FinalPricePerTon.ToString("0.##")</div>
                                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">@rec.EffectiveDate.ToString("yy-MM-dd") 基准</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-primary">¥@retroPrice.FinalPricePerTon.ToString("0.##")</div>
                                        <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">@RetrospectionTargetSnapshot.SnapshotName</div>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge @(deltaP >= 0 ? "bg-danger" : "bg-success")">
                                            @(deltaP >= 0 ? "+" : "")@deltaP.ToString("0.##")
                                        </span>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center py-0 px-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                               value="@tons"
                                               @onchange="(e) => SetRecordTons(rec.Id, e.Value)"
                                               style="width: 70px;" />
                                    </td>
                                    <td class="text-end fw-bold @(deltaCost >= 0 ? "text-danger" : "text-success")">
                                        @(deltaCost >= 0 ? "+" : "")¥@deltaCost.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button class="btn btn-xs btn-outline-warning p-1 px-2" @onclick="() => OpenRevisionModal(rec)" title="修订单价/加价原则，写入过程审计记录">
                                                ✏️ 修订
                                            </button>
                                            <button class="btn btn-xs btn-outline-info p-1 px-2" @onclick="() => OpenAuditModal(rec)" title="查看过程变更审计履历 (@rec.RevisionLogs.Count 次)">
                                                🕒 履历 (@rec.RevisionLogs.Count)
                                            </button>
                                            <button class="btn btn-xs btn-outline-secondary p-1" @onclick="() => CopyTagText(rec.FullDescription)" title="复制完整 Describe 规范">
                                                📋
                                            </button>
                                            <button class="btn btn-xs btn-outline-danger p-1" @onclick="() => RemoveProvenanceRecord(rec.Id)" title="删除此物料记录">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- 底部结论与索赔调差指引 -->
            <div class="p-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle") d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small">
                    <b>💡 工程成本回溯结论:</b>
                    当前基于回溯模式 <span class="badge bg-primary">@(CurrentPrincipleMode == RetrospectionPrincipleMode.ContractFixedPrinciples ? "模式A: 合同锁定" : (CurrentPrincipleMode == RetrospectionPrincipleMode.TargetDateCurrentPrinciples ? "模式B: 现行重算" : "模式C: 最新修订"))</span>，
                    针对目标快照 <span class="text-primary fw-bold">@RetrospectionTargetSnapshot.SnapshotName</span>，
                    全项目 @ProvenanceRecords.Count 种物料构件共计 <span class="fw-bold">@GetTotalProjectTons().ToString("N1")</span> 吨钢，
                    产生的物料总调差额为
                    <b class="@(GetTotalCostVariance() >= 0 ? "text-danger fs-6" : "text-success fs-6")">
                        @(GetTotalCostVariance() >= 0 ? "+" : "")¥ @GetTotalCostVariance().ToString("N0") 元
                    </b>。
                    具备完整的规格、批次、询价时间与加价原则变更全过程审计履历，可直接导出作为工程结算签证附件。
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetRecordTons">
                        ↺ 重置用量
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ======================= 模态框：价格修改与加价原则修订 ======================= -->
    @if (ShowRevisionModal && EditingRecord != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content @(Theme.IsDarkMode ? "bg-dark text-white border-secondary shadow-lg" : "bg-white text-dark shadow-lg")">
                    <div class="modal-header @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">✏️</span>
                            <div>
                                <h6 class="modal-title fw-bold text-primary mb-0">修订钢材价格与加价原则 (生成过程审计记录)</h6>
                                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                                    物料: @EditingRecord.DisplayTitle | 当前版本: Rev @EditingRecord.RevisionNumber ➔ <b class="text-success">Rev @(EditingRecord.RevisionNumber + 1)</b>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close @(Theme.IsDarkMode ? "btn-close-white" : "")" @onclick="CloseRevisionModal"></button>
                    </div>
                    <div class="modal-body">
                        <!-- 批次与特征信息 -->
                        <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-black bg-opacity-40 border-secondary" : "bg-light border-light-subtle")">
                            <div class="d-flex justify-content-between align-items-center mb-1 text-xs">
                                <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">特征标签:</span>
                                <span class="font-monospace text-info">@EditingRecord.MaterialTag</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-xs">
                                <span class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">建档单价:</span>
                                <span>大盘基价 ¥@EditingRecord.BasePricePerTon.ToString("0.##") + 累计加价与运费 = <b class="text-warning">¥@EditingRecord.FinalPricePerTon.ToString("0.##")/t</b></span>
                            </div>
                        </div>

                        <!-- 审计过程核心表单 -->
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">修改责任人 / 工程师 <span class="text-danger">*</span>:</label>
                                <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                       @bind="EditRevisionAuthor" placeholder="如 成本合约部/张工" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">变更原因类别 <span class="text-danger">*</span>:</label>
                                <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                        @bind="EditRevisionReason">
                                    <option value="钢厂加价原则公函调整 (厚度/定尺阶梯变动)">钢厂加价原则公函调整 (厚度/定尺阶梯变动)</option>
                                    <option value="不同询价时间分批重核 (现货浮动与运费让利)">不同询价时间分批重核 (现货浮动与运费让利)</option>
                                    <option value="大宗采购商务二次议价让利">大宗采购商务二次议价让利</option>
                                    <option value="结算审计复核价格调整">结算审计复核价格调整</option>
                                    <option value="第三方造价咨询单位核定">第三方造价咨询单位核定</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small mb-1">询价批次号:</label>
                                <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") font-monospace"
                                       @bind="EditInquiryBatchId" placeholder="如 INQ-20260401-LOT03" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">报价渠道/供应商:</label>
                                <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                       @bind="EditInquiryVendor" placeholder="如 宝武钢贸直销部" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">新加价原则依据 / 公函文号:</label>
                            <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle")"
                                   @bind="EditRevisionPrincipleNote" placeholder="如 2026年4月宝武特厚板加价调整公函第2号" />
                        </div>

                        <!-- 加价项调整区域 -->
                        <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                            <div class="small fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark") mb-2">可调整加价因子与调运费 (元/吨):</div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">板厚加价:</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "") py-0">¥</span>
                                        <input type="number" class="form-control @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                                               @bind="EditThicknessSurcharge" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">实际调运费:</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white-50 border-secondary" : "") py-0">¥</span>
                                        <input type="number" class="form-control @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                                               @bind="EditFreightPerTon" />
                                    </div>
                                </div>
                                <div class="col-md-4">
