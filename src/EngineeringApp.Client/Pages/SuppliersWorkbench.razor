                                    <input type="number" step="10" class="form-control form-control-sm @(EditingSupplier.Category == SupplierCategory.SteelMill ? "fw-bold text-primary" : "") @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
