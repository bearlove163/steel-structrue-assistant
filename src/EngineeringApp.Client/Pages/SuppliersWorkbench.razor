                    <div class="modal-footer py-2 @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-light")">
                        <button class="btn btn-sm btn-secondary" @onclick="() => DeletingSupplier = null">取消</button>
                        <button class="btn btn-sm btn-danger" @onclick="ExecuteDelete">确认删除</button>
                    </div>
                </div>
            </div>
        </div>
