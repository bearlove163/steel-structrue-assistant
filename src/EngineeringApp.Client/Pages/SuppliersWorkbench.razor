@page "/suppliers"
@page "/supplier-database"
@using EngineeringApp.Shared.Models
@using EngineeringApp.Shared.Data
@using EngineeringApp.Client.Services
@inject NavigationManager Nav
@inject ThemeState Theme
@implements IDisposable

<PageTitle>工程供应链与供应商库工作台</PageTitle>

<div class="container-fluid py-2 px-3 workstation-root d-flex flex-column min-vh-100 @(Theme.IsDarkMode ? "bg-dark text-white" : "bg-light text-dark")"
     data-theme="@(Theme.IsDarkMode ? "dark" : "light")">

    <!-- ======================= 顶部导航与控制器 ======================= -->
    <header class="d-flex flex-wrap align-items-center justify-content-between pb-2 mb-3 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white rounded p-2 shadow-sm")">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" @onclick='() => Nav.NavigateTo("/portal")' title="返回统一门户">
                <span>←</span>
                <span>门户中心</span>
            </button>
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">🏢</span>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0 fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">工程供应链与供应商库管理中心</h5>
                        <span class="badge @(Theme.IsDarkMode ? "bg-primary-subtle text-primary border border-primary" : "bg-primary text-white") text-xs">
                            模块4 · 供方资质中心
                        </span>
                        <span class="badge bg-success text-xs">动态品类扩展</span>
                    </div>
                    <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                        贯通制造钢厂 · 现货贸易 · 吊装机械 · 紧固件螺栓 · 特种构件 (拉索/支座/楼承板) · 防腐防火涂料
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <!-- 视图模式切换 -->
            <div class="btn-group btn-group-sm">
                <button class="btn @(CurrentView == ViewMode.Grid ? "btn-primary" : "btn-outline-secondary")" @onclick="() => CurrentView = ViewMode.Grid" title="切换紧凑表格清单视图">
                    📋 网格清单
                </button>
                <button class="btn @(CurrentView == ViewMode.Cards ? "btn-primary" : "btn-outline-secondary")" @onclick="() => CurrentView = ViewMode.Cards" title="切换企业名片磁贴视图">
                    🗂️ 企业名片
                </button>
            </div>

            <!-- 数据操作 -->
            <button class="btn btn-sm btn-success d-flex align-items-center gap-1" @onclick="OpenAddModal" title="新增供应商档案">
                <span>➕</span>
                <span>录入供应商</span>
            </button>
            <button class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" @onclick="OpenExportModal" title="导出 JSON 名录">
                <span>📤</span>
                <span>导出</span>
            </button>
            <button class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1" @onclick="OpenImportModal" title="批量导入 JSON">
                <span>📥</span>
                <span>导入</span>
            </button>
            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetToBenchmarkData" title="恢复行业标杆数据库预设">
                <span>🔄</span>
                <span>重置基准</span>
            </button>

            <!-- 主题切换 -->
            <button class="btn btn-sm @(Theme.IsDarkMode ? "btn-outline-warning" : "btn-outline-dark")" @onclick="Theme.ToggleTheme" title="切换暗黑/亮色主题">
                @(Theme.IsDarkMode ? "☀️" : "🌙")
            </button>
        </div>
    </header>

    <!-- ======================= 顶部统计看板 (6 张核心指标卡片) ======================= -->
    <div class="row g-2 mb-3">
        <!-- 卡片 1: 供应商总库 -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🏢 在册总供方</span>
                    <span class="badge bg-primary">合格率 100%</span>
                </div>
                <div class="h5 fw-bold mb-0 text-primary">@TotalSuppliersCount <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">涵盖全国全产业链</div>
            </div>
        </div>

        <!-- 卡片 2: 钢厂与贸易商 -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🏭 钢厂与贸易</span>
                    <span class="badge bg-info text-dark">主材源头</span>
                </div>
                <div class="h5 fw-bold mb-0 text-info">@(GetCountByCategory(SupplierCategory.SteelMill) + GetCountByCategory(SupplierCategory.SteelTrader)) <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">钢厂 @GetCountByCategory(SupplierCategory.SteelMill) · 贸易 @GetCountByCategory(SupplierCategory.SteelTrader)</div>
            </div>
        </div>

        <!-- 卡片 3: 吊机租赁与施工机械 -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🏗️ 吊装设备机械</span>
                    <span class="badge bg-warning text-dark">台班定额</span>
                </div>
                <div class="h5 fw-bold mb-0 text-warning">@GetCountByCategory(SupplierCategory.CraneRental) <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">平头塔/动臂塔/履带吊</div>
            </div>
        </div>

        <!-- 卡片 4: 紧固件与螺栓 -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🔩 连接紧固件</span>
                    <span class="badge bg-success">高强抗剪</span>
                </div>
                <div class="h5 fw-bold mb-0 text-success">@GetCountByCategory(SupplierCategory.FastenerBolt) <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">10.9S螺栓/地脚锚栓</div>
            </div>
        </div>

        <!-- 卡片 5: 特种构件与材料 (拉索/支座/楼承板) -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🔗 特种构件材料</span>
                    <span class="badge bg-danger">空间大跨</span>
                </div>
                <div class="h5 fw-bold mb-0 text-danger">@GetCountByCategory(SupplierCategory.SpecialtyMaterial) <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">拉索/减隔震/楼承板</div>
            </div>
        </div>

        <!-- 卡片 6: 防腐与防火涂料 -->
        <div class="col-6 col-md-2">
            <div class="card p-2 h-100 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-25 border-secondary" : "bg-white border-light-subtle shadow-sm")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1 d-flex justify-content-between">
                    <span>🎨 防腐防火涂装</span>
                    <span class="badge bg-primary">重防腐认证</span>
                </div>
                <div class="h5 fw-bold mb-0 text-primary">@GetCountByCategory(SupplierCategory.PaintCoating) <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">家</span></div>
                <div class="text-xs text-secondary mt-1">环氧/氟碳/防火涂料</div>
            </div>
        </div>
    </div>

    <!-- ======================= 过滤与筛选控制器 ======================= -->
    <div class="card p-2 mb-3 @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-white border-light-subtle shadow-sm")">
        <!-- 主分类筛选标签 -->
        <div class="d-flex flex-wrap align-items-center gap-1 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
            <span class="text-xs fw-bold @(Theme.IsDarkMode ? "text-white-50" : "text-muted") me-1">品类大类:</span>
            <button class="btn btn-xs @(SelectedCategory == null ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(null)">
                🌐 全部品类 (@TotalSuppliersCount)
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.SteelMill ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.SteelMill)">
                🏭 钢厂制造 (@GetCountByCategory(SupplierCategory.SteelMill))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.SteelTrader ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.SteelTrader)">
                🏪 贸易现货 (@GetCountByCategory(SupplierCategory.SteelTrader))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.CraneRental ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.CraneRental)">
                🏗️ 吊机租赁 (@GetCountByCategory(SupplierCategory.CraneRental))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.FastenerBolt ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.FastenerBolt)">
                🔩 紧固件螺栓 (@GetCountByCategory(SupplierCategory.FastenerBolt))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.SpecialtyMaterial ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.SpecialtyMaterial)">
                🔗 特种构件材料 (@GetCountByCategory(SupplierCategory.SpecialtyMaterial))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.PaintCoating ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.PaintCoating)">
                🎨 防腐防火涂装 (@GetCountByCategory(SupplierCategory.PaintCoating))
            </button>
            <button class="btn btn-xs @(SelectedCategory == SupplierCategory.OtherCustom ? "btn-primary fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                    @onclick="() => SelectCategory(SupplierCategory.OtherCustom)">
                ➕ 自定义品类 (@GetCountByCategory(SupplierCategory.OtherCustom))
            </button>
        </div>

        <!-- 细分子类标签 (根据当前大类动态提取所有现有产品子类，支持点击过滤) -->
        <div class="d-flex flex-wrap align-items-center gap-1 pt-2 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
            <span class="text-xs fw-bold @(Theme.IsDarkMode ? "text-white-50" : "text-muted") me-1">细分产品/子类:</span>
            <button class="btn btn-xs @(SelectedSubCategory == "全部" ? "btn-dark fw-bold" : "btn-outline-secondary")"
                    @onclick='() => SelectSubCategory("全部")'>
                全部子类
            </button>
            @foreach (var subCat in AvailableSubCategories.Take(12))
            {
                <button class="btn btn-xs @(SelectedSubCategory == subCat ? "btn-info text-dark fw-bold" : (Theme.IsDarkMode ? "btn-outline-secondary text-white-50" : "btn-outline-secondary"))"
                        @onclick="() => SelectSubCategory(subCat)">
                    @subCat
                </button>
            }
        </div>

        <!-- 检索与状态组合筛选器 -->
        <div class="row g-2 pt-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-light border-light-subtle")">🔍</span>
                    <input type="text" class="form-control @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white border-light-subtle")"
                           placeholder="输入企业全称、简称代码、联系人、基地城市模糊检索..."
                           @bind="SearchKeyword" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(SearchKeyword))
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => SearchKeyword = string.Empty">✕</button>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-nowrap">合作等级:</span>
                    <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                            @bind="SelectedStatus">
                        <option value="全部">全部合作状态</option>
                        <option value="战略合作">⭐ 战略合作</option>
                        <option value="优先推荐">👍 优先推荐</option>
                        <option value="合格在册">✔️ 合格在册</option>
                        <option value="考察备选">⏳ 考察备选</option>
                        <option value="暂停合作">⛔ 暂停合作</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3 text-end text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                当前筛选匹配: <strong class="text-primary fs-6">@FilteredSuppliers.Count()</strong> 家供应商
            </div>
        </div>
    </div>

    <!-- ======================= 主工作台展示区 (双视窗切换) ======================= -->
    @if (CurrentView == ViewMode.Grid)
    {
        <!-- 视图 1：紧凑工程网格清单 (Table Grid) -->
        <div class="table-responsive rounded border @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle bg-white shadow-sm") flex-grow-1" style="max-height: 600px;">
            <table class="table table-sm table-striped @(Theme.IsDarkMode ? "table-dark table-hover" : "table-hover") align-middle mb-0 text-xs">
                <thead class="@(Theme.IsDarkMode ? "table-secondary table-opacity-25" : "table-light") sticky-top">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 120px;">编号/代码</th>
                        <th style="min-width: 180px;">企业工商全称 (品牌简称)</th>
                        <th style="width: 120px;">大类归属</th>
                        <th style="min-width: 190px;">细分供应产品 / 业务特长</th>
                        <th style="width: 140px;">生产基地 / 辐射区域</th>
                        <th style="width: 150px;">商务对接人 / 电话</th>
                        <th style="width: 90px;" class="text-center">合作状态</th>
                        <th style="min-width: 200px;">资质与业务特征说明</th>
                        <th style="width: 110px;" class="text-center">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredSuppliers.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">
                                📭 没有找到匹配的供应商记录，请尝试调整筛选条件或点击上方「录入供应商」新增档案。
                            </td>
                        </tr>
                    }
                    else
                    {
                        int idx = 1;
                        @foreach (var sup in FilteredSuppliers)
                        {
                            <tr>
                                <td class="text-center @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">@(idx++)</td>
                                <td>
                                    <span class="badge @(Theme.IsDarkMode ? "bg-dark border border-secondary text-light" : "bg-light text-dark border") font-monospace">
                                        @sup.Code
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">@sup.Name</div>
                                    <div class="text-xs text-secondary d-flex align-items-center gap-1">
                                        <span>简称: <strong class="text-primary">@sup.ShortName</strong></span>
                                        @if (sup.Category == SupplierCategory.SteelMill)
                                        {
                                            <span class="badge @(sup.BenchmarkPremiumPerTon > 0 ? "bg-warning text-dark" : (sup.BenchmarkPremiumPerTon < 0 ? "bg-success" : "bg-secondary")) px-1 py-0">
                                                基准溢价: @(sup.BenchmarkPremiumPerTon >= 0 ? "+" : "")@sup.BenchmarkPremiumPerTon 元/t
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetCategoryBadgeClass(sup.Category)">
                                        @GetCategoryName(sup.Category)
                                    </span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 240px;" title="@sup.SubCategory">
                                        @sup.SubCategory
                                    </span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@sup.CityRegion">
                                        📍 @sup.CityRegion
                                    </span>
                                </td>
                                <td>
                                    <div>👤 @sup.ContactPerson</div>
                                    <div class="font-monospace @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">📞 @sup.ContactPhone</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetStatusBadgeClass(sup.CooperationStatus)">
                                        @sup.CooperationStatus
                                    </span>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block @(Theme.IsDarkMode ? "text-white-50" : "text-muted")" style="max-width: 260px;" title="@sup.Remarks">
                                        @sup.Remarks
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-xs btn-outline-primary" @onclick="() => OpenEditModal(sup)" title="编辑档案">
                                            ✏️
                                        </button>
                                        <button class="btn btn-xs btn-outline-danger" @onclick="() => ConfirmDelete(sup)" title="删除供应商">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- 视图 2：企业名片磁贴视图 (Card Grid) -->
        <div class="row g-2 overflow-auto flex-grow-1" style="max-height: 600px;">
            @if (!FilteredSuppliers.Any())
            {
                <div class="col-12 text-center py-5 text-muted">
                    📭 没有找到匹配的供应商企业名片。
                </div>
            }
            else
            {
                @foreach (var sup in FilteredSuppliers)
                {
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card h-100 p-2 position-relative @(Theme.IsDarkMode ? "bg-dark border-secondary text-white" : "bg-white border-light-subtle shadow-sm text-dark")">
                            <!-- 顶部标识条 -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @GetCategoryBadgeClass(sup.Category)">
                                    @GetCategoryName(sup.Category)
                                </span>
                                <span class="badge @GetStatusBadgeClass(sup.CooperationStatus)">
                                    @sup.CooperationStatus
                                </span>
                            </div>

                            <!-- 企业核心信息 -->
                            <h6 class="fw-bold mb-1 text-truncate" title="@sup.Name">@sup.Name</h6>
                            <div class="text-xs text-secondary mb-2 d-flex flex-wrap align-items-center justify-content-between gap-1">
                                <span>简称: <strong class="text-primary">@sup.ShortName</strong></span>
                                <span class="font-monospace text-muted">@sup.Code</span>
                                @if (sup.Category == SupplierCategory.SteelMill)
                                {
                                    <span class="badge @(sup.BenchmarkPremiumPerTon > 0 ? "bg-warning text-dark" : (sup.BenchmarkPremiumPerTon < 0 ? "bg-success" : "bg-secondary")) px-1 py-0">
                                        溢价: @(sup.BenchmarkPremiumPerTon >= 0 ? "+" : "")@sup.BenchmarkPremiumPerTon 元/t
                                    </span>
                                }
                            </div>

                            <!-- 业务与产品标签 -->
                            <div class="p-1 mb-2 rounded @(Theme.IsDarkMode ? "bg-black bg-opacity-25" : "bg-light") text-xs">
                                <div class="text-muted mb-1">主营产品 / 细分子类:</div>
                                <div class="fw-semibold text-truncate" title="@sup.SubCategory">@sup.SubCategory</div>
                            </div>

                            <!-- 联系人与区域 -->
                            <div class="text-xs mb-2">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <span class="text-muted">📍 基地/城市:</span>
                                    <span class="text-truncate" title="@sup.CityRegion">@sup.CityRegion</span>
                                </div>
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <span class="text-muted">👤 对接联系:</span>
                                    <span>@sup.ContactPerson</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">📞 联络电话:</span>
                                    <span class="font-monospace">@sup.ContactPhone</span>
                                </div>
                            </div>

                            <!-- 备注特长 -->
                            <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-truncate mb-2" title="@sup.Remarks">
                                💡 @sup.Remarks
                            </div>

                            <!-- 底部动作条 -->
                            <div class="mt-auto pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle") d-flex justify-content-end gap-1">
                                <button class="btn btn-xs btn-outline-primary" @onclick="() => OpenEditModal(sup)">
                                    ✏️ 编辑
                                </button>
                                <button class="btn btn-xs btn-outline-danger" @onclick="() => ConfirmDelete(sup)">
                                    🗑️ 删除
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }

