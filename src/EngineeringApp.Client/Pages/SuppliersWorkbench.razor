</div>

@code {
    private enum ViewMode { Grid, Cards }
    private ViewMode CurrentView = ViewMode.Grid;

    private SupplierCategory? SelectedCategory = null;
    private string SelectedSubCategory = "全部";
    private string SearchKeyword = "";
    private string SelectedStatus = "全部";

    private bool ShowEditModal = false;
    private bool ShowImportModal = false;
    private bool ShowExportModal = false;

    private string ImportJsonText = "";
    private bool ImportOverwrite = false;
    private string ImportError = "";
    private string ExportJsonText = "";
    private string ValidationErrorMessage = "";

    private SupplierItem EditingSupplier = new();
    private SupplierItem? DeletingSupplier = null;

    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }

    private int TotalSuppliersCount => SupplierDatabase.AllSuppliers.Count;

    private int GetCountByCategory(SupplierCategory cat) =>
        SupplierDatabase.AllSuppliers.Count(s => s.Category == cat);

    private List<string> AvailableSubCategories =>
        SupplierDatabase.GetAllSubCategories(SelectedCategory);

    private IEnumerable<SupplierItem> FilteredSuppliers
    {
        get
        {
            var res = SupplierDatabase.Filter(SelectedCategory, SelectedSubCategory, SearchKeyword);
            if (SelectedStatus != "全部")
            {
                res = res.Where(s => s.CooperationStatus == SelectedStatus);
            }
            return res;
        }
    }

    private void SelectCategory(SupplierCategory? cat)
    {
        SelectedCategory = cat;
        SelectedSubCategory = "全部";
    }

    private void SelectSubCategory(string sub)
    {
        SelectedSubCategory = sub;
    }

    private void OpenAddModal()
    {
        ValidationErrorMessage = "";
        EditingSupplier = new SupplierItem
        {
            Category = SelectedCategory ?? SupplierCategory.FastenerBolt,
            CooperationStatus = "合格在册"
        };
        ShowEditModal = true;
    }

    private void OpenEditModal(SupplierItem item)
    {
        ValidationErrorMessage = "";
        EditingSupplier = new SupplierItem
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            ShortName = item.ShortName,
            Category = item.Category,
            SubCategory = item.SubCategory,
            ContactPerson = item.ContactPerson,
            ContactPhone = item.ContactPhone,
            Email = item.Email,
            CityRegion = item.CityRegion,
            CooperationStatus = item.CooperationStatus,
            Remarks = item.Remarks,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        ShowEditModal = true;
    }

    private void AppendSubCategory(string tag)
    {
        if (string.IsNullOrWhiteSpace(EditingSupplier.SubCategory))
        {
            EditingSupplier.SubCategory = tag;
        }
        else if (!EditingSupplier.SubCategory.Contains(tag))
        {
            EditingSupplier.SubCategory += " / " + tag;
        }
    }

    private void SaveEditingSupplier()
    {
        if (string.IsNullOrWhiteSpace(EditingSupplier.Name))
        {
            ValidationErrorMessage = "企业法定全称不能为空。";
            return;
        }

        if (EditingSupplier.Id == 0)
        {
            SupplierDatabase.AddSupplier(EditingSupplier);
        }
        else
        {
            SupplierDatabase.UpdateSupplier(EditingSupplier);
        }

        ShowEditModal = false;
    }

    private void ConfirmDelete(SupplierItem item)
    {
        DeletingSupplier = item;
    }

    private void ExecuteDelete()
    {
        if (DeletingSupplier != null)
        {
            SupplierDatabase.RemoveSupplier(DeletingSupplier.Id);
            DeletingSupplier = null;
        }
    }

    private void OpenExportModal()
    {
        ExportJsonText = SupplierDatabase.ExportToJson();
        ShowExportModal = true;
    }

    private void OpenImportModal()
    {
        ImportJsonText = "";
        ImportError = "";
        ImportOverwrite = false;
        ShowImportModal = true;
    }

    private void ExecuteImport()
    {
        if (string.IsNullOrWhiteSpace(ImportJsonText))
        {
            ImportError = "请先粘贴 JSON 内容。";
            return;
        }

        var success = SupplierDatabase.ImportFromJson(ImportJsonText, ImportOverwrite);
        if (success)
        {
            ShowImportModal = false;
        }
        else
        {
            ImportError = "JSON 格式解析失败，请检查数据结构是否符合规范。";
        }
    }

    private void ResetToBenchmarkData()
    {
        SupplierDatabase.ResetToDefaults();
    }

    private string GetCategoryName(SupplierCategory cat) => cat switch
    {
        SupplierCategory.SteelMill => "钢厂制造",
        SupplierCategory.SteelTrader => "贸易现货",
        SupplierCategory.CraneRental => "吊机租赁",
        SupplierCategory.FastenerBolt => "紧固件螺栓",
        SupplierCategory.SpecialtyMaterial => "特种构件材料",
        SupplierCategory.PaintCoating => "防腐防火涂料",
        SupplierCategory.OtherCustom => "自定义品类",
        _ => "其他"
    };

    private string GetCategoryBadgeClass(SupplierCategory cat) => cat switch
    {
        SupplierCategory.SteelMill => "bg-primary",
        SupplierCategory.SteelTrader => "bg-info text-dark",
        SupplierCategory.CraneRental => "bg-warning text-dark",
        SupplierCategory.FastenerBolt => "bg-success",
        SupplierCategory.SpecialtyMaterial => "bg-danger",
        SupplierCategory.PaintCoating => "bg-primary bg-opacity-75",
        SupplierCategory.OtherCustom => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "战略合作" => "bg-warning text-dark border border-warning",
        "优先推荐" => "bg-success",
        "合格在册" => "bg-primary",
        "考察备选" => "bg-secondary",
        "暂停合作" => "bg-danger",
        _ => "bg-secondary"
    };
}
