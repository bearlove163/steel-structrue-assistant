                            <div class="fw-bold">@DeletingSupplier.Name (@DeletingSupplier.ShortName)</div>
                            <div class="text-muted">代码: @DeletingSupplier.Code | 分类: @GetCategoryName(DeletingSupplier.Category)</div>
