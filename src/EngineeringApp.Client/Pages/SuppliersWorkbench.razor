    <!-- ======================= 模态弹窗 3：JSON 导出面板 ======================= -->
    @if (ShowExportModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;">
