@using EngineeringApp.Shared.Data
@using EngineeringApp.Shared.Models

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary py-3">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <span class="badge bg-primary">GB/T</span>
                        <span>中国国家标准型钢截面规格库</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body p-3">
                    <!-- 筛选与搜索工具条 -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary text-white">🔍 搜索型号</span>
                                <input type="text" class="form-control bg-dark text-white border-secondary"
                                       placeholder="输入型号，如 HW 300, 20a, L 100..."
                                       @bind="SearchText" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="d-flex flex-wrap gap-1">
                                <button class="btn btn-sm @(SelectedCategory == null ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => SelectedCategory = null">全部类型</button>
                                @foreach (var cat in StandardSteelDatabase.Categories)
                                {
                                    <button class="btn btn-sm @(SelectedCategory == cat ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick="() => SelectedCategory = cat">@cat.Replace("GB/T ", "").Replace(" 普通", "")</button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 型号列表表格 -->
                    <div class="table-responsive rounded border border-secondary" style="max-height: 480px;">
                        <table class="table table-dark table-hover table-striped table-sm align-middle mb-0 font-monospace text-xs">
                            <thead class="table-dark sticky-top border-bottom border-secondary">
                                <tr>
                                    <th>型号代号</th>
                                    <th>类别</th>
                                    <th>高 h (mm)</th>
                                    <th>宽 b (mm)</th>
                                    <th>腹板 tw (mm)</th>
                                    <th>翼缘 tf (mm)</th>
                                    <th>面积 A (cm²)</th>
                                    <th>理论重量 (kg/m)</th>
                                    <th>Ix (cm⁴)</th>
                                    <th>Iy (cm⁴)</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr>
                                        <td class="fw-bold text-info">@item.Designation</td>
                                        <td class="text-white-50">@item.Category</td>
                                        <td>@item.Height</td>
                                        <td>@item.Width</td>
                                        <td>@item.WebThickness</td>
                                        <td>@item.FlangeThickness</td>
                                        <td>@item.StandardAreaCm2.ToString("F1")</td>
                                        <td>@item.StandardMassKgM.ToString("F1")</td>
                                        <td>@item.StandardIxCm4.ToString("F0")</td>
                                        <td>@item.StandardIyCm4.ToString("F0")</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm py-0 px-2 text-nowrap"
                                                    @onclick="() => SelectItem(item)">
                                                选择应用
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!FilteredItems.Any())
                                {
                                    <tr>
                                        <td colspan="11" class="text-center py-4 text-white-50">
                                            未找到匹配的型钢型号，请调整搜索关键词。
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer border-secondary py-2 justify-content-between">
                    <span class="text-white-50 text-xs">共匹配到 @FilteredItems.Count() 种标准型钢规格</span>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">关闭</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<StandardSteelItem> OnSelectProfile { get; set; }

    private string SearchText { get; set; } = "";
    private string? SelectedCategory { get; set; }

    private IEnumerable<StandardSteelItem> FilteredItems
    {
        get
        {
            var query = StandardSteelDatabase.AllItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                query = query.Where(x => x.Category == SelectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                query = query.Where(x => x.Designation.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                                         x.Category.Contains(SearchText, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private async Task SelectItem(StandardSteelItem item)
    {
        await OnSelectProfile.InvokeAsync(item);
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
