@using EngineeringApp.Shared.Models
@using EngineeringApp.Shared.Algorithms

<div class="cad-viewport-container position-relative w-100 h-100 d-flex flex-column rounded border shadow-sm overflow-hidden @(IsDarkMode ? "bg-dark border-secondary text-white" : "bg-white border-light-subtle text-dark")">
    <!-- SVG 画布区域 (第三块：图形) -->
    <div class="flex-grow-1 position-relative d-flex align-items-center justify-content-center p-2" style="min-height: @MinHeight; background-color: @CanvasBgColor;">
        @if (Result != null && (Result.OuterContour.Count > 0 || Result.IsCircular || Parameters?.Type == SectionType.Plate))
        {
            @if (Parameters?.Type == SectionType.Plate)
            {
                double t_mm = Math.Max(1.0, Result.TotalHeight);
                double b_mm = Math.Max(100.0, Result.TotalWidth);
                double plateW = 380.0;
                double plateX = 70.0;
                double centerY = 112.0;
                double h_px = Math.Clamp(18.0 + (t_mm - 6.0) * 0.45, 18.0, 42.0);
                double plateTopY = centerY - h_px / 2.0;
                double plateBotY = centerY + h_px / 2.0;
                double coatingThk = 7.0;
                double dimRightX = plateX + plateW + 36.0;
                double dimBottomY = plateBotY + 44.0;
                string plateBadgeFill = IsDarkMode ? "#0f172a" : "#f1f5f9";
                string plateBadgeStroke = IsDarkMode ? "#334155" : "#cbd5e1";
                string plateTitleColor = IsDarkMode ? "#38bdf8" : "#0284c7";
                string plateMetricsColor = IsDarkMode ? "#e2e8f0" : "#334155";
                string plateSteelTextColor = IsDarkMode ? "#f8fafc" : "#0f172a";

                <svg viewBox="0 0 580 230" class="w-100 h-100" style="max-height: @MaxSvgHeight; user-select: none;">
                    <defs>
                        <!-- 尺寸箭头标记 -->
                        <marker id="plate-arrow-start" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="@DimensionColor" />
                        </marker>
                        <marker id="plate-arrow-end" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="@DimensionColor" />
                        </marker>
                        <!-- 钢板金属质感渐变 -->
                        <linearGradient id="plateSteelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="@(IsDarkMode ? "#334155" : "#cbd5e1")" />
                            <stop offset="50%" stop-color="@(IsDarkMode ? "#1e293b" : "#94a3b8")" />
                            <stop offset="100%" stop-color="@(IsDarkMode ? "#334155" : "#cbd5e1")" />
                        </linearGradient>
                        <!-- 防腐涂层绿色渐变 -->
                        <linearGradient id="plateCoatingGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#10b981" />
                            <stop offset="50%" stop-color="#34d399" />
                            <stop offset="100%" stop-color="#10b981" />
                        </linearGradient>
                        <!-- 免喷涂斜纹图案 -->
                        <pattern id="plateHatchStripes" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
                            <line x1="0" y1="0" x2="0" y2="8" stroke="#f97316" stroke-width="3" />
                        </pattern>
                        <!-- 工程网格图案 -->
                        @if (ShowGrid)
                        {
                            <pattern id="plate-grid-pattern" width="25" height="25" patternUnits="userSpaceOnUse">
                                <path d="M 25 0 L 0 0 0 25" fill="none" stroke="@GridLineColor" stroke-width="0.8" />
                            </pattern>
                        }
                    </defs>

                    <!-- 画布底板背景 -->
                    <rect x="0" y="0" width="580" height="230" fill="@CanvasBgColor" />
                    @if (ShowGrid)
                    {
                        <rect x="0" y="0" width="580" height="230" fill="url(#plate-grid-pattern)" />
                    }

                    <!-- 顶部左侧规范铭牌 -->
                    <rect x="16" y="10" width="168" height="22" rx="4" fill="@plateBadgeFill" stroke="@plateBadgeStroke" stroke-width="1" />
                    @((MarkupString)$"<text x=\"24\" y=\"25\" fill=\"{plateTitleColor}\" font-size=\"11\" font-weight=\"bold\">🇨🇳 GB/T 709 钢板断面模型</text>")

                    <!-- 顶部右侧物性胶囊 -->
                    <rect x="345" y="10" width="220" height="22" rx="4" fill="@plateBadgeFill" stroke="@plateBadgeStroke" stroke-width="1" />
                    @((MarkupString)$"<text x=\"353\" y=\"25\" fill=\"{plateMetricsColor}\" font-size=\"10.5\">米重: <tspan fill=\"#f59e0b\" font-weight=\"bold\">{Result.LinearMass:F1}kg</tspan> | 比表面积: <tspan fill=\"#ef4444\" font-weight=\"bold\">{(254.78 / t_mm):F1}m²/t</tspan></text>")

                    <!-- 1. 钢板基体剖面 -->
                    <rect x="@plateX" y="@plateTopY" width="@plateW" height="@h_px" rx="2"
                          fill="url(#plateSteelGrad)" stroke="@(IsDarkMode ? "#64748b" : "#475569")" stroke-width="1.6" />
                    
                    <!-- 钢板截面中心标记与钢材等级说明 -->
                    @((MarkupString)$"<text x=\"{(plateX + plateW / 2.0):F1}\" y=\"{(centerY + 3.5):F1}\" fill=\"{plateSteelTextColor}\" font-size=\"11.5\" font-weight=\"bold\" text-anchor=\"middle\" letter-spacing=\"0.5\">钢板基体 (Q355B · t = {t_mm:0.##} mm)</text>")

                    @if (ShowCoatings)
                    {
                        <!-- 2. 上表面涂层/免喷涂层析 -->
                        @if (HighlightTopSurface)
                        {
                            <!-- 上表面：贴合免喷涂区 (橙色警示斜纹) -->
                            <rect x="@plateX" y="@(plateTopY - coatingThk)" width="@plateW" height="@coatingThk"
                                  fill="url(#plateHatchStripes)" stroke="#f97316" stroke-width="1.2" />
                            <!-- 上表面免喷标志引线与胶囊 -->
                            <line x1="@(plateX + plateW * 0.5)" y1="@(plateTopY - coatingThk)" x2="@(plateX + plateW * 0.5)" y2="@(plateTopY - 24)"
                                  stroke="#f97316" stroke-width="1.2" stroke-dasharray="3,2" />
                            <rect x="@(plateX + plateW * 0.5 - 120)" y="@(plateTopY - 42)" width="240" height="20" rx="4"
                                  fill="@(IsDarkMode ? "#1c1917" : "#fff7ed")" stroke="#f97316" stroke-width="1.2" />
                            @((MarkupString)$"<text x=\"{(plateX + plateW * 0.5):F1}\" y=\"{(plateTopY - 28):F1}\" fill=\"#f97316\" font-size=\"10.5\" font-weight=\"bold\" text-anchor=\"middle\">⊘ 上表面免喷涂区 · 楼板紧密贴合扣除 (0.00 m²/m)</text>")
                        }
                        else
                        {
                            <!-- 上表面：正常有效涂装层 (绿色高亮) -->
                            <rect x="@plateX" y="@(plateTopY - coatingThk)" width="@plateW" height="@coatingThk" rx="1"
                                  fill="url(#plateCoatingGrad)" stroke="#10b981" stroke-width="1.2" />
                            <!-- 涂层示意引线与胶囊 -->
                            <line x1="@(plateX + plateW * 0.5)" y1="@(plateTopY - coatingThk)" x2="@(plateX + plateW * 0.5)" y2="@(plateTopY - 24)"
                                  stroke="#10b981" stroke-width="1.2" stroke-dasharray="3,2" />
                            <rect x="@(plateX + plateW * 0.5 - 110)" y="@(plateTopY - 42)" width="220" height="20" rx="4"
                                  fill="@(IsDarkMode ? "#022c22" : "#f0fdf4")" stroke="#10b981" stroke-width="1.2" />
                            @((MarkupString)$"<text x=\"{(plateX + plateW * 0.5):F1}\" y=\"{(plateTopY - 28):F1}\" fill=\"#10b981\" font-size=\"10.5\" font-weight=\"bold\" text-anchor=\"middle\">↑ 上表面防腐涂装层 (有效喷涂 1.00 m²/m)</text>")
                        }

                        <!-- 3. 下表面涂层 (标准有效涂装层，绿色高亮) -->
                        <rect x="@plateX" y="@plateBotY" width="@plateW" height="@coatingThk" rx="1"
                              fill="url(#plateCoatingGrad)" stroke="#10b981" stroke-width="1.2" />
                        <!-- 下表面涂层引线与胶囊 -->
                        <line x1="@(plateX + plateW * 0.5)" y1="@(plateBotY + coatingThk)" x2="@(plateX + plateW * 0.5)" y2="@(plateBotY + 20)"
                              stroke="#10b981" stroke-width="1.2" stroke-dasharray="3,2" />
                        <rect x="@(plateX + plateW * 0.5 - 110)" y="@(plateBotY + 18)" width="220" height="20" rx="4"
                              fill="@(IsDarkMode ? "#022c22" : "#f0fdf4")" stroke="#10b981" stroke-width="1.2" />
                        @((MarkupString)$"<text x=\"{(plateX + plateW * 0.5):F1}\" y=\"{(plateBotY + 32):F1}\" fill=\"#10b981\" font-size=\"10.5\" font-weight=\"bold\" text-anchor=\"middle\">↓ 下表面防腐涂装层 (有效喷涂 1.00 m²/m)</text>")
                    }

                    <!-- 4. CAD 尺寸标注 -->
                    @if (ShowDimensions)
                    {
                        <!-- 标称计算板宽 B (水平尺寸线) -->
                        <line x1="@plateX" y1="@dimBottomY" x2="@(plateX + plateW)" y2="@dimBottomY"
                              stroke="@DimensionColor" stroke-width="1.2" marker-start="url(#plate-arrow-start)" marker-end="url(#plate-arrow-end)" />
                        <!-- 尺寸界线 (竖向细虚线) -->
                        <line x1="@plateX" y1="@plateBotY" x2="@plateX" y2="@(dimBottomY + 5)"
                              stroke="@DimensionColor" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="2,2" />
                        <line x1="@(plateX + plateW)" y1="@plateBotY" x2="@(plateX + plateW)" y2="@(dimBottomY + 5)"
                              stroke="@DimensionColor" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="2,2" />
                        <!-- 板宽数值胶囊 -->
                        <rect x="@(plateX + plateW * 0.5 - 90)" y="@(dimBottomY - 9)" width="180" height="18" rx="3"
                              fill="@CanvasBgColor" fill-opacity="0.95" stroke="@DimensionColor" stroke-width="0.8" />
                        @((MarkupString)$"<text x=\"{(plateX + plateW * 0.5):F1}\" y=\"{(dimBottomY + 3.5):F1}\" fill=\"{DimensionTextColor}\" font-size=\"10.5\" font-weight=\"bold\" text-anchor=\"middle\">标称板宽 B = {b_mm:F0} mm (计算单元)</text>")

                        <!-- 板厚 t 标注 (右侧竖向尺寸线) -->
                        <line x1="@dimRightX" y1="@plateTopY" x2="@dimRightX" y2="@plateBotY"
                              stroke="@DimensionColor" stroke-width="1.2" marker-start="url(#plate-arrow-start)" marker-end="url(#plate-arrow-end)" />
                        <!-- 尺寸界线 (横向细虚线) -->
                        <line x1="@(plateX + plateW)" y1="@plateTopY" x2="@(dimRightX + 5)" y2="@plateTopY"
                              stroke="@DimensionColor" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="2,2" />
                        <line x1="@(plateX + plateW)" y1="@plateBotY" x2="@(dimRightX + 5)" y2="@plateBotY"
                              stroke="@DimensionColor" stroke-opacity="0.5" stroke-width="0.8" stroke-dasharray="2,2" />
                        <!-- 板厚数值胶囊 -->
                        <rect x="@(dimRightX + 6)" y="@(centerY - 9)" width="82" height="18" rx="3"
                              fill="@CanvasBgColor" fill-opacity="0.95" stroke="@DimensionColor" stroke-width="0.8" />
                        @((MarkupString)$"<text x=\"{(dimRightX + 10):F1}\" y=\"{(centerY + 3.5):F1}\" fill=\"{DimensionTextColor}\" font-size=\"10.5\" font-weight=\"bold\">t = {t_mm:0.##} mm</text>")
                    }
                </svg>
            }
            else
            {
                <!-- ================= 标准型钢与任意多边形力学截面矢量图 ================= -->
                <svg viewBox="@SvgViewBox" class="w-100 h-100" style="max-height: @MaxSvgHeight; user-select: none;">
                    <defs>
                        <!-- 尺寸箭头标记 -->
                        <marker id="arrow-start" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="@DimensionColor" />
                        </marker>
                        <marker id="arrow-end" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="@DimensionColor" />
                        </marker>
                        <!-- 背景工程网格图案 -->
                        @if (ShowGrid)
                        {
                            <pattern id="grid-pattern" width="@GridSpacing" height="@GridSpacing" patternUnits="userSpaceOnUse">
                                <path d="M @GridSpacing 0 L 0 0 0 @GridSpacing" fill="none" stroke="@GridLineColor" stroke-width="@(StrokeWidth * 0.5)" />
                            </pattern>
                        }
                    </defs>

                    <!-- 画布底板背景 -->
                    <rect x="@BoxMinX" y="@BoxMinY" width="@BoxWidth" height="@BoxHeight" fill="@CanvasBgColor" />

                    <!-- 网格背景 -->
                    @if (ShowGrid)
                    {
                        <rect x="@BoxMinX" y="@BoxMinY" width="@BoxWidth" height="@BoxHeight" fill="url(#grid-pattern)" />
                    }

                    <!-- 截面主体轮廓填充 -->
                    @if (Result.IsCircular)
                    {
                        <!-- 圆形 / 空心圆管 -->
                        <circle cx="@ToSvgX(Result.Yc)" cy="@ToSvgY(Result.Zc)" r="@Result.CircleOuterRadius"
                                fill="@SectionFillColor" stroke="@SectionStrokeColor" stroke-width="@(StrokeWidth * 1.5)" />
                        @if (Result.CircleInnerRadius > 0)
                        {
                            <circle cx="@ToSvgX(Result.Yc)" cy="@ToSvgY(Result.Zc)" r="@Result.CircleInnerRadius"
                                    fill="@CanvasBgColor" stroke="@SectionStrokeColor" stroke-width="@StrokeWidth" />
                        }
                    }
                    else
                    {
                        <!-- 任意多边形 / 复合截面 -->
                        <path d="@GetSvgPolygonPath(Result.OuterContour, Result.InnerContours)"
                              fill="@SectionFillColor" fill-rule="evenodd" stroke="@SectionStrokeColor" stroke-width="@(StrokeWidth * 1.5)" />
                    }

                    <!-- 楼板贴合免涂装面指示标线 -->
                    @if (HighlightTopSurface && Result.TopSurfaceWidth > 0)
                    {
                        double topZ = Result.Zmax;
                        double topY1 = Result.Yc - Result.TopSurfaceWidth / 2.0;
                        double topY2 = Result.Yc + Result.TopSurfaceWidth / 2.0;
                        <line x1="@ToSvgX(topY1)" y1="@ToSvgY(topZ)" x2="@ToSvgX(topY2)" y2="@ToSvgY(topZ)"
                              stroke="#f97316" stroke-width="@(StrokeWidth * 3.5)" stroke-dasharray="@(StrokeWidth * 4),@(StrokeWidth * 2)" />
                        double slabLabelZ = topZ + FontSize * 1.5;
                        string slabText = $"楼板贴合免喷区 ({Result.TopSurfaceWidth:F0}mm)";
                        double slabFontSize = FontSize * 0.85;
                        double slabW = GetTextWidthApprox(slabText, slabFontSize);
                        double slabPad = FontSize * 0.3;
                        <rect x="@(ToSvgX(Result.Yc) - slabW / 2.0 - slabPad)" y="@(ToSvgY(slabLabelZ) - slabFontSize * 0.7)"
                              width="@(slabW + slabPad * 2.0)" height="@(slabFontSize * 1.4)" fill="@CanvasBgColor" fill-opacity="0.95" stroke="#f97316" stroke-width="@(StrokeWidth * 0.8)" rx="@(FontSize * 0.2)" />
                        @((MarkupString)$"<text x=\"{ToSvgX(Result.Yc):F1}\" y=\"{ToSvgY(slabLabelZ):F1}\" fill=\"#f97316\" font-size=\"{slabFontSize:F1}\" font-weight=\"bold\" text-anchor=\"middle\" dominant-baseline=\"middle\">{slabText}</text>")
                    }

                <!-- 应力云图点集展示 (当开启且存在应力计算) -->
                @if (ShowStressMap && Result.StressResult != null && Result.StressResult.StressSamplePoints.Count > 0)
                {
                    @foreach (var pt in Result.StressResult.StressSamplePoints)
                    {
                        if (IsPointInsideSection(pt.Y, pt.Z))
                        {
                            <circle cx="@ToSvgX(pt.Y)" cy="@ToSvgY(pt.Z)" r="@(StrokeWidth * 1.6)"
                                    fill="@GetStressColor(pt.Stress)" opacity="0.8" />
                        }
                    }
                }

                <!-- 中和轴 (Neutral Axis) -->
                @if (ShowStressMap && Result.StressResult?.NeutralAxisPoint1 != null && Result.StressResult?.NeutralAxisPoint2 != null)
                {
                    var na1 = Result.StressResult.NeutralAxisPoint1;
                    var na2 = Result.StressResult.NeutralAxisPoint2;
                    <line x1="@ToSvgX(na1.Y)" y1="@ToSvgY(na1.Z)" x2="@ToSvgX(na2.Y)" y2="@ToSvgY(na2.Z)"
                          stroke="@NeutralAxisColor" stroke-width="@(StrokeWidth * 2)" stroke-dasharray="@(StrokeWidth * 4),@(StrokeWidth * 2.5)" />
                    
                    // 选取中和轴靠左上方的端点进行标注，彻底避免与右侧高度标注及底部宽度标注冲突
                    var naLabelPt = na1.Z >= na2.Z ? na1 : na2;
                    double naFontSize = FontSize * 0.85;
                    double naTx = ToSvgX(naLabelPt.Y - FontSize * 0.6);
                    double naTy = ToSvgY(naLabelPt.Z + FontSize * 0.6);
                    string naText = "中和轴 (N.A.)";
                    double naW = GetTextWidthApprox(naText, naFontSize);
                    double naPad = FontSize * 0.25;
                    <rect x="@(naTx - naW - naPad * 2)" y="@(naTy - naFontSize * 0.7)" width="@(naW + naPad * 2)" height="@(naFontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@NeutralAxisColor" stroke-width="@(StrokeWidth * 0.8)" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{(naTx - naPad):F1}\" y=\"{naTy:F1}\" fill=\"{NeutralAxisColor}\" font-size=\"{naFontSize:F1}\" font-weight=\"bold\" text-anchor=\"end\" dominant-baseline=\"middle\">{naText}</text>")
                }

                <!-- 形心标记与主轴 -->
                @if (ShowAxes)
                {
                    double cx = ToSvgX(Result.Yc);
                    double cy = ToSvgY(Result.Zc);
                    double dRef = Math.Max(Result.TotalWidth, Result.TotalHeight);
                    double crossArm = Math.Max(0.5, dRef * 0.055);

                    <!-- 水平与竖向参考形心轴 (参考虚线) -->
                    <line x1="@BoxMinX" y1="@cy" x2="@(BoxMinX + BoxWidth)" y2="@cy"
                          stroke="@RefAxisColor" stroke-width="@(StrokeWidth * 0.8)" stroke-dasharray="@(StrokeWidth * 3),@(StrokeWidth * 3)" />
                    <line x1="@cx" y1="@BoxMinY" x2="@cx" y2="@(BoxMinY + BoxHeight)"
                          stroke="@RefAxisColor" stroke-width="@(StrokeWidth * 0.8)" stroke-dasharray="@(StrokeWidth * 3),@(StrokeWidth * 3)" />

                    <!-- 第一主惯性轴 1-1 -->
                    var p1Start = RotateOffset(Result.Yc, Result.Zc, -AxisLength, Result.PrincipalAngleDeg);
                    var p1End = RotateOffset(Result.Yc, Result.Zc, AxisLength, Result.PrincipalAngleDeg);
                    <line x1="@ToSvgX(p1Start.Y)" y1="@ToSvgY(p1Start.Z)" x2="@ToSvgX(p1End.Y)" y2="@ToSvgY(p1End.Z)"
                          stroke="@Axis1Color" stroke-width="@(StrokeWidth * 1.4)" stroke-dasharray="@(StrokeWidth * 5),@(StrokeWidth * 3)" />
                    
                    string axis1Text = $"1-1 (α={Result.PrincipalAngleDeg:F1}°)";
                    double a1FontSize = FontSize * 0.82;
                    double a1W = GetTextWidthApprox(axis1Text, a1FontSize);
                    double a1Pad = FontSize * 0.25;
                    double a1Tx = ToSvgX(p1End.Y) + FontSize * 0.3;
                    double a1Ty = ToSvgY(p1End.Z);
                    <rect x="@a1Tx" y="@(a1Ty - a1FontSize * 0.7)" width="@(a1W + a1Pad * 2)" height="@(a1FontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@Axis1Color" stroke-width="@(StrokeWidth * 0.8)" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{(a1Tx + a1Pad):F1}\" y=\"{a1Ty:F1}\" fill=\"{Axis1Color}\" font-size=\"{a1FontSize:F1}\" font-weight=\"bold\" dominant-baseline=\"middle\">{axis1Text}</text>")

                    <!-- 第二主惯性轴 2-2 -->
                    var p2Start = RotateOffset(Result.Yc, Result.Zc, -AxisLength, Result.PrincipalAngleDeg + 90);
                    var p2End = RotateOffset(Result.Yc, Result.Zc, AxisLength, Result.PrincipalAngleDeg + 90);
                    <line x1="@ToSvgX(p2Start.Y)" y1="@ToSvgY(p2Start.Z)" x2="@ToSvgX(p2End.Y)" y2="@ToSvgY(p2End.Z)"
                          stroke="@Axis2Color" stroke-width="@(StrokeWidth * 1.4)" stroke-dasharray="@(StrokeWidth * 5),@(StrokeWidth * 3)" />
                    
                    string axis2Text = "2-2";
                    double a2FontSize = FontSize * 0.82;
                    double a2W = GetTextWidthApprox(axis2Text, a2FontSize);
                    double a2Pad = FontSize * 0.25;
                    double a2Tx = ToSvgX(p2End.Y);
                    double a2Ty = ToSvgY(p2End.Z + FontSize * 0.7);
                    <rect x="@(a2Tx - a2W / 2.0 - a2Pad)" y="@(a2Ty - a2FontSize * 0.7)" width="@(a2W + a2Pad * 2)" height="@(a2FontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@Axis2Color" stroke-width="@(StrokeWidth * 0.8)" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{a2Tx:F1}\" y=\"{a2Ty:F1}\" fill=\"{Axis2Color}\" font-size=\"{a2FontSize:F1}\" font-weight=\"bold\" text-anchor=\"middle\" dominant-baseline=\"middle\">{axis2Text}</text>")

                    <!-- 形心十字标与坐标 -->
                    <circle cx="@cx" cy="@cy" r="@(StrokeWidth * 2.2)" fill="@CentroidColor" stroke="#ffffff" stroke-width="@(StrokeWidth * 0.8)" />
                    <line x1="@(cx - crossArm)" y1="@cy" x2="@(cx + crossArm)" y2="@cy" stroke="@CentroidColor" stroke-width="@(StrokeWidth * 1.3)" />
                    <line x1="@cx" y1="@(cy - crossArm)" x2="@cx" y2="@(cy + crossArm)" stroke="@CentroidColor" stroke-width="@(StrokeWidth * 1.3)" />
                    
                    string cText = $"C ({Result.Yc:F1}, {Result.Zc:F1})";
                    double cFontSize = FontSize * 0.82;
                    double cW = GetTextWidthApprox(cText, cFontSize);
                    double cPad = FontSize * 0.25;

                    // 智能形心坐标避让判定：
                    // 若形心右侧至截面边缘的净空能够容纳坐标文字，则置于右上；若右侧过窄，则自动翻转至左侧，防止压盖右侧高度标注
                    bool placeCentroidRight = (Result.Ymax - Result.Yc) >= (cW + crossArm + FontSize * 0.3);
                    double cRectX = placeCentroidRight
                        ? (cx + crossArm + FontSize * 0.25)
                        : (cx - crossArm - cW - cPad * 2.0 - FontSize * 0.25);
                    double cRectY = cy - cFontSize * 0.7;
                    double cTextX = cRectX + cPad;
                    double cTextY = cy;

                    <rect x="@cRectX" y="@cRectY" width="@(cW + cPad * 2.0)" height="@(cFontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@CentroidColor" stroke-width="@(StrokeWidth * 0.8)" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{cTextX:F1}\" y=\"{cTextY:F1}\" fill=\"{CentroidColor}\" font-size=\"{cFontSize:F1}\" font-weight=\"bold\" dominant-baseline=\"middle\">{cText}</text>")
                }

                <!-- 尺寸标注线 (防碰撞 CAD 规范布局) -->
                @if (ShowDimensions)
                {
                    double w = Result.TotalWidth;
                    double h = Result.TotalHeight;
                    double dRef = Math.Max(w, h);
                    double dimOffset = dRef * 0.15;

                    <!-- 宽度标注 (底部，带底色胶囊保护) -->
                    double dimZBottom = Result.Zmin - dimOffset;
                    <line x1="@ToSvgX(Result.Ymin)" y1="@ToSvgY(dimZBottom)" x2="@ToSvgX(Result.Ymax)" y2="@ToSvgY(dimZBottom)"
                          stroke="@DimensionColor" stroke-width="@StrokeWidth" marker-start="url(#arrow-start)" marker-end="url(#arrow-end)" />
                    <line x1="@ToSvgX(Result.Ymin)" y1="@ToSvgY(Result.Zmin)" x2="@ToSvgX(Result.Ymin)" y2="@ToSvgY(dimZBottom - FontSize * 0.35)"
                          stroke="@DimensionColor" stroke-opacity="0.4" stroke-width="@(StrokeWidth * 0.6)" stroke-dasharray="@(StrokeWidth * 2),@(StrokeWidth * 2)" />
                    <line x1="@ToSvgX(Result.Ymax)" y1="@ToSvgY(Result.Zmin)" x2="@ToSvgX(Result.Ymax)" y2="@ToSvgY(dimZBottom - FontSize * 0.35)"
                          stroke="@DimensionColor" stroke-opacity="0.4" stroke-width="@(StrokeWidth * 0.6)" stroke-dasharray="@(StrokeWidth * 2),@(StrokeWidth * 2)" />
                    
                    string bText = $"B = {w:F1} mm";
                    double bW = GetTextWidthApprox(bText, FontSize);
                    double bPad = FontSize * 0.3;
                    double bTx = ToSvgX(Result.Ymin + w / 2.0);
                    double bTy = ToSvgY(dimZBottom - FontSize * 0.7);
                    <rect x="@(bTx - bW / 2.0 - bPad)" y="@(bTy - FontSize * 0.7)" width="@(bW + bPad * 2.0)" height="@(FontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@DimensionColor" stroke-width="@(StrokeWidth * 0.8)" stroke-opacity="0.3" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{bTx:F1}\" y=\"{bTy:F1}\" fill=\"{DimensionTextColor}\" font-size=\"{FontSize:F1}\" font-weight=\"bold\" text-anchor=\"middle\" dominant-baseline=\"middle\">{bText}</text>")

                    <!-- 高度标注 (右侧) -->
                    double dimYRight = Result.Ymax + dimOffset;
                    <line x1="@ToSvgX(dimYRight)" y1="@ToSvgY(Result.Zmin)" x2="@ToSvgX(dimYRight)" y2="@ToSvgY(Result.Zmax)"
                          stroke="@DimensionColor" stroke-width="@StrokeWidth" marker-start="url(#arrow-start)" marker-end="url(#arrow-end)" />
                    <line x1="@ToSvgX(Result.Ymax)" y1="@ToSvgY(Result.Zmin)" x2="@ToSvgX(dimYRight + FontSize * 0.35)" y2="@ToSvgY(Result.Zmin)"
                          stroke="@DimensionColor" stroke-opacity="0.4" stroke-width="@(StrokeWidth * 0.6)" stroke-dasharray="@(StrokeWidth * 2),@(StrokeWidth * 2)" />
                    <line x1="@ToSvgX(Result.Ymax)" y1="@ToSvgY(Result.Zmax)" x2="@ToSvgX(dimYRight + FontSize * 0.35)" y2="@ToSvgY(Result.Zmax)"
                          stroke="@DimensionColor" stroke-opacity="0.4" stroke-width="@(StrokeWidth * 0.6)" stroke-dasharray="@(StrokeWidth * 2),@(StrokeWidth * 2)" />
                    
                    string hText = Parameters?.Type == SectionType.Plate ? $"t = {h:F1} mm" : $"H = {h:F1} mm";
                    double hW = GetTextWidthApprox(hText, FontSize);
                    double hPad = FontSize * 0.3;
                    double hTx = ToSvgX(dimYRight + FontSize * 0.45);

                    // 智能防碰撞：默认将高度标注放在截面高度 72% 处；
                    // 若开启了主轴且第一主轴 1-1 终点的 Z 坐标与此处过近，则自动切换至 28% 处避让
                    double hZ_target = Result.Zmin + h * 0.72;
                    var p1EndCheck = RotateOffset(Result.Yc, Result.Zc, AxisLength, Result.PrincipalAngleDeg);
                    if (ShowAxes && Math.Abs(hZ_target - p1EndCheck.Z) < FontSize * 1.8)
                    {
                        hZ_target = Result.Zmin + h * 0.28;
                    }
                    double hTy = ToSvgY(hZ_target);

                    <rect x="@(hTx - hPad * 0.3)" y="@(hTy - FontSize * 0.7)" width="@(hW + hPad * 1.5)" height="@(FontSize * 1.4)"
                          fill="@CanvasBgColor" fill-opacity="0.92" stroke="@DimensionColor" stroke-width="@(StrokeWidth * 0.8)" stroke-opacity="0.3" rx="@(FontSize * 0.2)" />
                    @((MarkupString)$"<text x=\"{hTx:F1}\" y=\"{hTy:F1}\" fill=\"{DimensionTextColor}\" font-size=\"{FontSize:F1}\" font-weight=\"bold\" dominant-baseline=\"middle\">{hText}</text>")
                }
            </svg>
            }
        }
        else
        {
            <div class="@(IsDarkMode ? "text-secondary" : "text-muted") text-center">
                <div class="display-4 mb-2">⬡</div>
                <div>等待输入截面尺寸以渲染图形...</div>
            </div>
        }
    </div>

    <!-- 底部控制栏：根据截面类型自适应呈现 (钢板专属 vs 型钢力学) -->
    @if (Parameters?.Type == SectionType.Plate)
    {
        <div class="cad-toolbar d-flex align-items-center justify-content-center gap-3 gap-md-4 px-3 py-2 border-top text-nowrap @(IsDarkMode ? "bg-black bg-opacity-50 border-secondary text-white" : "bg-light border-light-subtle text-dark") text-xs">
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="plateDims" @bind="ShowDimensions">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="plateDims">尺寸标注</label>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="plateCoating" @bind="ShowCoatings">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="plateCoating">涂层层析</label>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="plateGrid" @bind="ShowGrid">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="plateGrid">工程网格</label>
            </div>
        </div>
    }
    else
    {
        <div class="cad-toolbar d-flex align-items-center justify-content-center gap-3 gap-md-4 px-3 py-2 border-top text-nowrap @(IsDarkMode ? "bg-black bg-opacity-50 border-secondary text-white" : "bg-light border-light-subtle text-dark") text-xs">
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="showDims" @bind="ShowDimensions">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="showDims">标注</label>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="showAxes" @bind="ShowAxes">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="showAxes">形心/主轴</label>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="showStress" @bind="ShowStressMap">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="showStress">中和轴/应力</label>
            </div>
            <div class="form-check form-switch m-0 d-flex align-items-center gap-1 text-nowrap">
                <input class="form-check-input" type="checkbox" id="showGrid" @bind="ShowGrid">
                <label class="form-check-label text-nowrap @(IsDarkMode ? "text-white-75" : "text-muted")" for="showGrid">网格</label>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public SectionPropertiesResult? Result { get; set; }
    [Parameter] public SectionParameters? Parameters { get; set; }
    [Parameter] public bool IsDarkMode { get; set; } = true;
    [Parameter] public string MinHeight { get; set; } = "260px";
    [Parameter] public string MaxSvgHeight { get; set; } = "320px";
    [Parameter] public bool HighlightTopSurface { get; set; } = false;

    public bool ShowCoatings { get; set; } = true;

    public bool ShowDimensions { get; set; } = true;
    public bool ShowAxes { get; set; } = true;
    public bool ShowStressMap { get; set; } = true;
    public bool ShowGrid { get; set; } = true;

    private double ZoomScale { get; set; } = 1.0;

    private void ResetZoom()
    {
        ZoomScale = 1.0;
    }

    // 主题色彩计算属性
    private string CanvasBgColor => IsDarkMode ? "#020617" : "#f8fafc";
    private string GridLineColor => IsDarkMode ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.06)";
    private string SectionFillColor => IsDarkMode ? "#1e293b" : "#e2e8f0";
    private string SectionStrokeColor => IsDarkMode ? "#38bdf8" : "#0284c7";
    private string DimensionColor => IsDarkMode ? "#38bdf8" : "#0284c7";
    private string DimensionTextColor => IsDarkMode ? "#38bdf8" : "#0f172a";
    private string RefAxisColor => IsDarkMode ? "rgba(255,255,255,0.25)" : "rgba(0,0,0,0.2)";
    private string Axis1Color => IsDarkMode ? "#22c55e" : "#16a34a";
    private string Axis2Color => IsDarkMode ? "#f97316" : "#ea580c";
    private string CentroidColor => IsDarkMode ? "#ef4444" : "#dc2626";
    private string NeutralAxisColor => IsDarkMode ? "#ec4899" : "#db2777";

    // 坐标与 ViewBox 计算
    private double BoxMinX { get; set; }
    private double BoxMinY { get; set; }
    private double BoxWidth { get; set; }
    private double BoxHeight { get; set; }
    private double StrokeWidth { get; set; } = 2.0;
    private double FontSize { get; set; } = 12.0;
    private double GridSpacing { get; set; } = 50.0;
    private double AxisLength { get; set; } = 100.0;
    private string SvgViewBox { get; set; } = "0 0 500 500";

    protected override void OnParametersSet()
    {
        UpdateViewBox();
    }

    private void UpdateViewBox()
    {
        if (Result == null) return;

        double w = Math.Max(1.0, Result.TotalWidth);
        double h = Math.Max(1.0, Result.TotalHeight);
        double d = Math.Max(w, h);

        // 视口动态空间预估
        double estBoxDim = d * 1.5;
        double estFontSize = estBoxDim * 0.038;

        // 动态计算标注所需空间，确保尺寸数值与引线完整显示且不溢出视口
        double dimOffset = d * 0.15;
        string hTextSample = $"H = {h:F1} mm";
        double hTextWidth = GetTextWidthApprox(hTextSample, estFontSize);

        double padRight = dimOffset + hTextWidth + estFontSize * 1.5;
        double padBottom = dimOffset + estFontSize * 2.5;
        double padLeft = Math.Max(d * 0.25, estFontSize * 6.5);
        double padTop = Math.Max(d * 0.20, estFontSize * 3.5);

        BoxMinX = Result.Ymin - padLeft;
        BoxMinY = Result.Zmin - padBottom;
        BoxWidth = w + padLeft + padRight;
        BoxHeight = h + padTop + padBottom;

        double boxDim = Math.Max(BoxWidth, BoxHeight);

        // 归一化工程排版标定：保持文字、线宽、箭头在任意截面物理尺寸下呈现恒定屏幕像素
        StrokeWidth = boxDim * 0.0055;
        FontSize = boxDim * 0.038;
        GridSpacing = GetNiceGridSpacing(boxDim);
        AxisLength = d * 0.58;

        SvgViewBox = $"{BoxMinX:F2} {BoxMinY:F2} {BoxWidth:F2} {BoxHeight:F2}";
    }

    private double GetNiceGridSpacing(double size)
    {
        double target = size / 10.0;
        if (target <= 0.0001) return 1.0;
        double exponent = Math.Floor(Math.Log10(target));
        double fraction = target / Math.Pow(10, exponent);
        double niceFraction;
        if (fraction < 1.5) niceFraction = 1.0;
        else if (fraction < 3.5) niceFraction = 2.0;
        else if (fraction < 7.5) niceFraction = 5.0;
        else niceFraction = 10.0;
        return Math.Max(0.01, niceFraction * Math.Pow(10, exponent));
    }

    private double ToSvgX(double y) => y;

    private double ToSvgY(double z)
    {
        return (BoxMinY + BoxHeight) - (z - BoxMinY);
    }

    private Point2D RotateOffset(double cy, double cz, double dist, double angleDeg)
    {
        double rad = angleDeg * Math.PI / 180.0;
        double dy = dist * Math.Cos(rad);
        double dz = dist * Math.Sin(rad);
        return new Point2D(cy + dy, cz + dz);
    }

    private string GetSvgPolygonPath(List<Point2D> outer, List<List<Point2D>>? inners)
    {
        if (outer.Count == 0) return "";

        var sb = new System.Text.StringBuilder();

        // 外轮廓
        sb.Append($"M {ToSvgX(outer[0].Y):F2} {ToSvgY(outer[0].Z):F2} ");
        for (int i = 1; i < outer.Count; i++)
        {
            sb.Append($"L {ToSvgX(outer[i].Y):F2} {ToSvgY(outer[i].Z):F2} ");
        }
        sb.Append("Z ");

        // 内孔洞
        if (inners != null)
        {
            foreach (var inner in inners)
            {
                if (inner.Count < 3) continue;
                sb.Append($"M {ToSvgX(inner[0].Y):F2} {ToSvgY(inner[0].Z):F2} ");
                for (int i = 1; i < inner.Count; i++)
                {
                    sb.Append($"L {ToSvgX(inner[i].Y):F2} {ToSvgY(inner[i].Z):F2} ");
                }
                sb.Append("Z ");
            }
        }

        return sb.ToString();
    }

    private bool IsPointInsideSection(double y, double z)
    {
        if (Result == null) return false;
        if (Result.IsCircular)
        {
            double r = Math.Sqrt(Math.Pow(y - Result.Yc, 2) + Math.Pow(z - Result.Zc, 2));
            // 考虑微小容差，保证外边界(尤其是顶端最大Z处)能被完整识别
            return r <= Result.CircleOuterRadius + 0.5 && r >= Math.Max(0.0, Result.CircleInnerRadius - 0.5);
        }

        // 截面外形尺度自适应边界容差
        double tol = Math.Max(0.8, Math.Min(Result.TotalWidth, Result.TotalHeight) * 0.005);

        // 判定外轮廓：包含边界上的点(例如顶缘、底缘、侧缘)
        bool insideOuter = IsPointInPolygon(y, z, Result.OuterContour, tol, includeBoundary: true);
        if (!insideOuter) return false;

        // 判定内孔洞：仅剔除严格落在孔洞内部的点，孔洞边界上的点保留
        if (Result.InnerContours != null && Result.InnerContours.Count > 0)
        {
            foreach (var hole in Result.InnerContours)
            {
                if (IsPointInPolygon(y, z, hole, tol, includeBoundary: false))
                    return false;
            }
        }

        return true;
    }

    private bool IsPointInPolygon(double y, double z, List<Point2D> pts, double tol, bool includeBoundary)
    {
        if (pts.Count < 3) return false;

        // 1. 线段边界判定 (针对 z = Zmax 或边界边线上的点)
        for (int i = 0, j = pts.Count - 1; i < pts.Count; j = i++)
        {
            if (IsPointOnSegment(y, z, pts[j], pts[i], tol))
            {
                return includeBoundary;
            }
        }

        // 2. 射线穿透判定法：对水平线重合及顶点重合做微扰消除退化
        double testZ = z;
        for (int i = 0; i < pts.Count; i++)
        {
            if (Math.Abs(pts[i].Z - testZ) < 1e-5)
            {
                testZ += 1e-4;
                break;
            }
        }

        bool inside = false;
        int n = pts.Count;
        for (int i = 0, j = n - 1; i < n; j = i++)
        {
            var p1 = pts[i];
            var p2 = pts[j];

            if (((p1.Z > testZ) != (p2.Z > testZ)) &&
                (y < (p2.Y - p1.Y) * (testZ - p1.Z) / (p2.Z - p1.Z) + p1.Y))
            {
                inside = !inside;
            }
        }
        return inside;
    }

    private bool IsPointOnSegment(double py, double pz, Point2D a, Point2D b, double tol)
    {
        double dy = b.Y - a.Y;
        double dz = b.Z - a.Z;
        double l2 = dy * dy + dz * dz;
        if (l2 < 1e-10)
        {
            double dist2 = (py - a.Y) * (py - a.Y) + (pz - a.Z) * (pz - a.Z);
            return dist2 <= tol * tol;
        }

        // 投影到线段的比例因子 t
        double t = ((py - a.Y) * dy + (pz - a.Z) * dz) / l2;
        if (t < -0.01 || t > 1.01) return false;
        t = Math.Max(0.0, Math.Min(1.0, t));

        double projY = a.Y + t * dy;
        double projZ = a.Z + t * dz;
        double d2 = (py - projY) * (py - projY) + (pz - projZ) * (pz - projZ);
        return d2 <= tol * tol;
    }

    private string GetStressColor(double stress)
    {
        if (Math.Abs(stress) < 0.5) return IsDarkMode ? "#94a3b8" : "#64748b";

        if (stress > 0)
        {
            if (stress > 150) return "#ef4444";
            if (stress > 70) return "#f97316";
            return "#fbbf24";
        }
        else
        {
            if (stress < -150) return "#3b82f6";
            if (stress < -70) return "#06b6d4";
            return "#38bdf8";
        }
    }

    private double GetTextWidthApprox(string text, double fontSize)
    {
        if (string.IsNullOrEmpty(text)) return fontSize;
        // 粗略估算等宽与英数中文字符宽度
        double w = 0;
        foreach (char c in text)
        {
            if (c >= 0x4e00 && c <= 0x9fa5)
                w += fontSize * 1.05; // 中文字符宽度
            else
                w += fontSize * 0.62; // 西文字符宽度
        }
        return Math.Max(fontSize * 0.8, w);
    }
}
