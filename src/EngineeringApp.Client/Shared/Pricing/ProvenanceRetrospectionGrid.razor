@using EngineeringApp.Shared.Material
@using EngineeringApp.Shared.Material.Pricing
@using EngineeringApp.Client.Services
@inject ThemeState Theme
@inject IJSRuntime JS
@inject HttpClient Http

<div class="card @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary" : "bg-white border-light-subtle shadow-sm") p-3 flex-grow-1">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
        <div>
            <h6 class="fw-bold text-success mb-1 d-flex align-items-center gap-2">
                <span>📚 工程物料出处记录库与跨时序价格回溯 (Material Provenance & Retrospection)</span>
                <span class="badge bg-success text-xs">唯一特征指纹存档</span>
            </h6>
            <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-xs">
                记录每张特定参数钢板的完整特征标签、建档价格出处、询价批次与时间戳。随大盘与时序演进，支持对全项目用钢进行任意快照重算与调差索赔核算。
            </div>
        </div>

        <!-- 目标回溯价格快照选择器 -->
        <div class="d-flex align-items-center gap-2">
            <span class="small fw-bold @(Theme.IsDarkMode ? "text-warning" : "text-dark") text-nowrap">目标回溯快照 (Target Date):</span>
            <select class="form-select form-select-sm @(Theme.IsDarkMode ? "bg-black text-warning border-secondary" : "bg-white text-dark border-secondary-subtle") w-auto"
                    @bind="RetrospectionTargetSnapshotId" @bind:after="RecalculateRetrospection">
                @foreach (var snap in AllSnapshots)
                {
                    <option value="@snap.SnapshotId">
                        📅 @snap.EffectiveDate.ToString("yyyy-MM-dd") | @snap.SnapshotName @(snap.IsLocked ? "🔒[锁价基期]" : "")
                    </option>
                }
            </select>
            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="() => OnNavigateToPlateConfig.InvokeAsync()" title="返回钢板核算矩阵配置新规格">
                <span>➕ 配置新钢板</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ProvenanceSaveFeedbackMessage))
    {
        <div class="alert alert-success py-1.5 px-3 mb-2 small d-flex align-items-center justify-content-between">
            <span>@ProvenanceSaveFeedbackMessage</span>
            <button type="button" class="btn-close btn-close-xs" @onclick='() => ProvenanceSaveFeedbackMessage = ""'></button>
        </div>
    }

    <!-- 目标大盘与调差基准控制条 (透明工程计算规则，无需复杂抽象模式) -->
    <div class="p-2.5 mb-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle")">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="small fw-bold text-nowrap @(Theme.IsDarkMode ? "text-warning" : "text-primary")">
                    📊 目标大盘行情模拟与调差测算:
                </span>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">Q355B目标基价:</span>
                    <div class="input-group input-group-sm" style="width: 110px;">
                        <span class="input-group-text py-0 text-xs">¥</span>
                        <input type="number" class="form-control form-control-sm py-0 text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                               @bind="RetrospectionTargetSnapshot.PlateBaseQ355B" @bind:after="RecalculateRetrospection" />
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">Q235B目标基价:</span>
                    <div class="input-group input-group-sm" style="width: 110px;">
                        <span class="input-group-text py-0 text-xs">¥</span>
                        <input type="number" class="form-control form-control-sm py-0 text-xs @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "")"
                               @bind="RetrospectionTargetSnapshot.PlateBaseQ235B" @bind:after="RecalculateRetrospection" />
                    </div>
                </div>
            </div>

            <!-- 统一透明工程计算公式指示 -->
            <div class="text-xs px-2 py-1 rounded border @(Theme.IsDarkMode ? "bg-black bg-opacity-30 border-secondary text-info" : "bg-white border-info-subtle text-primary")">
                <span>📐 <b>核算规则</b>: 目标期回溯价 = 目标大盘基价 + 执行加价 | 业主调差 ΔP = 回溯价 - 基期底账价 | ★ 采办经营创效 = 业主补价 - 实付增量</span>
            </div>
        </div>
    </div>

    <!-- 全项目调差与成本聚合看板 (6大核心工程造价与商务经营指标) -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">① 归档物料品种数</div>
                <div class="fs-5 fw-bold text-primary">@Records.Count <span class="text-xs fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">种独立特征</span></div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">② 关联用钢总量</div>
                <div class="fs-5 fw-bold text-info">@GetTotalProjectTons().ToString("N1") <span class="text-xs fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">吨 (t)</span></div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">③ 合同基期底账总额</div>
                <div class="fs-5 fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">¥ @GetTotalBaseRecordedCost().ToString("N0")</div>
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">不可变调差锚点</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(Theme.IsDarkMode ? "bg-secondary bg-opacity-10 border-secondary" : "bg-light border-light-subtle")">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">④ 当前执行采购实付</div>
                <div class="fs-5 fw-bold text-warning">¥ @GetTotalExecutionCost().ToString("N0")</div>
                <div class="text-xs">
                    较基期:
                    <span class="@(GetTotalExecutionVariance() > 0 ? "text-danger fw-bold" : (GetTotalExecutionVariance() < 0 ? "text-success fw-bold" : "text-muted"))">
                        @(GetTotalExecutionVariance() >= 0 ? "+" : "")¥@GetTotalExecutionVariance().ToString("N0")
                        @(GetTotalExecutionVariance() > 0 ? "(超支)" : (GetTotalExecutionVariance() < 0 ? "(节约)" : "(持平)"))
                    </span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(GetTotalClaimVariance() >= 0 ? (Theme.IsDarkMode ? "bg-danger bg-opacity-10 border-danger border-opacity-50" : "bg-danger-subtle border-danger-subtle") : (Theme.IsDarkMode ? "bg-success bg-opacity-10 border-success border-opacity-50" : "bg-success-subtle border-success-subtle"))">
                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-1">⑤ 目标期调差索赔总额</div>
                <div class="fs-5 fw-bold @(GetTotalClaimVariance() >= 0 ? "text-danger" : "text-success")">
                    @(GetTotalClaimVariance() >= 0 ? "+" : "")¥ @GetTotalClaimVariance().ToString("N0")
                </div>
                <div class="text-xs @(GetTotalClaimVariance() >= 0 ? "text-danger" : "text-success")">
                    @(GetTotalClaimVariance() >= 0 ? "▲ 应向业主索赔调增" : "▼ 依合同应予核减")
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="p-2 rounded border @(GetTotalCommercialSpread() >= 0 ? (Theme.IsDarkMode ? "bg-success bg-opacity-15 border-success" : "bg-success-subtle border-success border-opacity-75 shadow-sm") : (Theme.IsDarkMode ? "bg-danger bg-opacity-10 border-danger" : "bg-danger-subtle border-danger-subtle"))">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="text-xs fw-bold @(GetTotalCommercialSpread() >= 0 ? "text-success" : "text-danger")">⑥ 采办经营净创效</div>
                    <span class="badge @(GetTotalCommercialSpread() >= 0 ? "bg-success" : "bg-danger") text-xs p-0 px-1">剪刀差利润</span>
                </div>
                <div class="fs-5 fw-bold @(GetTotalCommercialSpread() >= 0 ? "text-success" : "text-danger")">
                    @(GetTotalCommercialSpread() >= 0 ? "+" : "")¥ @GetTotalCommercialSpread().ToString("N0")
                </div>
                <div class="text-xs @(GetTotalCommercialSpread() >= 0 ? "text-success" : "text-danger") fw-semibold">
                    @(GetTotalCommercialSpread() >= 0 ? "🏆 净盈余: " : "⚠️ 净亏损: ")@(GetAverageCommercialSpreadPerTon() >= 0 ? "+" : "")@GetAverageCommercialSpreadPerTon().ToString("0.##") 元/t
                </div>
            </div>
        </div>
    </div>

    <style>
        .cell-editable {
            cursor: pointer;
            padding: 2px 5px;
            border-radius: 4px;
            transition: background-color 0.15s ease-in-out, outline 0.15s ease-in-out;
            display: inline-flex;
            align-items: center;
        }
        .cell-editable:hover {
            background-color: rgba(13, 110, 253, 0.12);
            outline: 1px dashed #0d6efd;
        }
        .table-provenance th {
            white-space: nowrap !important;
            vertical-align: middle !important;
            font-size: 0.82rem;
            padding-top: 7px !important;
            padding-bottom: 7px !important;
        }
    </style>

    <!-- 物料出处记录与跨时序回溯表格 (造价三态并列：合同底账 / 当前执行 / 目标期回溯 / 采办剪刀差创效) -->
    <div class="table-responsive flex-grow-1 mb-3">
        <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-hover table-bordered border-secondary" : "table-hover table-bordered bg-white shadow-sm border-light-subtle") table-provenance small align-middle mb-0">
            <thead class="@(Theme.IsDarkMode ? "table-secondary text-white" : "table-light text-dark")">
                <tr>
                    <th class="text-center" style="width: 35px;" title="行序号">#</th>
                    <th style="min-width: 230px;" title="物料特征规格与出处，点击物料指纹标签可一键复制">物料特征与规格</th>
                    <th style="min-width: 130px;" title="询价批次号、报价渠道与版本依据">询价批次/供应商</th>
                    <th class="text-end" style="min-width: 120px;" title="合同基期锁定底账锚点，恒定不可变更">合同基期价 (元/t)</th>
                    <th class="text-end" style="min-width: 130px;" title="当前实际采购谈判执行价，点击单元格可直接就地修改">当前执行价 (元/t)</th>
                    <th class="text-end" style="min-width: 125px;" title="目标期大盘回溯测算单价 = 目标大盘基价 + 当前执行加价">目标回溯价 (元/t)</th>
                    <th class="text-end" style="min-width: 90px;" title="吨钢对业主调差 = 目标回溯价 - 合同基期价">吨差 ΔP (元/t)</th>
                    <th class="text-center" style="width: 80px;" title="工程预计用量(吨)，直接在格内修改数字">用量 (t)</th>
                    <th class="text-end" style="min-width: 110px;" title="面向业主调差索赔总额 = 吨差 ΔP × 用量">业主调差额 (元)</th>
                    <th class="text-end text-success" style="min-width: 140px;" title="采办经营净创效(剪刀差利润) = 业主索赔补价 - 实际采购多付">★ 经营创效利润 (元)</th>
                    <th class="text-center" style="width: 115px;" title="过程变更审计履历与高级调整">操作与审计</th>
                </tr>
            </thead>
            <tbody>
                @if (Records.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                            暂无物料出处记录。请前往【钢板五维加价】配置钢板并点击“📌 登记入库”按钮添加。
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rec in Records)
                    {
                        var retroPrice = rec.CalculateAtSnapshot(RetrospectionTargetSnapshot, ThicknessLadders, DimensionRules);
                        double deltaP = retroPrice.FinalPricePerTon - rec.ContractBaselinePrice;
                        double tons = GetRecordTons(rec.Id);
                        double deltaCost = deltaP * tons;
                        double execVariance = rec.FinalPricePerTon - rec.ContractBaselinePrice;
                        double spreadPerTon = retroPrice.FinalPricePerTon - rec.FinalPricePerTon;
                        double spreadCost = spreadPerTon * tons;
                        bool isQuickEditing = QuickEditingRecordId == rec.Id;

                        <tr>
                            <td class="text-center">@rec.Id</td>
                            <td>
                                <!-- Line 1: 物料名称 + 批次Badge + 工程引用 -->
                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                    <span class="fw-bold @(Theme.IsDarkMode ? "text-white" : "text-dark")">@rec.DisplayTitle</span>
                                    <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-secondary-subtle text-dark border") font-monospace text-xs">
                                        📦 @rec.InquiryBatchId
                                    </span>
                                    <span class="text-xs text-primary">@rec.ProjectReference</span>
                                </div>
                                <!-- Line 2: 规格尺寸标注与工艺 -->
                                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mt-0.5 d-flex align-items-center gap-1 flex-wrap">
                                    <span class="fw-semibold">@rec.DimensionText</span>
                                    <span>•</span>
                                    <span>@rec.MillName</span>
                                    <span>•</span>
                                    <span class="badge @(rec.PlateParameters?.Tolerance == ToleranceClass.ClassC ? "bg-primary" : "bg-secondary") text-xs p-0 px-1">
                                        @(rec.PlateParameters?.Tolerance == ToleranceClass.ClassC ? "C类保全公差" : (rec.PlateParameters?.Tolerance == ToleranceClass.ClassB ? "B类公差" : "A类公差"))
                                    </span>
                                    @if (rec.PlateParameters?.ZDirection != ZDirectionQuality.None)
                                    {
                                        <span class="badge bg-info text-dark text-xs p-0 px-1">@rec.PlateParameters?.ZDirection</span>
                                    }
                                    @if (rec.PlateParameters?.UT != UltrasonicInspection.None)
                                    {
                                        <span class="badge bg-warning text-dark text-xs p-0 px-1">@(rec.PlateParameters?.UT == UltrasonicInspection.ClassI ? "UT-I" : "UT-II")</span>
                                    }
                                </div>
                                <!-- Line 3: 物料指纹唯一标签 (点击直接复制，移入悬停变手型) -->
                                <div class="mt-1">
                                    <span class="badge font-monospace text-xs text-truncate clickable-tag @(Theme.IsDarkMode ? "bg-dark text-info border border-secondary" : "bg-light text-primary border border-primary-subtle")"
                                          style="cursor: pointer; max-width: 100%; transition: all 0.2s;"
                                          @onclick="() => CopyTagText(rec.MaterialTag)"
                                          title="点击直接复制物料指纹标签: @rec.MaterialTag">
                                        🏷️ @rec.MaterialTag
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold">📅 @rec.InquiryDate.ToString("yyyy-MM-dd")</div>
                                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-truncate" style="max-width: 135px;" title="@rec.InquiryVendor">
                                    @rec.InquiryVendor
                                </div>
                                <div class="mt-1 d-flex align-items-center gap-1">
                                    <span class="badge @(rec.RevisionNumber > 1 ? "bg-success text-white" : "bg-secondary text-white") text-xs">
                                        Rev @rec.RevisionNumber
                                    </span>
                                    <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") text-truncate" style="max-width: 100px;" title="@rec.PricingPrincipleNote">
                                        @rec.PricingPrincipleNote
                                    </span>
                                </div>
                            </td>

                            <!-- 列 1: 合同基期底账单价 (锁定底账锚点，不可变更) -->
                            <td class="text-end" title="合同基期锁定底账锚点，恒定不可变动">
                                <div class="fw-bold fs-6">¥@rec.ContractBaselinePrice.ToString("0.##")</div>
                                <div class="text-xs text-success">🔒 锁定底账</div>
                            </td>

                            <!-- 列 2: 当前执行采购单价 (支持就地快捷直接修改) -->
                            <td class="text-end" title="点击直接就地修改当前执行采购价 (按回车或点✓保存)">
                                @if (isQuickEditing)
                                {
                                    <div class="input-group input-group-sm d-inline-flex justify-content-end" style="width: 125px;">
                                        <span class="input-group-text py-0 px-1 text-xs">¥</span>
                                        <input type="number" class="form-control form-control-sm py-0 px-1 text-xs fw-bold text-end"
                                               @bind="QuickEditPriceInput"
                                               @onkeydown="(e) => HandleQuickEditKeyDown(e, rec)"
                                               autofocus />
                                        <button class="btn btn-xs btn-success py-0 px-1" @onclick="() => SaveQuickEdit(rec)" title="保存 (Enter)">✓</button>
                                        <button class="btn btn-xs btn-outline-secondary py-0 px-1" @onclick="CancelQuickEdit" title="取消 (Esc)">✕</button>
                                    </div>
                                    <div class="text-xs text-muted mt-0.5">回车保存 / Esc取消</div>
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center gap-1 cell-editable" @onclick="() => StartQuickEdit(rec)">
                                        <span class="fw-bold fs-6 @(rec.RevisionNumber > 1 ? "text-warning" : "")">¥@rec.FinalPricePerTon.ToString("0.##")</span>
                                        <span class="text-xs text-primary" title="点击修改执行价">✏️</span>
                                    </div>
                                    <div class="mt-0.5">
                                        @if (Math.Abs(execVariance) < 0.01)
                                        {
                                            <span class="badge @(Theme.IsDarkMode ? "bg-secondary text-white" : "bg-light text-muted border") text-xs">较底账持平</span>
                                        }
                                        else if (execVariance > 0)
                                        {
                                            <span class="badge bg-warning text-dark text-xs" title="实际采购较合同底账超支">实付多付 +¥@execVariance.ToString("0.##")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success text-white text-xs" title="实际采购较合同底账节约">实付节省 -¥@(Math.Abs(execVariance).ToString("0.##"))</span>
                                        }
                                    </div>
                                }
                            </td>

                            <!-- 列 3: 目标期回溯单价 -->
                            <td class="text-end" title="大盘¥@retroPrice.BasePricePerTon.ToString("0") + 加价¥@((retroPrice.FinalPricePerTon - retroPrice.BasePricePerTon).ToString("0"))">
                                <div class="fw-bold text-primary fs-6">¥@retroPrice.FinalPricePerTon.ToString("0.##")</div>
                                <div class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">
                                    大盘¥@retroPrice.BasePricePerTon.ToString("0") + 加价¥@((retroPrice.FinalPricePerTon - retroPrice.BasePricePerTon).ToString("0"))
                                </div>
                            </td>

                            <!-- 列 4: 吨钢调差 ΔP (对业主) -->
                            <td class="text-end">
                                <span class="badge @(deltaP >= 0 ? "bg-danger" : "bg-success") fs-7">
                                    @(deltaP >= 0 ? "+" : "")@deltaP.ToString("0.##")
                                </span>
                            </td>

                            <!-- 列 5: 工程用量 (t) (直接就地修改) -->
                            <td class="text-center">
                                <input type="number" class="form-control form-control-sm text-center py-0 px-1 @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white")"
                                       value="@tons"
                                       @onchange="(e) => SetRecordTons(rec.Id, e.Value)"
                                       style="width: 72px; display: inline-block;"
                                       title="直接修改工程用量吨数" />
                            </td>

                            <!-- 列 6: 业主调差额 ΔCost -->
                            <td class="text-end fw-bold @(deltaCost >= 0 ? "text-danger" : "text-success")">
                                @(deltaCost >= 0 ? "+" : "")¥@deltaCost.ToString("N0")
                            </td>

                            <!-- 列 7: ★ 采办经营创效 (剪刀差利润) -->
                            <td class="text-end" title="核算拆解：业主索赔补 ¥@deltaP:0.## - 实际采购多付 ¥@execVariance:0.## = 净创效 ¥@spreadPerTon:0.##/t">
                                <div class="fw-bold @(spreadPerTon >= 0 ? "text-success" : "text-danger") fs-6 d-flex align-items-center justify-content-end gap-1">
                                    <span>@(spreadPerTon >= 0 ? "+" : "")¥@spreadPerTon.ToString("0.##")/t</span>
                                    @if (spreadPerTon > 0)
                                    {
                                        <span class="badge bg-success text-white text-xs px-1" title="采办经营净盈利">盈</span>
                                    }
                                    else if (spreadPerTon < 0)
                                    {
                                        <span class="badge bg-danger text-white text-xs px-1" title="采办经营亏损">亏</span>
                                    }
                                </div>
                                <div class="text-xs">
                                    净额: <b class="@(spreadCost >= 0 ? "text-success" : "text-danger")">@(spreadCost >= 0 ? "+" : "")¥@spreadCost.ToString("N0")</b>
                                </div>
                            </td>

                            <!-- 操作与审计 -->
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <button class="btn btn-xs btn-outline-primary py-0 px-1" @onclick="() => OnOpenRevision.InvokeAsync(rec)" title="打开高级加价与批次修订面板">
                                        ⚙️ 详调
                                    </button>
                                    <button class="btn btn-xs btn-outline-info py-0 px-1" @onclick="() => OnOpenAudit.InvokeAsync(rec)" title="查看过程变更审计履历 (@rec.RevisionLogs.Count 次)">
                                        🕒 履历 (@rec.RevisionLogs.Count)
                                    </button>
                                    <button class="btn btn-xs btn-outline-danger py-0 px-1" @onclick="() => OnRemoveRecord.InvokeAsync(rec.Id)" title="删除此物料记录">
                                        🗑️
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 底部结论与索赔调差指引 -->
    <div class="p-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-50 border-secondary" : "bg-light border-light-subtle") d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="small">
            <b>💡 工程造价调差与采办经营创效结论:</b>
            基于目标快照 <span class="text-primary fw-bold">@RetrospectionTargetSnapshot.SnapshotName (@RetrospectionTargetSnapshot.EffectiveDate.ToString("yyyy-MM-dd"))</span>，
            全项目 @Records.Count 种物料构件共计 <span class="fw-bold">@GetTotalProjectTons().ToString("N1")</span> 吨钢：
            <br />
            ① <b>合同基期底账</b>：<span class="fw-bold">¥@GetTotalBaseRecordedCost().ToString("N0")</span> 元 (锁价基期原点)；
            ② <b>当前采购实付</b>：<span class="fw-bold text-warning">¥@GetTotalExecutionCost().ToString("N0")</span> 元 (实付较基期@(GetTotalExecutionVariance() >= 0 ? "多付" : "节省") ¥@Math.Abs(GetTotalExecutionVariance()).ToString("N0") 元)；
            ③ <b>对业主索赔调差</b>：<b class="@(GetTotalClaimVariance() >= 0 ? "text-danger" : "text-success")">@(GetTotalClaimVariance() >= 0 ? "+" : "")¥ @GetTotalClaimVariance().ToString("N0") 元</b>；
            <br />
            ④ <span class="badge bg-success me-1">★ 商务采办净创效</span>：施工单位合规实现的<b>剪刀差经营利润为 <span class="@(GetTotalCommercialSpread() >= 0 ? "text-success fs-6" : "text-danger fs-6") fw-bold">@(GetTotalCommercialSpread() >= 0 ? "+" : "")¥ @GetTotalCommercialSpread().ToString("N0") 元</span></b>
            (业主调差补价扣除实际采购多付，平均为施工单位创效盈利 <b>@(GetAverageCommercialSpreadPerTon() >= 0 ? "+" : "")@GetAverageCommercialSpreadPerTon().ToString("0.##") 元/t</b>)！
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetRecordTons">
                ↺ 重置用量
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<MaterialProvenanceRecord> Records { get; set; } = [];
    [Parameter] public List<MaterialPriceSnapshot> AllSnapshots { get; set; } = [];
    [Parameter] public List<PlateThicknessLadder> ThicknessLadders { get; set; } = [];
    [Parameter] public List<PlateDimensionRule> DimensionRules { get; set; } = [];
    [Parameter] public EventCallback<MaterialProvenanceRecord> OnOpenRevision { get; set; }
    [Parameter] public EventCallback<MaterialProvenanceRecord> OnOpenAudit { get; set; }
    [Parameter] public EventCallback<int> OnRemoveRecord { get; set; }
    [Parameter] public EventCallback<MaterialProvenanceRecord> OnRecordUpdated { get; set; }
    [Parameter] public EventCallback OnNavigateToPlateConfig { get; set; }

    private string RetrospectionTargetSnapshotId = "SNAP-20261008-LATEST";
    private Dictionary<int, double> RecordTons = new();

    private int? QuickEditingRecordId = null;
    private double QuickEditPriceInput = 0;
    private string ProvenanceSaveFeedbackMessage = "";

    private MaterialPriceSnapshot RetrospectionTargetSnapshot =>
        AllSnapshots.FirstOrDefault(s => s.SnapshotId == RetrospectionTargetSnapshotId) ?? SeedPriceSnapshots.GetById(RetrospectionTargetSnapshotId);

    protected override void OnParametersSet()
    {
        foreach (var r in Records)
        {
            if (!RecordTons.ContainsKey(r.Id))
            {
                RecordTons[r.Id] = r.Id == 1 ? 150.0 : (r.Id == 2 ? 80.0 : 100.0);
            }
        }
    }

    private double GetRecordTons(int id) => RecordTons.TryGetValue(id, out var t) ? t : 100.0;

    private void SetRecordTons(int id, object? val)
    {
        if (double.TryParse(val?.ToString(), out var parsed) && parsed >= 0)
        {
            RecordTons[id] = parsed;
            StateHasChanged();
        }
    }

    private void ResetRecordTons()
    {
        RecordTons.Clear();
        foreach (var r in Records) RecordTons[r.Id] = 100.0;
        StateHasChanged();
    }

    private double GetTotalProjectTons() => Records.Sum(r => GetRecordTons(r.Id));

    private double GetTotalBaseRecordedCost() => Records.Sum(r => r.ContractBaselinePrice * GetRecordTons(r.Id));

    private double GetTotalExecutionCost() => Records.Sum(r => r.FinalPricePerTon * GetRecordTons(r.Id));

    private double GetTotalExecutionVariance() => GetTotalExecutionCost() - GetTotalBaseRecordedCost();

    private double GetTotalRetrospectiveCost() => Records.Sum(r => r.CalculateAtSnapshot(RetrospectionTargetSnapshot, ThicknessLadders, DimensionRules).FinalPricePerTon * GetRecordTons(r.Id));

    private double GetTotalClaimVariance() => GetTotalRetrospectiveCost() - GetTotalBaseRecordedCost();

    private double GetTotalCommercialSpread() => GetTotalClaimVariance() - GetTotalExecutionVariance();

    private double GetAverageCommercialSpreadPerTon() => GetTotalProjectTons() > 0 ? GetTotalCommercialSpread() / GetTotalProjectTons() : 0;

    private void RecalculateRetrospection() => StateHasChanged();

    private void StartQuickEdit(MaterialProvenanceRecord rec)
    {
        QuickEditingRecordId = rec.Id;
        QuickEditPriceInput = rec.FinalPricePerTon;
    }

    private void CancelQuickEdit()
    {
        QuickEditingRecordId = null;
    }

    private async Task HandleQuickEditKeyDown(KeyboardEventArgs e, MaterialProvenanceRecord rec)
    {
        if (e.Key == "Enter")
        {
            await SaveQuickEdit(rec);
        }
        else if (e.Key == "Escape")
        {
            CancelQuickEdit();
        }
    }

    private async Task SaveQuickEdit(MaterialProvenanceRecord rec)
    {
        if (QuickEditingRecordId != rec.Id) return;
        if (QuickEditPriceInput <= 0) return;

        double oldPrice = rec.FinalPricePerTon;
        if (Math.Abs(oldPrice - QuickEditPriceInput) < 0.001)
        {
            QuickEditingRecordId = null;
            return;
        }

        double delta = QuickEditPriceInput - oldPrice;
        string reason = "商务议价调整";
        string details = $"执行单价直接修改: ¥{oldPrice:0.##} ➔ ¥{QuickEditPriceInput:0.##}/t (变动: {(delta >= 0 ? "+" : "")}{delta:0.##} 元/t)";

        rec.AddRevision(
            reason: reason,
            revisedBy: "造价工程师",
            newPricePerTon: QuickEditPriceInput,
            changeDetails: details,
            appliedPrinciple: rec.PricingPrincipleNote
        );

        try
        {
            await Http.PutAsJsonAsync($"/api/pricing/provenance-records/{rec.Id}", rec);
        }
        catch { }

        await OnRecordUpdated.InvokeAsync(rec);
        QuickEditingRecordId = null;
        StateHasChanged();
    }

    private async Task CopyTagText(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ProvenanceSaveFeedbackMessage = $"✓ 物料指纹已复制到剪贴板: {text}";
            StateHasChanged();
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                ProvenanceSaveFeedbackMessage = "";
                await InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }
}
