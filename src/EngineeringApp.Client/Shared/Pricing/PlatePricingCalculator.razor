                <div class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted") small mb-1">最终综合采购到货单价</div>
                <div class="display-6 fw-bold text-success tracking-tight">
                    ¥ @CurrentPlatePrice.FinalPricePerTon.ToString("N2")
                    <span class="fs-6 fw-normal @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">元/吨</span>
                </div>
                <div class="text-primary small mt-1">
                    包含钢厂出厂基价 + 各项加价 + 调运物流费
                </div>
            </div>

            <!-- 物料出处唯一特征标签与入库记录卡片 -->
            <div class="p-2 mb-3 rounded border @(Theme.IsDarkMode ? "bg-dark bg-opacity-60 border-info border-opacity-50" : "bg-light border-info-subtle")">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-info text-dark text-xs">🏷️ 物料出处特征标签 (唯一指纹)</span>
                    <button class="btn btn-xs btn-outline-info py-0 px-2" @onclick="CopyTagToClipboard" title="复制唯一标签">
                        📋 复制标签
                    </button>
                </div>
                <div class="font-monospace text-xs p-1 rounded border @(Theme.IsDarkMode ? "bg-black text-info border-secondary" : "bg-white text-primary border-light-subtle") text-truncate user-select-all" title="@CurrentPlateTag">
