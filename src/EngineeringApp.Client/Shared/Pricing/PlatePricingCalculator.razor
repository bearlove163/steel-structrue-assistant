                </div>

                <!-- 批次、工程与询价时间明细录入 -->
                <div class="mt-2 pt-2 border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                    <div class="row g-1 mb-1">
                        <div class="col-6">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">工程项目名称:</label>
                            <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                   placeholder="项目名称" @bind="ProvenanceArchiveProjectInput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">询价批次号:</label>
                            <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs font-monospace"
                                   placeholder="如 INQ-20260401-LOT03" @bind="ProvenanceArchiveBatchInput" />
                        </div>
                    </div>
                    <div class="row g-1 mb-1">
                        <div class="col-6">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">询价具体日期:</label>
                            <input type="date" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                   @bind="ProvenanceArchiveDateInput" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">报价渠道/供应商:</label>
                            <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                                   placeholder="如 宝武直供/现货仓" @bind="ProvenanceArchiveVendorInput" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-0">适用加价原则公函/依据:</label>
                        <input type="text" class="form-control form-control-sm @(Theme.IsDarkMode ? "bg-dark text-white border-secondary" : "bg-white text-dark border-secondary-subtle") text-xs"
                               placeholder="如 2026Q1钢厂加价公函与现行阶梯" @bind="ProvenanceArchivePrincipleInput" />
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-xs @(Theme.IsDarkMode ? "text-white-50" : "text-muted")">初始版本: <b class="text-success">Rev 1</b></span>
                        <button class="btn btn-sm btn-success text-nowrap d-flex align-items-center gap-1 py-1 px-3 fw-bold"
                                @onclick="ArchiveCurrentPlateToProvenance" title="将当前配置钢板归档入库，记录时间与成本出处">
                            <span>📌 登记入库</span>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ProvenanceSaveFeedbackMessage))
                {
                    <div class="text-success text-xs mt-2 p-1 rounded bg-success bg-opacity-10 border border-success border-opacity-25 d-flex align-items-center justify-content-between">
                        <span>@ProvenanceSaveFeedbackMessage</span>
                        <button class="btn btn-link text-info text-xs p-0 text-decoration-none fw-bold" @onclick="() => OnGoToProvenance.InvokeAsync()">
                            前往出处库回溯 →
                        </button>
                    </div>
                }
            </div>

            <!-- 瀑布分解明细卡片 -->
            <div class="mb-3">
                <div class="small fw-bold @(Theme.IsDarkMode ? "text-white-50" : "text-muted") mb-2">加价因子明细拆解 (元/吨):</div>
                <div class="table-responsive">
                    <table class="table table-sm @(Theme.IsDarkMode ? "table-dark table-borderless" : "table-light table-borderless") small mb-0">
                        <tbody>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">1. 大盘基准单价:</td>
                                <td class="text-end fw-bold">¥@CurrentPlatePrice.BasePricePerTon.ToString("0.##")</td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">2. 钢厂品牌溢价:</td>
                                <td class="text-end text-primary">
                                    +¥@CurrentPlatePrice.MillPremiumPerTon.ToString("0.##")
                                    @if (CurrentPlatePrice.IsMillPremiumCustomized)
                                    {
                                        <span class="badge bg-warning text-dark text-xs ms-1">自定义 (参考¥@CurrentPlatePrice.BenchmarkMillPremium.ToString("0.##"))</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">3. 规格厚度加价:</td>
                                <td class="text-end text-warning">
                                    +¥@CurrentPlatePrice.ThicknessSurchargePerTon.ToString("0.##")
                                    @if (CurrentPlatePrice.IsThicknessSurchargeCustomized)
                                    {
                                        <span class="badge bg-warning text-dark text-xs ms-1">自定义 (参考¥@CurrentPlatePrice.BenchmarkThicknessSurcharge.ToString("0.##"))</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">4. 定尺切割加价:</td>
                                <td class="text-end text-warning">
                                    +¥@CurrentPlatePrice.DimensionSurchargePerTon.ToString("0.##")
                                    @if (CurrentPlatePrice.IsDimensionSurchargeCustomized)
                                    {
                                        <span class="badge bg-warning text-dark text-xs ms-1">自定义 (参考¥@CurrentPlatePrice.BenchmarkDimensionSurcharge.ToString("0.##"))</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">5. 公差与保全厚度:</td>
                                <td class="text-end text-danger">+¥@CurrentPlatePrice.ToleranceSurchargePerTon.ToString("0.##")</td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">6. 冲击与Z向性能:</td>
                                <td class="text-end text-primary">+¥@CurrentPlatePrice.PerformanceSurchargePerTon.ToString("0.##")</td>
                            </tr>
                            <tr>
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">7. 探伤与质保认证:</td>
                                <td class="text-end text-primary">+¥@CurrentPlatePrice.InspectionSurchargePerTon.ToString("0.##")</td>
                            </tr>
                            <tr class="border-top @(Theme.IsDarkMode ? "border-secondary" : "border-light-subtle")">
                                <td class="@(Theme.IsDarkMode ? "text-white-50" : "text-muted")">8. 干线物流调运费:</td>
                                <td class="text-end text-success fw-bold">
                                    +¥@CurrentPlatePrice.FreightPerTon.ToString("0.##")
                                    @if (CurrentPlatePrice.IsFreightCustomized)
                                    {
                                        <span class="badge bg-warning text-dark text-xs ms-1">自定义 (预设¥@CurrentPlatePrice.BenchmarkFreight.ToString("0.##"))</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 标准化 Describe 描述规范展示框 -->
            <div class="mt-auto @(Theme.IsDarkMode ? "bg-black border-secondary" : "bg-light border-light-subtle") p-3 rounded border">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge @(Theme.IsDarkMode ? "bg-secondary" : "bg-secondary-subtle text-dark border") text-xs">标准化 Describe 输出 (契约接口)</span>
                    <button class="btn btn-xs btn-outline-success py-0 px-2" @onclick="CopyDescribeToClipboard">
                        📋 一键复制
                    </button>
                </div>
                <div class="font-monospace small @(Theme.IsDarkMode ? "text-warning bg-dark border-secondary" : "text-dark bg-white border-secondary-subtle") p-2 rounded border text-break user-select-all" style="font-size: 12px; line-height: 1.6;">
                    @CurrentPlatePrice.FullDescription
                </div>
                @if (!string.IsNullOrEmpty(CopyAlertMessage))
                {
                    <div class="text-success small mt-1 animate-pulse">@CopyAlertMessage</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public StandardSystem CurrentStandard { get; set; } = StandardSystem.GB;
    [Parameter] public MaterialPriceSnapshot CurrentSnapshot { get; set; } = null!;
    [Parameter] public List<SteelMillBrand> AllMills { get; set; } = [];
    [Parameter] public List<PlateThicknessLadder> ThicknessLadders { get; set; } = [];
    [Parameter] public List<PlateDimensionRule> DimensionRules { get; set; } = [];
    [Parameter] public EventCallback<MaterialProvenanceRecord> OnArchiveRecord { get; set; }
    [Parameter] public EventCallback OnGoToProvenance { get; set; }

    private StandardSystem _lastStandard = StandardSystem.GB;

    private PlatePricingParameters PlateParams = new()
    {
        ThicknessMm = 50.0,
        WidthMm = 2500.0,
        LengthMm = 12000.0,
        Tolerance = ToleranceClass.ClassC,
        Impact = ImpactGrade.GradeD,
        ZDirection = ZDirectionQuality.Z25,
        Metallurgy = MetallurgyProcess.TMCP,
        UT = UltrasonicInspection.ClassI,
        CutType = PlateDimensionCutType.FixedDimension,
        SteelMillId = "Baosteel",
        DestinationRegion = "华东-浙江制造车间"
    };

    private StandardMaterialItemPrice CurrentPlatePrice = new();

    private double? CustomThicknessInput = null;
    private double? CustomDimensionInput = null;
    private double? CustomMillPremiumInput = null;
    private double? CustomFreightInput = null;

    private bool ShowLadderConfigPanel = false;
    private bool ShowDimensionConfigPanel = false;

    private string CurrentPlateTag => MaterialProvenanceTagBuilder.GeneratePlateTag(PlateParams);

    private string ProvenanceArchiveProjectInput = "粤港澳大湾区钢构主厂房项目";
    private string ProvenanceArchiveBatchInput = "INQ-20260401-LOT03";
    private DateTime ProvenanceArchiveDateInput = DateTime.Today;
    private string ProvenanceArchiveVendorInput = "宝武钢贸直销部";
    private string ProvenanceArchivePrincipleInput = "执行2026Q1钢厂加价公函与现行阶梯";
    private string ProvenanceSaveFeedbackMessage = "";
    private string CopyAlertMessage = "";

    protected override void OnInitialized()
    {
        _lastStandard = CurrentStandard;
        RecalculatePlate();
    }

    protected override void OnParametersSet()
    {
        if (CurrentStandard != _lastStandard)
        {
            _lastStandard = CurrentStandard;
            if (CurrentStandard == StandardSystem.EN)
                PlateParams.Grade = SteelGrade.S355J2;
            else if (CurrentStandard == StandardSystem.ASTM)
                PlateParams.Grade = SteelGrade.A572_Gr50;
            else
                PlateParams.Grade = SteelGrade.Q355D;
        }
        RecalculatePlate();
    }

    private void RecalculatePlate()
    {
        if (CurrentSnapshot == null) return;
        PlateParams.Standard = CurrentStandard;
        PlateParams.CustomThicknessSurcharge = CustomThicknessInput;
        PlateParams.CustomDimensionSurcharge = CustomDimensionInput;
        PlateParams.CustomMillPremium = CustomMillPremiumInput;
        PlateParams.CustomFreightPerTon = CustomFreightInput;

        CurrentPlatePrice = PlatePricingRuleEngine.Calculate(
            PlateParams,
            CurrentSnapshot,
            ThicknessLadders,
            DimensionRules);
    }

    private void OnThicknessChanged() => RecalculatePlate();
    private void OnCutTypeOrDimensionChanged() => RecalculatePlate();

    private void OnMillChanged()
    {
        CustomMillPremiumInput = null;
        RecalculatePlate();
    }

    private void OnDeliveryOrDestinationChanged()
    {
        CustomFreightInput = null;
        RecalculatePlate();
    }

    private void ResetThicknessToBenchmark()
    {
        CustomThicknessInput = null;
        RecalculatePlate();
    }

    private void ResetDimensionToBenchmark()
    {
        CustomDimensionInput = null;
        RecalculatePlate();
    }

    private void ResetMillToBenchmark()
    {
        CustomMillPremiumInput = null;
        RecalculatePlate();
    }

    private void ResetFreightToBenchmark()
    {
        CustomFreightInput = null;
        RecalculatePlate();
    }

    private void ResetLaddersToDefault()
    {
        ThicknessLadders = PlateThicknessLadder.GetDefaultLadders();
        RecalculatePlate();
    }

    private void ResetAllToDefaults()
    {
        CustomThicknessInput = null;
        CustomDimensionInput = null;
        CustomMillPremiumInput = null;
        CustomFreightInput = null;
        ThicknessLadders = PlateThicknessLadder.GetDefaultLadders();
        DimensionRules = PlateDimensionRule.GetDefaultRules();
        ProvenanceSaveFeedbackMessage = "🔄 已成功恢复所有规则阶梯、钢厂溢价与调运费为行业出厂基准！";
        RecalculatePlate();
    }

    private async Task SaveCustomRulesToDatabase()
    {
        ProvenanceSaveFeedbackMessage = "💾 当前自定义规则矩阵与加价阶梯已更新！";
        StateHasChanged();
        await Task.Delay(3000);
        ProvenanceSaveFeedbackMessage = "";
        StateHasChanged();
    }

    private void Toggle32Cert(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        PlateParams.Certificate = isChecked ? InspectionCertificateType.EN10204_32 : InspectionCertificateType.StandardMTC;
        RecalculatePlate();
    }

    private async Task ArchiveCurrentPlateToProvenance()
    {
        var pCopy = new PlatePricingParameters
        {
            Standard = PlateParams.Standard,
            Grade = PlateParams.Grade,
            ThicknessMm = PlateParams.ThicknessMm,
            WidthMm = PlateParams.WidthMm,
            LengthMm = PlateParams.LengthMm,
            CutType = PlateParams.CutType,
            Tolerance = PlateParams.Tolerance,
            Flatness = PlateParams.Flatness,
            Impact = PlateParams.Impact,
            ZDirection = PlateParams.ZDirection,
            Metallurgy = PlateParams.Metallurgy,
            UT = PlateParams.UT,
            Certificate = PlateParams.Certificate,
            SteelMillId = PlateParams.SteelMillId,
            Delivery = PlateParams.Delivery,
            DestinationRegion = PlateParams.DestinationRegion,
            CustomThicknessSurcharge = PlateParams.CustomThicknessSurcharge,
            CustomDimensionSurcharge = PlateParams.CustomDimensionSurcharge,
            CustomMillPremium = PlateParams.CustomMillPremium,
            CustomFreightPerTon = PlateParams.CustomFreightPerTon
        };

        string batchId = string.IsNullOrWhiteSpace(ProvenanceArchiveBatchInput) ? $"INQ-{DateTime.Today:yyyyMMdd}-LOT01" : ProvenanceArchiveBatchInput;
        string vendor = string.IsNullOrWhiteSpace(ProvenanceArchiveVendorInput) ? "主流钢厂直供通道" : ProvenanceArchiveVendorInput;
        string principle = string.IsNullOrWhiteSpace(ProvenanceArchivePrincipleInput) ? "行业出厂常规阶梯与定尺规则" : ProvenanceArchivePrincipleInput;

        var newRecord = new MaterialProvenanceRecord
        {
            MaterialTag = MaterialProvenanceTagBuilder.GeneratePlateTag(pCopy),
            DisplayTitle = $"{PlateParams.Grade} 钢板 t={PlateParams.ThicknessMm:0.##}mm ({CurrentPlatePrice.MillName})",
            Category = "Plate",
            StandardSpecification = CurrentPlatePrice.StandardSpecification,
            DimensionText = CurrentPlatePrice.DimensionText,
            SnapshotId = CurrentSnapshot.SnapshotId,
            SnapshotName = CurrentSnapshot.SnapshotName,
            EffectiveDate = CurrentSnapshot.EffectiveDate,
            RecordedAt = DateTime.Now,
            ProjectReference = string.IsNullOrWhiteSpace(ProvenanceArchiveProjectInput) ? "默认钢结构工程项目" : ProvenanceArchiveProjectInput,
            InquiryBatchId = batchId,
            InquiryDate = ProvenanceArchiveDateInput,
            InquiryVendor = vendor,
            RevisionNumber = 1,
            PricingPrincipleNote = principle,
            MillName = CurrentPlatePrice.MillName,
            DeliveryAndFreightText = CurrentPlatePrice.DeliveryAndFreightText,
            BasePricePerTon = CurrentPlatePrice.BasePricePerTon,
            MillPremiumPerTon = CurrentPlatePrice.MillPremiumPerTon,
            ThicknessSurchargePerTon = CurrentPlatePrice.ThicknessSurchargePerTon,
            ContractThicknessSurchargePerTon = CurrentPlatePrice.ThicknessSurchargePerTon,
            DimensionSurchargePerTon = CurrentPlatePrice.DimensionSurchargePerTon,
            ToleranceSurchargePerTon = CurrentPlatePrice.ToleranceSurchargePerTon,
            PerformanceSurchargePerTon = CurrentPlatePrice.PerformanceSurchargePerTon,
            InspectionSurchargePerTon = CurrentPlatePrice.InspectionSurchargePerTon,
            FreightPerTon = CurrentPlatePrice.FreightPerTon,
            ContractFreightPerTon = CurrentPlatePrice.FreightPerTon,
            InitialRecordedPricePerTon = CurrentPlatePrice.FinalPricePerTon,
            FinalPricePerTon = CurrentPlatePrice.FinalPricePerTon,
            FullDescription = CurrentPlatePrice.FullDescription,
            PlateParameters = pCopy,
            RevisionLogs =
            [
                new MaterialPriceRevisionLog
                {
                    Id = 1,
                    RevisionNumber = 1,
                    RevisedAt = DateTime.Now,
                    RevisedBy = "造价工程师",
                    Reason = "首发询价建档入库",
                    PreviousPricePerTon = 0,
                    NewPricePerTon = CurrentPlatePrice.FinalPricePerTon,
                    ChangeDetails = $"初始入库，基准单价: ¥{CurrentPlatePrice.FinalPricePerTon:0.##}/t，询价批次: {batchId}",
                    AppliedPrinciple = principle
                }
            ]
        };

        await OnArchiveRecord.InvokeAsync(newRecord);

        ProvenanceSaveFeedbackMessage = $"✓ 钢板物料已登记入库 (批次: {batchId})！标签: {newRecord.MaterialTag}";
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            ProvenanceSaveFeedbackMessage = "";
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task CopyTagToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentPlateTag);
            ProvenanceSaveFeedbackMessage = "✓ 唯一物料特征标签已复制到剪贴板！";
        }
        catch
        {
            ProvenanceSaveFeedbackMessage = "请选中标签文本进行复制";
        }
        StateHasChanged();
    }

    private async Task CopyDescribeToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentPlatePrice.FullDescription);
            CopyAlertMessage = "✓ 已成功复制标准 Describe 规格到剪贴板！";
        }
        catch
        {
            CopyAlertMessage = "请选中上方文本直接复制 (Ctrl+C)";
        }
        StateHasChanged();
    }
}
